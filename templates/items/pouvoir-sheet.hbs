<form class="agone sheet item pouvoir" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" data-tooltip="{{item.name}}" />
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder='{{localize "AGONE.NomPouvoir"}}' /></h1>
    </div>
  </header>
  <section class="sheet-body">
    <div class="item-form-grid">
      <div class="form-group">
        <label>{{localize "AGONE.CategoriePouvoirs"}}</label>
        <select name="system.categorie">
          <option value="flamme" {{#if (eq system.categorie "flamme")}}selected{{/if}}>{{localize "AGONE.PouvoirFlamme"}}</option>
          <option value="saisonin" {{#if (eq system.categorie "saisonin")}}selected{{/if}}>{{localize "AGONE.Saisonin"}}</option>
        </select>
      </div>
    </div>
    <div class="form-group description-group">
      <label>{{localize "AGONE.Description"}}</label>
      {{> systems/agone/templates/items/parts/editeur.hbs champ="description"}}
    </div>
    <div class="send-to-chat">
      <button type="button" data-action="toChat"><i class="fas fa-comment"></i> {{localize "AGONE.EnvoyerChat"}}</button>
    </div>
    {{> systems/agone/templates/items/parts/effets.hbs}}
  </section>
</form>
