<form class="agone sheet item manoeuvre" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder='{{localize "AGONE.NomManoeuvre"}}' /></h1>
    </div>
  </header>
  <section class="sheet-body">
    <div class="item-form-grid manoeuvre-stats-grid">
      <div class="form-group">
        <label>{{localize "AGONE.ManIni"}}</label>
        <input type="number" name="system.ini" value="{{system.ini}}" class="stat-num" placeholder='{{localize "AGONE.Browser.Var"}}' />
      </div>
      <div class="form-group">
        <label>{{localize "AGONE.ManAtt"}}</label>
        <input type="number" name="system.att" value="{{system.att}}" class="stat-num" placeholder='{{localize "AGONE.Browser.Var"}}' />
      </div>
      <div class="form-group">
        <label>{{localize "AGONE.ManDef"}}</label>
        <input type="number" name="system.def" value="{{system.def}}" class="stat-num" placeholder='{{localize "AGONE.Browser.Var"}}' />
      </div>
      <div class="form-group">
        <label>{{localize "AGONE.ManDom"}}</label>
        <input type="text" name="system.dom" value="{{system.dom}}" class="stat-text" placeholder="0" />
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "AGONE.ManCondition"}}</label>
      <input type="text" name="system.condition" value="{{system.condition}}" placeholder="ex. Farfadet uniquement, Réaction…" />
    </div>
    <div class="form-group description-group">
      <label>{{localize "AGONE.Description"}}</label>
      <textarea name="system.description" class="description-textarea" rows="5">{{system.description}}</textarea>
    </div>
  </section>
</form>
