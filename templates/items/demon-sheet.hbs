<form class="agone sheet item demon" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" data-tooltip="{{item.name}}" />
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder='{{localize "AGONE.Nom"}}' /></h1>
    </div>
  </header>
  <section class="sheet-body">
    <div class="item-form-grid">
      <div class="form-group">
        <label>{{localize "AGONE.Origine"}}</label>
        <input type="text" name="system.origine" value="{{system.origine}}" />
      </div>
      <div class="form-group">
        <label>{{localize "AGONE.Opacite"}}</label>
        <input type="number" name="system.opacite" value="{{system.opacite}}" class="stat-num" min="0" />
      </div>
      <div class="form-group">
        <label>{{localize "AGONE.DIF"}}</label>
        <input type="number" name="system.dif" value="{{system.dif}}" class="stat-num" />
      </div>
      <div class="form-group">
        <label>{{localize "AGONE.Empathie"}}</label>
        <input type="number" name="system.empathie" value="{{system.empathie}}" class="stat-num" min="0" />
      </div>
      <div class="form-group">
        <label>{{localize "AGONE.Densite"}}</label>
        <span>
          <input type="number" name="system.densite.valeur" value="{{system.densite.valeur}}" class="stat-num" min="0" />
          / <input type="number" name="system.densite.max" value="{{system.densite.max}}" class="stat-num" min="0" />
        </span>
      </div>
      <div class="form-group">
        <label>{{localize "AGONE.Endurance"}}</label>
        <span>
          <input type="number" name="system.endurance.valeur" value="{{system.endurance.valeur}}" class="stat-num" min="0" />
          / <input type="number" name="system.endurance.max" value="{{system.endurance.max}}" class="stat-num" min="0" />
        </span>
      </div>
      <div class="form-group">
        <label>{{localize "AGONE.Memoire"}}</label>
        <span>
          <input type="number" name="system.memoire.valeur" value="{{system.memoire.valeur}}" class="stat-num" min="0" />
          / <input type="number" name="system.memoire.max" value="{{system.memoire.max}}" class="stat-num" min="0" />
        </span>
      </div>
      <div class="form-group">
        <label>{{localize "AGONE.AptitudeConjuration"}}</label>
        <input type="number" name="system.aptitudeConjuration" value="{{system.aptitudeConjuration}}" class="stat-num" />
      </div>
    </div>
    <div class="form-group description-group">
      <label>{{localize "AGONE.Description"}}</label>
      {{> systems/agone/templates/items/parts/editeur.hbs champ="description"}}
    </div>
    <div class="form-group description-group">
      <label>{{localize "AGONE.Connivances"}}</label>
      {{> systems/agone/templates/items/parts/editeur.hbs champ="connivances"}}
    </div>
    <div class="form-group description-group">
      <label>{{localize "AGONE.Notes"}}</label>
      {{> systems/agone/templates/items/parts/editeur.hbs champ="notes"}}
    </div>
  </section>
</form>
