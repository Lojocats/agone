{{!-- Éditeur des effets actifs d'un item : bonus / malus transférés à l'acteur qui le possède.
      Contexte : effets (AgoneItemSheet#_prepareEffets), editable. --}}
<div class="agone-effets">
  <div class="section-header">
    <h3>{{localize "AGONE.Effets.Titre"}}</h3>
    {{#if editable}}
    <button type="button" class="btn-icon" data-action="effetCreer" title='{{localize "AGONE.Effets.Nouveau"}}'>
      <i class="fas fa-plus"></i>
    </button>
    {{/if}}
  </div>

  {{#each effets as |fx|}}
  <div class="effet-bloc{{#if fx.disabled}} effet-inactif{{/if}}" data-effect-id="{{fx.id}}">
    <div class="effet-entete">
      <img class="effet-icone" src="{{fx.img}}" alt="" />
      <input type="text" class="effet-nom" data-effet-champ="name" value="{{fx.name}}" {{#unless @root.editable}}disabled{{/unless}} />
      <label class="effet-actif">
        <input type="checkbox" data-effet-champ="actif" {{#unless fx.disabled}}checked{{/unless}} {{#unless @root.editable}}disabled{{/unless}} />
        {{localize "AGONE.Effets.Actif"}}
      </label>
      {{#if @root.editable}}
      <a class="btn-icon" data-action="effetEditer" title='{{localize "AGONE.Effets.EditeurAvance"}}'><i class="fas fa-cog"></i></a>
      <a class="btn-icon" data-action="effetSupprimer" title='{{localize "AGONE.Effets.SupprimerEffet"}}'><i class="fas fa-trash"></i></a>
      {{/if}}
    </div>

    {{#each fx.changes as |ch|}}
    <div class="effet-modif" data-change-index="{{ch.index}}">
      {{#if ch.connu}}
      <select data-effet-champ="stat" {{#unless @root.editable}}disabled{{/unless}}>
        {{#each ch.options as |opt|}}
        <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
        {{/each}}
      </select>
      {{#if ch.booleen}}
      <span class="effet-valeur-fixe">{{localize "AGONE.Effets.Oui"}}</span>
      {{else}}
      <input type="number" class="stat-num" data-effet-champ="value" value="{{ch.value}}"
             title='{{localize "AGONE.Effets.Valeur"}}' {{#unless @root.editable}}disabled{{/unless}} />
      {{/if}}
      {{else}}
      {{!-- Clé saisie dans l'éditeur Foundry (hors vocabulaire Agone) : affichée telle quelle --}}
      <code class="effet-cle" title='{{localize "AGONE.Effets.CleLibre"}}'>{{ch.key}}</code>
      <span class="effet-valeur-fixe">{{ch.value}}</span>
      {{/if}}
      {{#if @root.editable}}
      <a class="btn-icon" data-action="modifSupprimer" title='{{localize "AGONE.Effets.SupprimerModif"}}'><i class="fas fa-times"></i></a>
      {{/if}}
    </div>
    {{/each}}

    {{#if @root.editable}}
    <button type="button" class="effet-ajout" data-action="modifAjouter">
      <i class="fas fa-plus"></i> {{localize "AGONE.Effets.AjouterModif"}}
    </button>
    {{/if}}
  </div>
  {{else}}
  <p class="empty-list">{{localize "AGONE.Effets.Aucun"}}</p>
  {{/each}}
</div>
