<form class="agone sheet item sort" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Nom du sort / de l'œuvre" /></h1>
    </div>
  </header>
  <section class="sheet-body">
    <div class="item-form-grid">
      <div class="form-group">
        <label>{{localize "AGONE.TypeMagie"}}</label>
        <select name="system.typeMagie">
          <option value="" {{#if (eq system.typeMagie "")}}selected{{/if}}>—</option>
          <option value="jorniste" {{#if (eq system.typeMagie "jorniste")}}selected{{/if}}>{{localize "AGONE.Jorniste"}}</option>
          <option value="obscurantiste" {{#if (eq system.typeMagie "obscurantiste")}}selected{{/if}}>{{localize "AGONE.Obscurantiste"}}</option>
          <option value="eclipsiste" {{#if (eq system.typeMagie "eclipsiste")}}selected{{/if}}>{{localize "AGONE.Eclipsiste"}}</option>
          <option value="accord" {{#if (eq system.typeMagie "accord")}}selected{{/if}}>{{localize "AGONE.Accord"}}</option>
          <option value="cyse" {{#if (eq system.typeMagie "cyse")}}selected{{/if}}>{{localize "AGONE.Cyse"}}</option>
          <option value="decorum" {{#if (eq system.typeMagie "decorum")}}selected{{/if}}>{{localize "AGONE.Decorum"}}</option>
          <option value="geste" {{#if (eq system.typeMagie "geste")}}selected{{/if}}>{{localize "AGONE.Geste"}}</option>
        </select>
      </div>

      {{#if (or (eq system.typeMagie "accord") (eq system.typeMagie "decorum"))}}
      <div class="form-group">
        {{#if (eq system.typeMagie "accord")}}
          <label>{{localize "AGONE.Instrument"}}</label>
          <select name="system.instrument">
            <option value="" {{#if (eq system.instrument "")}}selected{{/if}}>—</option>
            <option value="harpe" {{#if (eq system.instrument "harpe")}}selected{{/if}}>{{localize "AGONE.Harpe"}}</option>
            <option value="flute" {{#if (eq system.instrument "flute")}}selected{{/if}}>{{localize "AGONE.Flute"}}</option>
            <option value="viole" {{#if (eq system.instrument "viole")}}selected{{/if}}>{{localize "AGONE.Viole"}}</option>
            <option value="tambour" {{#if (eq system.instrument "tambour")}}selected{{/if}}>{{localize "AGONE.Tambour"}}</option>
            <option value="cistre" {{#if (eq system.instrument "cistre")}}selected{{/if}}>{{localize "AGONE.Cistre"}}</option>
          </select>
        {{else}}
          <label>{{localize "AGONE.Saison"}}</label>
          <select name="system.instrument">
            <option value="" {{#if (eq system.instrument "")}}selected{{/if}}>—</option>
            <option value="printemps" {{#if (eq system.instrument "printemps")}}selected{{/if}}>{{localize "AGONE.Printemps"}}</option>
            <option value="ete" {{#if (eq system.instrument "ete")}}selected{{/if}}>{{localize "AGONE.Ete"}}</option>
            <option value="automne" {{#if (eq system.instrument "automne")}}selected{{/if}}>{{localize "AGONE.Automne"}}</option>
            <option value="hiver" {{#if (eq system.instrument "hiver")}}selected{{/if}}>{{localize "AGONE.Hiver"}}</option>
          </select>
        {{/if}}
      </div>
      {{/if}}

      <div class="form-group">
        <label>{{localize "AGONE.Seuil"}}</label>
        <input type="number" name="system.seuil" value="{{system.seuil}}" class="stat-num" />
      </div>
      <div class="form-group">
        <label>{{localize "AGONE.Portee"}}</label>
        <input type="text" name="system.portee" value="{{system.portee}}" />
      </div>
      <div class="form-group">
        <label>{{localize "AGONE.Duree"}}</label>
        <input type="text" name="system.duree" value="{{system.duree}}" />
      </div>
      <div class="form-group">
        {{#if (eq system.typeMagie "accord")}}
          <label>{{localize "AGONE.Mesure"}}</label>
        {{else if (eq system.typeMagie "cyse")}}
          <label>{{localize "AGONE.Modelage"}}</label>
        {{else if (eq system.typeMagie "decorum")}}
          <label>{{localize "AGONE.Dessin"}}</label>
        {{else if (eq system.typeMagie "geste")}}
          <label>{{localize "AGONE.Verbe"}}</label>
        {{else}}
          <label>{{localize "AGONE.Danse"}}</label>
        {{/if}}
        <input type="text" name="system.danse" value="{{system.danse}}" />
      </div>
      <div class="form-group">
        <label>{{localize "AGONE.Special"}}</label>
        <input type="text" name="system.special" value="{{system.special}}" />
      </div>
      <div class="form-group">
        <label>{{localize "AGONE.CompAlt"}}</label>
        <input type="text" name="system.compAlt" value="{{system.compAlt}}" placeholder="ex: Danse" />
      </div>
      {{#if system.compAlt}}
      <div class="form-group">
        <label>{{localize "AGONE.AttrAlt"}}</label>
        <select name="system.attrAlt">
          <option value="agilite" {{#if (eq system.attrAlt "agilite")}}selected{{/if}}>{{localize "AGONE.Attribut.Agilite"}}</option>
          <option value="force" {{#if (eq system.attrAlt "force")}}selected{{/if}}>{{localize "AGONE.Attribut.Force"}}</option>
          <option value="perception" {{#if (eq system.attrAlt "perception")}}selected{{/if}}>{{localize "AGONE.Attribut.Perception"}}</option>
          <option value="resistance" {{#if (eq system.attrAlt "resistance")}}selected{{/if}}>{{localize "AGONE.Attribut.Resistance"}}</option>
          <option value="intelligence" {{#if (eq system.attrAlt "intelligence")}}selected{{/if}}>{{localize "AGONE.Attribut.Intelligence"}}</option>
          <option value="volonte" {{#if (eq system.attrAlt "volonte")}}selected{{/if}}>{{localize "AGONE.Attribut.Volonte"}}</option>
          <option value="charisma" {{#if (eq system.attrAlt "charisma")}}selected{{/if}}>{{localize "AGONE.Attribut.Charisma"}}</option>
          <option value="creativite" {{#if (eq system.attrAlt "creativite")}}selected{{/if}}>{{localize "AGONE.Attribut.Creativite"}}</option>
        </select>
      </div>
      {{/if}}
    </div>
    <div class="form-group description-group">
      <label>{{localize "AGONE.Description"}}</label>
      {{editor descriptionHTML target="system.description" button=true editable=owner}}
    </div>
    <div class="send-to-chat">
      <button type="button" data-action="toChat"><i class="fas fa-comment"></i> {{localize "AGONE.EnvoyerChat"}}</button>
    </div>
  </section>
</form>
