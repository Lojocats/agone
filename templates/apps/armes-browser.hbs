<div class="armes-browser-app">

  <!-- Barre de filtres -->
  <div class="ab-filters">
    <div class="ab-filter-row">
      <div class="ab-search-wrap">
        <i class="fas fa-search"></i>
        <input type="text" class="ab-search" placeholder="Rechercher une arme..." value="{{search}}">
      </div>
      <button type="button" class="ab-clear" title="Effacer les filtres">
        <i class="fas fa-eraser"></i>
      </button>
    </div>

    <!-- Styles -->
    <div class="ab-type-checks">
      <span class="ab-filter-label">Style :</span>
      <label class="ab-type-lbl">
        <input type="checkbox" class="ab-all-style" {{#if allStylesSelected}}checked{{/if}}> Tous
      </label>
      {{#each allStyles}}
      <label class="ab-type-lbl">
        <input type="checkbox" class="ab-style-check" value="{{this.value}}" {{#if this.active}}checked{{/if}}> {{this.label}}
      </label>
      {{/each}}
    </div>

    <!-- Types de dommages -->
    <div class="ab-type-checks">
      <span class="ab-filter-label">Type :</span>
      <label class="ab-type-lbl">
        <input type="checkbox" class="ab-all-type" {{#if allTypesSelected}}checked{{/if}}> Tous
      </label>
      {{#each allTypes}}
      <label class="ab-type-lbl">
        <input type="checkbox" class="ab-type-check" value="{{this.value}}" {{#if this.active}}checked{{/if}}> {{this.value}}
      </label>
      {{/each}}
    </div>

    <!-- Filtres secondaires -->
    <div class="ab-filter-row2">
      <label>FOR ≤</label>
      <input type="number" class="ab-req-for" value="{{filterReqFor}}" placeholder="—" min="1" max="20">
      <select class="ab-possede-filter">
        <option value="all" {{#if (eq filterPossede "all")}}selected{{/if}}>Toutes les armes</option>
        <option value="oui" {{#if (eq filterPossede "oui")}}selected{{/if}}>Déjà possédées</option>
        <option value="non" {{#if (eq filterPossede "non")}}selected{{/if}}>Non possédées</option>
      </select>
      <span class="ab-count">{{armes.length}} arme(s)</span>
    </div>
  </div>

  <!-- Tableau -->
  <div class="ab-list-wrapper">
    <table class="ab-table">
      <thead>
        <tr>
          <th class="ab-col-name">Nom</th>
          <th class="ab-col-style">Style</th>
          <th class="ab-col-tai">TAI</th>
          <th class="ab-col-type">Type</th>
          <th class="ab-col-init" title="Bonus d'initiative">Init</th>
          <th class="ab-col-atk" title="Bonus d'attaque">ATK</th>
          <th class="ab-col-def" title="Bonus de défense">DEF</th>
          <th class="ab-col-dom">Dom</th>
          <th class="ab-col-portee">Portée</th>
          <th class="ab-col-req">FOR/AGI req.</th>
          <th class="ab-col-action"></th>
        </tr>
      </thead>
      <tbody>
        {{#each armes as |arme|}}
        <tr class="ab-row {{#if arme.hasInActor}}ab-has-item{{/if}}" data-arme-idx="{{arme.idx}}">
          <td class="ab-name">
            {{arme.name}}
            {{#if arme.description}}<span class="ab-desc-tip" title="{{arme.description}}"><i class="fas fa-info-circle"></i></span>{{/if}}
          </td>
          <td class="ab-style">{{arme.styleLabel}}</td>
          <td class="ab-tai">{{arme.tai}}</td>
          <td class="ab-type">{{arme.type}}</td>
          <td class="ab-init">{{#if (gt arme.initBonus 0)}}+{{/if}}{{arme.initBonus}}</td>
          <td class="ab-atk">{{#if (gt arme.attackBonus 0)}}+{{/if}}{{arme.attackBonus}}</td>
          <td class="ab-def">{{#if (gt arme.defenseBonus 0)}}+{{/if}}{{arme.defenseBonus}}</td>
          <td class="ab-dom">{{arme.dommages}}</td>
          <td class="ab-portee">{{arme.portee}}</td>
          <td class="ab-req">{{arme.reqFor}} / {{arme.reqAgi}}</td>
          <td class="ab-action">
            {{#if arme.hasInActor}}
            <i class="fas fa-check ab-check" title="Déjà possédée"></i>
            {{else}}
            <button type="button" class="ab-add-btn btn-icon" data-action="addArme" title="Ajouter au personnage">
              <i class="fas fa-plus"></i>
            </button>
            {{/if}}
          </td>
        </tr>
        {{/each}}
        {{#unless armes.length}}
        <tr><td colspan="11" class="ab-empty">Aucune arme trouvée.</td></tr>
        {{/unless}}
      </tbody>
    </table>
  </div>

</div>
