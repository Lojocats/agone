<div class="armes-browser-app">

  <!-- Barre de filtres -->
  <div class="agone-filtres ab-filters">
    {{> systems/agone/templates/apps/parts/browser-filtres-tete.hbs p="ab" search=search compte=armes.length libelle="AGONE.Browser.ArmesCount"}}

    <div class="agone-filtres-corps">
      <!-- Styles -->
      <div class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.Filtres.Style"}}</span>
        <div class="agone-chips">
          <label class="agone-chip"><input type="checkbox" class="ab-all-style" {{#if allStylesSelected}}checked{{/if}}><span>{{localize "AGONE.Browser.Tous"}}</span></label>
          {{#each allStyles}}
          <label class="agone-chip"><input type="checkbox" class="ab-style-check" value="{{this.value}}" {{#if this.active}}checked{{/if}}><span>{{this.label}}</span></label>
          {{/each}}
        </div>
      </div>

      <!-- Types de dommages (code affiché, libellé en infobulle) -->
      <div class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.Filtres.TypeDommages"}}</span>
        <div class="agone-chips">
          <label class="agone-chip"><input type="checkbox" class="ab-all-type" {{#if allTypesSelected}}checked{{/if}}><span>{{localize "AGONE.Browser.Tous"}}</span></label>
          {{#each allTypes}}
          <label class="agone-chip" title="{{this.label}}"><input type="checkbox" class="ab-type-check" value="{{this.value}}" {{#if this.active}}checked{{/if}}><span>{{this.value}}</span></label>
          {{/each}}
        </div>
      </div>

      <!-- Seuils numériques -->
      <label class="agone-filtre-groupe agone-filtre-nombre">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.Filtres.DomMin"}}</span>
        <input type="number" class="ab-dom-min" value="{{filterDomMin}}" placeholder="—" min="0" max="30">
      </label>
      <label class="agone-filtre-groupe agone-filtre-nombre">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.ForReq"}}</span>
        <input type="number" class="ab-req-for" value="{{filterReqFor}}" placeholder="—" min="1" max="20">
      </label>
      <label class="agone-filtre-groupe agone-filtre-nombre">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.Filtres.AgiMax"}}</span>
        <input type="number" class="ab-req-agi" value="{{filterReqAgi}}" placeholder="—" min="1" max="20">
      </label>

      <!-- Portée -->
      <label class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Portee"}}</span>
        <select class="ab-portee-filter">
          <option value="all"      {{#if (eq filterPortee "all")}}selected{{/if}}>{{localize "AGONE.Browser.Filtres.PorteeToutes"}}</option>
          <option value="distance" {{#if (eq filterPortee "distance")}}selected{{/if}}>{{localize "AGONE.Browser.Filtres.ADistance"}}</option>
          <option value="contact"  {{#if (eq filterPortee "contact")}}selected{{/if}}>{{localize "AGONE.Browser.Filtres.SansPortee"}}</option>
        </select>
      </label>

      <!-- Possession -->
      <label class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.Filtres.Possession"}}</span>
        <select class="ab-possede-filter">
          <option value="all" {{#if (eq filterPossede "all")}}selected{{/if}}>{{localize "AGONE.Browser.ToutesLesArmes"}}</option>
          <option value="oui" {{#if (eq filterPossede "oui")}}selected{{/if}}>{{localize "AGONE.Browser.DejaPosse"}}</option>
          <option value="non" {{#if (eq filterPossede "non")}}selected{{/if}}>{{localize "AGONE.Browser.NonPosse"}}</option>
        </select>
      </label>
    </div>
  </div>

  <!-- Tableau -->
  <div class="ab-list-wrapper">
    <table class="ab-table">
      <thead>
        <tr>
          <th class="ab-col-name">{{localize "AGONE.Nom"}}</th>
          <th class="ab-col-style">{{localize "AGONE.StyleArme"}}</th>
          <th class="ab-col-tai">{{localize "AGONE.Combat.Tai"}}</th>
          <th class="ab-col-type">{{localize "AGONE.TypeArme"}}</th>
          <th class="ab-col-init" title='{{localize "AGONE.InitBonus"}}'>{{localize "AGONE.Combat.Init"}}</th>
          <th class="ab-col-atk" title='{{localize "AGONE.AttackBonus"}}'>{{localize "AGONE.Combat.Atk"}}</th>
          <th class="ab-col-def" title='{{localize "AGONE.DefenseBonus"}}'>{{localize "AGONE.Combat.Def"}}</th>
          <th class="ab-col-dom">{{localize "AGONE.Combat.Dom"}}</th>
          <th class="ab-col-portee">{{localize "AGONE.Portee"}}</th>
          <th class="ab-col-req">{{localize "AGONE.Browser.ForAgiReq"}}</th>
          <th class="ab-col-action"></th>
        </tr>
      </thead>
      <tbody>
        {{#each armes as |arme|}}
        <tr class="ab-row {{#if arme.hasInActor}}ab-has-item{{/if}}" data-arme-idx="{{arme.idx}}">
          <td class="ab-name">
            {{arme.name}}
            {{#if arme.description}}<span class="ab-desc-tip" title="{{arme.description}}"><i class="fas fa-info-circle"></i></span>{{/if}}
          </td>
          <td class="ab-style">{{arme.styleLabel}}</td>
          <td class="ab-tai">{{arme.tai}}</td>
          <td class="ab-type" title="{{arme.typeLabel}}">{{arme.type}}</td>
          <td class="ab-init">{{#if (gt arme.initBonus 0)}}+{{/if}}{{arme.initBonus}}</td>
          <td class="ab-atk">{{#if (gt arme.attackBonus 0)}}+{{/if}}{{arme.attackBonus}}</td>
          <td class="ab-def">{{#if (gt arme.defenseBonus 0)}}+{{/if}}{{arme.defenseBonus}}</td>
          <td class="ab-dom">{{arme.dommages}}</td>
          <td class="ab-portee">{{arme.portee}}</td>
          <td class="ab-req">{{arme.reqFor}} / {{arme.reqAgi}}</td>
          <td class="ab-action">
            {{#if arme.hasInActor}}
            <i class="fas fa-check ab-check" title='{{localize "AGONE.Browser.DejaPosse"}}'></i>
            {{else}}
            <button type="button" class="ab-add-btn btn-icon" data-action="addArme" title='{{localize "AGONE.Browser.AjouterPersonnage"}}'>
              <i class="fas fa-plus"></i>
            </button>
            {{/if}}
          </td>
        </tr>
        {{/each}}
        {{#unless armes.length}}
        <tr><td colspan="11" class="ab-empty">{{localize "AGONE.Browser.AucuneArmeTrouvee"}}</td></tr>
        {{/unless}}
      </tbody>
    </table>
  </div>


  {{> systems/agone/templates/apps/parts/browser-personnalises.hbs}}

</div>
