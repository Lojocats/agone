<div class="peuples-browser-app">

  <!-- Barre de filtres -->
  <div class="agone-filtres pb-filters">
    {{> systems/agone/templates/apps/parts/browser-filtres-tete.hbs p="pb" search=search compte=items.length libelle="AGONE.Browser.ResultatsCount"}}

    <div class="agone-filtres-corps">
      <label class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Saison"}}</span>
        <select class="pb-saison-filter">
          <option value="all" {{#if (eq filterSaison "all")}}selected{{/if}}>{{localize "AGONE.Browser.Filtres.ToutesSaisons"}}</option>
          {{#each saisons as |s|}}
          <option value="{{s.value}}" {{#if (eq ../filterSaison s.value)}}selected{{/if}}>{{s.label}}</option>
          {{/each}}
        </select>
      </label>

      <label class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.Filtres.Vol"}}</span>
        <select class="pb-vol-filter">
          <option value="all" {{#if (eq filterVol "all")}}selected{{/if}}>{{localize "AGONE.Browser.Tous"}}</option>
          <option value="oui" {{#if (eq filterVol "oui")}}selected{{/if}}>{{localize "AGONE.Browser.Filtres.Volants"}}</option>
          <option value="non" {{#if (eq filterVol "non")}}selected{{/if}}>{{localize "AGONE.Browser.Filtres.NonVolants"}}</option>
        </select>
      </label>

      <label class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.Filtres.Possession"}}</span>
        <select class="pb-possede-filter">
          <option value="all" {{#if (eq filterPossede "all")}}selected{{/if}}>{{localize "AGONE.Browser.TousLesPeuples"}}</option>
          <option value="oui" {{#if (eq filterPossede "oui")}}selected{{/if}}>{{localize "AGONE.Browser.PeupleActif"}}</option>
          <option value="non" {{#if (eq filterPossede "non")}}selected{{/if}}>{{localize "AGONE.Browser.AutresPeuples"}}</option>
        </select>
      </label>
    </div>
  </div>

  <!-- Tableau -->
  <div class="pb-list-wrapper">
    <table class="pb-table">
      <thead>
        <tr>
          <th class="pb-col-toggle"><button type="button" class="desc-bascule-tout" aria-expanded="false"><i class="fas fa-angles-down"></i></button></th>
          <th class="pb-col-name">{{localize "AGONE.PeupleLabel"}}</th>
          <th class="pb-col-tai" title='{{localize "AGONE.TAI"}}'>{{localize "AGONE.Combat.Tai"}}</th>
          <th class="pb-col-action"></th>
        </tr>
      </thead>
      <tbody>
        {{#each items as |item|}}
        <tr class="pb-row {{#if item.isActif}}pb-row-actif{{/if}}" data-peuple-idx="{{item.idx}}">
          <td class="desc-col">{{#if item.description}}<button type="button" class="desc-bascule" data-desc="{{item.idx}}" aria-expanded="false"><i class="fas fa-chevron-right"></i></button>{{/if}}</td>
          <td class="pb-name">
            {{item.name}}
            {{#if item.isActif}}<span class="pb-badge-actif">{{localize "AGONE.Actif"}}</span>{{/if}}
          </td>
          <td class="pb-tai">{{item.taiBase}}</td>
          <td class="pb-action">
            {{#if item.isActif}}
            <i class="fas fa-check pb-check" title='{{localize "AGONE.Browser.PeupleActif"}}'></i>
            {{else}}
            <button type="button" class="pb-apply-btn btn-icon" data-action="applyPeuple" title='{{localize "AGONE.Browser.AppliquerPeuple"}}'>
              <i class="fas fa-user-check"></i>
            </button>
            {{/if}}
          </td>
        </tr>
        {{#if item.description}}
        <tr class="pb-desc-row desc-pliable" data-peuple-idx="{{item.idx}}" data-desc-de="{{item.idx}}" hidden>
          <td></td>
          <td colspan="3" class="pb-description-cell">
            <div class="item-desc-content">{{{item.description}}}</div>
          </td>
        </tr>
        {{/if}}
        {{/each}}
        {{#unless items.length}}
        <tr><td colspan="4" class="pb-empty">{{localize "AGONE.Browser.AucunPeupleTrouve"}}</td></tr>
        {{/unless}}
      </tbody>
    </table>
  </div>


  {{> systems/agone/templates/apps/parts/browser-personnalises.hbs}}

</div>
