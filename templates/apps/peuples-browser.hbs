<div class="peuples-browser-app">

  <!-- Barre de filtres -->
  <div class="pb-filters">
    <div class="pb-filter-row">
      <div class="pb-search-wrap">
        <i class="fas fa-search"></i>
        <input type="text" class="pb-search" placeholder='{{localize "AGONE.Browser.Rechercher"}}' value="{{search}}">
      </div>
      <button type="button" class="pb-clear" title='{{localize "AGONE.Browser.EffacerFiltres"}}'>
        <i class="fas fa-eraser"></i>
      </button>
    </div>

    <div class="pb-filter-row2">
      <select class="pb-possede-filter">
        <option value="all" {{#if (eq filterPossede "all")}}selected{{/if}}>{{localize "AGONE.Browser.TousLesPeuples"}}</option>
        <option value="oui" {{#if (eq filterPossede "oui")}}selected{{/if}}>{{localize "AGONE.Browser.PeupleActif"}}</option>
        <option value="non" {{#if (eq filterPossede "non")}}selected{{/if}}>{{localize "AGONE.Browser.AutresPeuples"}}</option>
      </select>
      <span class="pb-count">{{items.length}} {{localize "AGONE.Browser.ResultatsCount"}}</span>
    </div>
  </div>

  <!-- Tableau -->
  <div class="pb-list-wrapper">
    <table class="pb-table">
      <thead>
        <tr>
          <th class="pb-col-toggle"></th>
          <th class="pb-col-name">{{localize "AGONE.PeupleLabel"}}</th>
          <th class="pb-col-tai" title='{{localize "AGONE.TAI"}}'>{{localize "AGONE.Combat.Tai"}}</th>
          <th class="pb-col-action"></th>
        </tr>
      </thead>
      <tbody>
        {{#each items as |item|}}
        <tr class="pb-row {{#if item.isActif}}pb-row-actif{{/if}}" data-peuple-idx="{{item.idx}}">
          <td></td>
          <td class="pb-name">
            {{item.name}}
            {{#if item.isActif}}<span class="pb-badge-actif">{{localize "AGONE.Actif"}}</span>{{/if}}
          </td>
          <td class="pb-tai">{{item.taiBase}}</td>
          <td class="pb-action">
            {{#if item.isActif}}
            <i class="fas fa-check pb-check" title='{{localize "AGONE.Browser.PeupleActif"}}'></i>
            {{else}}
            <button type="button" class="pb-apply-btn btn-icon" data-action="applyPeuple" title='{{localize "AGONE.Browser.AppliquerPeuple"}}'>
              <i class="fas fa-user-check"></i>
            </button>
            {{/if}}
          </td>
        </tr>
        {{#if item.description}}
        <tr class="pb-desc-row" data-peuple-idx="{{item.idx}}">
          <td></td>
          <td colspan="3" class="pb-description-cell">
            <details class="item-details">
              <summary>{{localize "AGONE.VoirDescription"}}</summary>
              <div class="item-desc-content">{{item.description}}</div>
            </details>
          </td>
        </tr>
        {{/if}}
        {{/each}}
        {{#unless items.length}}
        <tr><td colspan="4" class="pb-empty">{{localize "AGONE.Browser.AucunPeupleTrouve"}}</td></tr>
        {{/unless}}
      </tbody>
    </table>
  </div>

</div>
