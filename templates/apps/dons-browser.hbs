<div class="dons-browser-app">

  <!-- Barre de filtres -->
  <div class="db-filters">
    <div class="db-filter-row">
      <div class="db-search-wrap">
        <i class="fas fa-search"></i>
        <input type="text" class="db-search" placeholder='{{localize "AGONE.Browser.Rechercher"}}' value="{{search}}">
      </div>
      <button type="button" class="db-clear" title='{{localize "AGONE.Browser.EffacerFiltres"}}'>
        <i class="fas fa-eraser"></i>
      </button>
    </div>

    <div class="db-filter-row2">
      <select class="db-cat-filter">
        <option value="all"      {{#if (eq filterCat "all")}}selected{{/if}}>{{localize "AGONE.Browser.AvantagesDefauts"}}</option>
        <option value="avantage" {{#if (eq filterCat "avantage")}}selected{{/if}}>{{localize "AGONE.Browser.AvantagesUniquement"}}</option>
        <option value="defaut"   {{#if (eq filterCat "defaut")}}selected{{/if}}>{{localize "AGONE.Browser.DefautsUniquement"}}</option>
      </select>
      <select class="db-possede-filter">
        <option value="all" {{#if (eq filterPossede "all")}}selected{{/if}}>{{localize "AGONE.Browser.Tous"}}</option>
        <option value="oui" {{#if (eq filterPossede "oui")}}selected{{/if}}>{{localize "AGONE.Browser.DejaPosse"}}</option>
        <option value="non" {{#if (eq filterPossede "non")}}selected{{/if}}>{{localize "AGONE.Browser.NonPosse"}}</option>
      </select>
      <span class="db-count">{{dons.length}} {{localize "AGONE.Browser.ResultatsCount"}}</span>
    </div>
  </div>

  <!-- Liste -->
  <div class="db-list-wrapper">
    <table class="db-table">
      <thead>
        <tr>
          <th class="db-col-toggle"></th>
          <th class="db-col-name">{{localize "AGONE.Nom"}}</th>
          <th class="db-col-cat">{{localize "AGONE.Categorie"}}</th>
          <th class="db-col-cout">{{localize "AGONE.Cout"}}</th>
          <th class="db-col-action"></th>
        </tr>
      </thead>
      <tbody>
        {{#each dons as |don|}}
        <tr class="db-row db-row-{{don.categorie}} {{#if don.hasInActor}}db-has-item{{/if}}" data-don-idx="{{don.idx}}">
          <td>
            {{#if don.description}}
            <button type="button" class="db-desc-toggle btn-icon" data-action="toggleDonDesc" title='{{localize "AGONE.VoirDescription"}}'>
              <i class="fas {{#if don.expanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
            </button>
            {{/if}}
          </td>
          <td class="db-name">{{don.name}}</td>
          <td class="db-cat">
            {{#if (eq don.categorie "avantage")}}
            <span class="db-badge db-badge-avantage">{{localize "AGONE.Avantage"}}</span>
            {{else}}
            <span class="db-badge db-badge-defaut">{{localize "AGONE.Defaut"}}</span>
            {{/if}}
          </td>
          <td class="db-cout">
            {{#if (eq don.categorie "avantage")}}
            <span class="db-cout-pos">+{{don.coutAbs}} {{#if (gt don.coutAbs 1)}}{{localize "AGONE.Browser.Pts"}}{{else}}{{localize "AGONE.Browser.Pt"}}{{/if}}</span>
            {{else}}
            <span class="db-cout-neg">-{{don.coutAbs}} {{#if (gt don.coutAbs 1)}}{{localize "AGONE.Browser.Pts"}}{{else}}{{localize "AGONE.Browser.Pt"}}{{/if}}</span>
            {{/if}}
          </td>
          <td class="db-action">
            {{#if don.hasInActor}}
            <i class="fas fa-check db-check" title='{{localize "AGONE.Browser.DejaPosse"}}'></i>
            {{else}}
            <button type="button" class="db-add-btn btn-icon" data-action="addDon" title='{{localize "AGONE.Browser.AjouterPersonnage"}}'>
              <i class="fas fa-plus"></i>
            </button>
            {{/if}}
          </td>
        </tr>
        {{#if don.description}}
        <tr class="db-desc-row" data-don-idx="{{don.idx}}" {{#unless don.expanded}}style="display:none"{{/unless}}>
          <td></td>
          <td colspan="4" class="db-description-cell">{{don.description}}</td>
        </tr>
        {{/if}}
        {{/each}}
        {{#unless dons.length}}
        <tr><td colspan="5" class="db-empty">{{localize "AGONE.Browser.AucunResultatTrouve"}}</td></tr>
        {{/unless}}
      </tbody>
    </table>
  </div>

</div>
