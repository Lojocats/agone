<div class="sorts-browser-app">

  <!-- Barre de filtres -->
  <div class="sb-filters">
    <div class="sb-filter-row">
      <div class="sb-search-wrap">
        <i class="fas fa-search"></i>
        <input type="text" class="sb-search" placeholder='{{localize "AGONE.Browser.Rechercher"}}' value="{{search}}">
      </div>
      <button type="button" class="sb-clear" title='{{localize "AGONE.Browser.EffacerFiltres"}}'>
        <i class="fas fa-eraser"></i>
      </button>
    </div>
    <!-- Filtres de type (checkboxes compactes) -->
    <div class="sb-type-checks">
      <label class="sb-type-lbl">
        <input type="checkbox" class="sb-all-check" {{#if allTypesSelected}}checked{{/if}}> {{localize "AGONE.Browser.Tous"}}
      </label>
      {{#each allTypes}}
      <label class="sb-type-lbl">
        <input type="checkbox" class="sb-type-check" value="{{this.value}}" {{#if this.active}}checked{{/if}}> {{this.label}}
      </label>
      {{/each}}
    </div>
    <!-- Filtres secondaires -->
    <div class="sb-filter-row2">
      <select class="sb-seuil-exact" title="Filtrer par seuil exact">
        <option value="">{{localize "AGONE.Browser.TousSeuils"}}</option>
        {{#each allSeuils}}
        <option value="{{this}}" {{#if (eq ../filterSeuilExact this)}}selected{{/if}}>{{localize "AGONE.Browser.SeuilEgal"}} {{this}}</option>
        {{/each}}
      </select>
      <select class="sb-possede-filter">
        <option value="all" {{#if (eq filterPossede "all")}}selected{{/if}}>{{localize "AGONE.Browser.TousSorts"}}</option>
        <option value="oui" {{#if (eq filterPossede "oui")}}selected{{/if}}>{{localize "AGONE.Browser.DejaPosse"}}</option>
        <option value="non" {{#if (eq filterPossede "non")}}selected{{/if}}>{{localize "AGONE.Browser.NonPosse"}}</option>
      </select>
    </div>
    <div class="sb-count">{{sorts.length}} {{localize "AGONE.Browser.SortsCount"}}</div>
  </div>

  <!-- Liste -->
  <div class="sb-list-wrapper">
    <table class="sb-table">
      <thead>
        <tr>
          <th class="sb-col-toggle"></th>
          <th class="sb-col-name">{{localize "AGONE.Nom"}}</th>
          <th class="sb-col-type">{{localize "AGONE.Browser.TypeAccord"}}</th>
          <th class="sb-col-seuil">{{localize "AGONE.Seuil"}}</th>
          <th class="sb-col-portee">{{localize "AGONE.Portee"}}</th>
          <th class="sb-col-duree">{{localize "AGONE.Duree"}}</th>
          <th class="sb-col-danse">{{localize "AGONE.Danse"}}</th>
          <th class="sb-col-action"></th>
        </tr>
      </thead>
      <tbody>
        {{#each sorts as |sort|}}
        <tr class="sb-sort-row {{#if sort.hasInActor}}sb-has-sort{{/if}}" data-sort-idx="{{sort.idx}}">
          <td></td>
          <td class="sb-name">{{sort.name}}</td>
          <td class="sb-type">{{sort.typeMagie}}{{#if sort.instrument}} / {{sort.instrument}}{{/if}}</td>
          <td class="sb-seuil">{{sort.seuil}}</td>
          <td class="sb-portee">{{sort.portee}}</td>
          <td class="sb-duree">{{sort.duree}}</td>
          <td class="sb-danse">{{sort.danse}}</td>
          <td class="sb-action">
            {{#if sort.hasInActor}}
            <i class="fas fa-check sb-check" title='{{localize "AGONE.Browser.DejaPosse"}}'></i>
            {{/if}}
            <button type="button" class="sb-impro-btn btn-icon" data-action="rollSortImpro" title='{{localize "AGONE.Browser.JetImprovise"}} ({{multiply sort.seuil 2}})'>
              <i class="fas fa-random"></i>
            </button>
            <button type="button" class="sb-add-btn btn-icon" data-action="addSort" title='{{localize "AGONE.Browser.AjouterPersonnage"}}'>
              <i class="fas fa-plus"></i>
            </button>
          </td>
        </tr>
        {{#if sort.description}}
        <tr class="sort-desc-row" data-sort-idx="{{sort.idx}}">
          <td></td>
          <td colspan="7" class="sort-description-cell">
            <details class="item-details">
              <summary>{{localize "AGONE.VoirDescription"}}</summary>
              <div class="item-desc-content">{{sort.description}}</div>
            </details>
          </td>
        </tr>
        {{/if}}
        {{/each}}
        {{#unless sorts.length}}
        <tr><td colspan="8" class="sb-empty">{{localize "AGONE.Browser.AucunSortTrouve"}}</td></tr>
        {{/unless}}
      </tbody>
    </table>
  </div>

</div>
