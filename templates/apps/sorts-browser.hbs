<div class="sorts-browser-app">

  <!-- Barre de filtres -->
  <div class="agone-filtres sb-filters">
    {{> systems/agone/templates/apps/parts/browser-filtres-tete.hbs p="sb" search=search compte=sorts.length libelle="AGONE.Browser.SortsCount"}}

    <div class="agone-filtres-corps">
      <!-- Types de magie -->
      <div class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Type"}}</span>
        <div class="agone-chips">
          <label class="agone-chip"><input type="checkbox" class="sb-all-check" {{#if allTypesSelected}}checked{{/if}}><span>{{localize "AGONE.Browser.Tous"}}</span></label>
          {{#each allTypes}}
          <label class="agone-chip"><input type="checkbox" class="sb-type-check" value="{{this.value}}" {{#if this.active}}checked{{/if}}><span>{{this.label}}</span></label>
          {{/each}}
        </div>
      </div>

      <!-- Famille (Emprise / Arts magiques) -->
      <label class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Famille"}}</span>
        <select class="sb-famille-filter">
          <option value="all"     {{#if (eq filterFamille "all")}}selected{{/if}}>{{localize "AGONE.Browser.Filtres.ToutesFamilles"}}</option>
          <option value="emprise" {{#if (eq filterFamille "emprise")}}selected{{/if}}>{{localize "AGONE.Emprise"}}</option>
          <option value="arts"    {{#if (eq filterFamille "arts")}}selected{{/if}}>{{localize "AGONE.ArtsMagiques"}}</option>
        </select>
      </label>

      <!-- Instrument / saison (selon les types filtrés) -->
      {{#if allInstruments.length}}
      <label class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.Filtres.InstrumentSaison"}}</span>
        <select class="sb-instrument-filter">
          <option value="all" {{#if (eq filterInstrument "all")}}selected{{/if}}>{{localize "AGONE.Browser.Tous"}}</option>
          {{#each allInstruments as |i|}}
          <option value="{{i.value}}" {{#if (eq ../filterInstrument i.value)}}selected{{/if}}>{{i.label}}</option>
          {{/each}}
        </select>
      </label>
      {{/if}}

      <!-- Seuil exact ou maximal (exclusifs) -->
      <label class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Seuil"}}</span>
        <select class="sb-seuil-exact" title='{{localize "AGONE.Ui.FiltrerSeuilExact"}}'>
          <option value="">{{localize "AGONE.Browser.TousSeuils"}}</option>
          {{#each allSeuils}}
          <option value="{{this}}" {{#if (eq ../filterSeuilExact this)}}selected{{/if}}>{{localize "AGONE.Browser.SeuilEgal"}} {{this}}</option>
          {{/each}}
        </select>
      </label>
      <label class="agone-filtre-groupe agone-filtre-nombre">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.Filtres.SeuilMax"}}</span>
        <input type="number" class="sb-seuil-max" value="{{filterSeuilMax}}" placeholder="—" min="0" max="40">
      </label>

      <label class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.Filtres.Possession"}}</span>
        <select class="sb-possede-filter">
          <option value="all" {{#if (eq filterPossede "all")}}selected{{/if}}>{{localize "AGONE.Browser.TousSorts"}}</option>
          <option value="oui" {{#if (eq filterPossede "oui")}}selected{{/if}}>{{localize "AGONE.Browser.DejaPosse"}}</option>
          <option value="non" {{#if (eq filterPossede "non")}}selected{{/if}}>{{localize "AGONE.Browser.NonPosse"}}</option>
        </select>
      </label>
    </div>
  </div>

  <!-- Liste -->
  <div class="sb-list-wrapper">
    <table class="sb-table">
      <thead>
        <tr>
          <th class="sb-col-toggle"></th>
          <th class="sb-col-name">{{localize "AGONE.Nom"}}</th>
          <th class="sb-col-type">{{localize "AGONE.Browser.TypeAccord"}}</th>
          <th class="sb-col-seuil">{{localize "AGONE.Seuil"}}</th>
          <th class="sb-col-portee">{{localize "AGONE.Portee"}}</th>
          <th class="sb-col-duree">{{localize "AGONE.Duree"}}</th>
          <th class="sb-col-danse">{{localize "AGONE.Danse"}}</th>
          <th class="sb-col-action"></th>
        </tr>
      </thead>
      <tbody>
        {{#each sorts as |sort|}}
        <tr class="sb-sort-row {{#if sort.hasInActor}}sb-has-sort{{/if}}" data-sort-idx="{{sort.idx}}">
          <td></td>
          <td class="sb-name">{{sort.name}}</td>
          <td class="sb-type">{{sort.typeMagie}}{{#if sort.instrument}} / {{sort.instrument}}{{/if}}</td>
          <td class="sb-seuil">{{sort.seuil}}</td>
          <td class="sb-portee">{{sort.portee}}</td>
          <td class="sb-duree">{{sort.duree}}</td>
          <td class="sb-danse">{{sort.danse}}</td>
          <td class="sb-action">
            {{#if sort.hasInActor}}
            <i class="fas fa-check sb-check" title='{{localize "AGONE.Browser.DejaPosse"}}'></i>
            {{/if}}
            <button type="button" class="sb-impro-btn btn-icon" data-action="rollSortImpro" title='{{localize "AGONE.Browser.JetImprovise"}} ({{multiply sort.seuil 2}})'>
              <i class="fas fa-random"></i>
            </button>
            <button type="button" class="sb-add-btn btn-icon" data-action="addSort" title='{{localize "AGONE.Browser.AjouterPersonnage"}}'>
              <i class="fas fa-plus"></i>
            </button>
          </td>
        </tr>
        {{#if sort.description}}
        <tr class="sort-desc-row" data-sort-idx="{{sort.idx}}">
          <td></td>
          <td colspan="7" class="sort-description-cell">
            <details class="item-details">
              <summary>{{localize "AGONE.VoirDescription"}}</summary>
              <div class="item-desc-content">{{{sort.description}}}</div>
            </details>
          </td>
        </tr>
        {{/if}}
        {{/each}}
        {{#unless sorts.length}}
        <tr><td colspan="8" class="sb-empty">{{localize "AGONE.Browser.AucunSortTrouve"}}</td></tr>
        {{/unless}}
      </tbody>
    </table>
  </div>


  {{> systems/agone/templates/apps/parts/browser-personnalises.hbs}}

</div>
