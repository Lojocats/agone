<div class="peines-browser-app">

  <!-- Barre de filtres -->
  <div class="pnb-filters">
    <div class="pnb-filter-row">
      <div class="pnb-search-wrap">
        <i class="fas fa-search"></i>
        <input type="text" class="pnb-search" placeholder="Rechercher…" value="{{search}}">
        <button type="button" class="pnb-clear" title="Effacer les filtres">
          <i class="fas fa-eraser"></i>
        </button>
      </div>
    </div>

    <div class="pnb-filter-row2">
      <select class="pnb-cat-filter">
        <option value="all" {{#if (eq filterCategorie "all")}}selected{{/if}}>Toutes catégories</option>
        {{#each categories as |c|}}
        <option value="{{c.key}}" {{#if (eq ../filterCategorie c.key)}}selected{{/if}}>{{c.label}}</option>
        {{/each}}
      </select>

      <select class="pnb-noir-filter">
        <option value="all"   {{#if (eq filterNoir "all")}}selected{{/if}}>Corps &amp; Âme</option>
        <option value="corps" {{#if (eq filterNoir "corps")}}selected{{/if}}>Corps noir</option>
        <option value="ame"   {{#if (eq filterNoir "ame")}}selected{{/if}}>Âme noire</option>
      </select>

      <span class="pnb-count">{{items.length}} résultat(s)</span>
    </div>
  </div>

  <!-- Liste -->
  <div class="pnb-list-wrapper">
    <table class="pnb-table">
      <thead>
        <tr>
          <th class="pnb-col-toggle"></th>
          <th class="pnb-col-name">Nom</th>
          <th class="pnb-col-cat">Catégorie</th>
          <th class="pnb-col-noir">Noir</th>
          <th class="pnb-col-bienfait">Bienfait</th>
          <th class="pnb-col-action"></th>
        </tr>
      </thead>
      <tbody>
        {{#each items as |item|}}
        <tr class="pnb-row {{#if item.hasInActor}}pnb-has-item{{/if}}" data-pn-idx="{{item.idx}}">
          <td>
            {{#if item.description}}
            <button type="button" class="pnb-desc-toggle btn-icon" data-action="togglePeineDesc" title="Voir la description">
              <i class="fas {{#if item.expanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
            </button>
            {{/if}}
          </td>
          <td class="pnb-name">{{item.name}}</td>
          <td class="pnb-cat">
            <span class="pnb-cat-badge pnb-cat-{{item.categorie}}">{{item.categorieLabel}}</span>
          </td>
          <td class="pnb-noir-cell">
            {{#if (eq item.noirEffect "corps")}}
            <span class="pnb-noir-badge pnb-noir-corps">Corps</span>
            {{else if (eq item.noirEffect "ame")}}
            <span class="pnb-noir-badge pnb-noir-ame">Âme</span>
            {{else}}
            <span class="pnb-noir-none">—</span>
            {{/if}}
          </td>
          <td class="pnb-bienfait-cell">
            {{#if item.bienfait}}
            <span class="pnb-bienfait-name">{{item.bienfait}}</span>
            {{else}}
            <span class="pnb-bienfait-none">Aucun</span>
            {{/if}}
          </td>
          <td class="pnb-action">
            {{#if item.hasInActor}}
            <i class="fas fa-check pnb-check" title="Déjà possédée"></i>
            {{else}}
            <button type="button" class="pnb-add-btn btn-icon" data-action="addPeine" title="Ajouter au personnage">
              <i class="fas fa-plus"></i>
            </button>
            {{/if}}
          </td>
        </tr>
        {{#if item.description}}
        <tr class="pnb-desc-row" data-pn-idx="{{item.idx}}" {{#unless item.expanded}}style="display:none"{{/unless}}>
          <td></td>
          <td colspan="5" class="pnb-description-cell">{{item.description}}</td>
        </tr>
        {{/if}}
        {{/each}}
        {{#unless items.length}}
        <tr>
          <td colspan="6" class="pnb-empty">Aucune peine ne correspond aux filtres.</td>
        </tr>
        {{/unless}}
      </tbody>
    </table>
  </div>
</div>
