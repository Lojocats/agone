<div class="peines-browser-app">

  <!-- Barre de filtres -->
  <div class="agone-filtres pnb-filters">
    {{> systems/agone/templates/apps/parts/browser-filtres-tete.hbs p="pnb" search=search compte=items.length libelle="AGONE.Browser.ResultatsCount"}}

    <div class="agone-filtres-corps">
      <label class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Categorie"}}</span>
        <select class="pnb-cat-filter">
          <option value="all" {{#if (eq filterCategorie "all")}}selected{{/if}}>{{localize "AGONE.Browser.ToutesCategories"}}</option>
          {{#each categories as |c|}}
          <option value="{{c.key}}" {{#if (eq ../filterCategorie c.key)}}selected{{/if}}>{{c.label}}</option>
          {{/each}}
        </select>
      </label>

      <label class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Noir"}}</span>
        <select class="pnb-noir-filter">
          <option value="all"   {{#if (eq filterNoir "all")}}selected{{/if}}>{{localize "AGONE.Browser.CorpsAme"}}</option>
          <option value="corps" {{#if (eq filterNoir "corps")}}selected{{/if}}>{{localize "AGONE.Browser.CorpsNoir"}}</option>
          <option value="ame"   {{#if (eq filterNoir "ame")}}selected{{/if}}>{{localize "AGONE.Browser.AmeNoire"}}</option>
        </select>
      </label>

      <label class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.Filtres.Possession"}}</span>
        <select class="pnb-possede-filter">
          <option value="all" {{#if (eq filterPossede "all")}}selected{{/if}}>{{localize "AGONE.Browser.Toutes"}}</option>
          <option value="oui" {{#if (eq filterPossede "oui")}}selected{{/if}}>{{localize "AGONE.Browser.DejaPosse"}}</option>
          <option value="non" {{#if (eq filterPossede "non")}}selected{{/if}}>{{localize "AGONE.Browser.NonPosse"}}</option>
        </select>
      </label>
    </div>
  </div>

  <!-- Liste -->
  <div class="pnb-list-wrapper">
    <table class="pnb-table">
      <thead>
        <tr>
          <th class="pnb-col-toggle"></th>
          <th class="pnb-col-name">{{localize "AGONE.Nom"}}</th>
          <th class="pnb-col-cat">{{localize "AGONE.Categorie"}}</th>
          <th class="pnb-col-noir">{{localize "AGONE.Noir"}}</th>
          <th class="pnb-col-bienfait">{{localize "AGONE.BienfaitLabel"}}</th>
          <th class="pnb-col-action"></th>
        </tr>
      </thead>
      <tbody>
        {{#each items as |item|}}
        <tr class="pnb-row {{#if item.hasInActor}}pnb-has-item{{/if}}" data-pn-idx="{{item.idx}}">
          <td></td>
          <td class="pnb-name">{{item.name}}</td>
          <td class="pnb-cat">
            <span class="pnb-cat-badge pnb-cat-{{item.categorie}}">{{item.categorieLabel}}</span>
          </td>
          <td class="pnb-noir-cell">
            {{#if (eq item.noirEffect "corps")}}
            <span class="pnb-noir-badge pnb-noir-corps">{{localize "AGONE.Corps"}}</span>
            {{else if (eq item.noirEffect "ame")}}
            <span class="pnb-noir-badge pnb-noir-ame">{{localize "AGONE.Ame"}}</span>
            {{else}}
            <span class="pnb-noir-none">—</span>
            {{/if}}
          </td>
          <td class="pnb-bienfait-cell">
            {{#if item.bienfait}}
            <span class="pnb-bienfait-name">{{item.bienfait}}</span>
            {{#if item.bienfaitDescription}}<i class="fas fa-info-circle pn-bienfait-info" data-tooltip="{{item.bienfaitDescription}}" data-tooltip-class="agone-tooltip-texte"></i>{{/if}}
            {{else}}
            <span class="pnb-bienfait-none">{{localize "AGONE.Aucun"}}</span>
            {{/if}}
          </td>
          <td class="pnb-action">
            {{#if item.hasInActor}}
            <i class="fas fa-check pnb-check" title='{{localize "AGONE.Browser.DejaPosse"}}'></i>
            {{else}}
            <button type="button" class="pnb-add-btn btn-icon" data-action="addPeine" title='{{localize "AGONE.Browser.AjouterPersonnage"}}'>
              <i class="fas fa-plus"></i>
            </button>
            {{/if}}
          </td>
        </tr>
        {{#if item.description}}
        <tr class="pnb-desc-row" data-pn-idx="{{item.idx}}">
          <td></td>
          <td colspan="5" class="pnb-description-cell">
            <details class="item-details">
              <summary>{{localize "AGONE.VoirDescription"}}</summary>
              <div class="item-desc-content">{{{item.description}}}</div>
            </details>
          </td>
        </tr>
        {{/if}}
        {{/each}}
        {{#unless items.length}}
        <tr>
          <td colspan="6" class="pnb-empty">{{localize "AGONE.Browser.AucunePeineTrouvee"}}</td>
        </tr>
        {{/unless}}
      </tbody>
    </table>
  </div>

  {{> systems/agone/templates/apps/parts/browser-personnalises.hbs}}

</div>
