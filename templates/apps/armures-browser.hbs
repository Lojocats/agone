<div class="armures-browser-app">

  <!-- Barre de filtres -->
  <div class="agone-filtres arb-filters">
    {{> systems/agone/templates/apps/parts/browser-filtres-tete.hbs p="arb" search=search compte=items.length libelle="AGONE.Browser.ArmuresCount"}}

    <div class="agone-filtres-corps">
      <!-- Couverture -->
      <div class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.Couverture"}}</span>
        <div class="agone-chips">
          <label class="agone-chip"><input type="checkbox" class="arb-all-couv" {{#if allCouvSelected}}checked{{/if}}><span>{{localize "AGONE.Browser.Tous"}}</span></label>
          {{#each allCouv}}
          <label class="agone-chip"><input type="checkbox" class="arb-couv-check" value="{{this.value}}" {{#if this.active}}checked{{/if}}><span>{{this.label}}</span></label>
          {{/each}}
        </div>
      </div>

      <label class="agone-filtre-groupe agone-filtre-nombre">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.Filtres.ProtMin"}}</span>
        <input type="number" class="arb-prot-min" value="{{filterProtMin}}" placeholder="—" min="0" max="20">
      </label>
      <label class="agone-filtre-groupe agone-filtre-nombre">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.Filtres.MalusAgiMax"}}</span>
        <input type="number" class="arb-malus-agi-max" value="{{filterMalusAgiMax}}" placeholder="—" min="0" max="20">
      </label>

      <label class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.Filtres.Possession"}}</span>
        <select class="arb-possede-filter">
          <option value="all" {{#if (eq filterPossede "all")}}selected{{/if}}>{{localize "AGONE.Browser.Toutes"}}</option>
          <option value="oui" {{#if (eq filterPossede "oui")}}selected{{/if}}>{{localize "AGONE.Browser.DejaPosse"}}</option>
          <option value="non" {{#if (eq filterPossede "non")}}selected{{/if}}>{{localize "AGONE.Browser.NonPosse"}}</option>
        </select>
      </label>
    </div>
  </div>

  <!-- Tableau -->
  <div class="arb-list-wrapper">
    <table class="arb-table">
      <thead>
        <tr>
          <th class="arb-col-name">{{localize "AGONE.Nom"}}</th>
          <th class="arb-col-type">{{localize "AGONE.Browser.Couverture"}}</th>
          <th class="arb-col-prot" data-tooltip='{{localize "AGONE.Protection"}}'>{{localize "AGONE.Combat.Pro"}}</th>
          <th class="arb-col-malus" data-tooltip='{{localize "AGONE.MalusAgi"}}'>{{localize "AGONE.Combat.MalusAgi"}}</th>
          <th class="arb-col-malus" data-tooltip='{{localize "AGONE.MalusPer"}}'>{{localize "AGONE.Combat.MalusPer"}}</th>
          <th class="arb-col-action"></th>
        </tr>
      </thead>
      <tbody>
        {{#each items as |item|}}
        <tr class="arb-row {{#if item.hasInActor}}arb-has-item{{/if}}" data-armure-idx="{{item.idx}}">
          <td class="arb-name">{{item.label}}</td>
          <td class="arb-type">{{item.typeLabel}}</td>
          <td class="arb-prot"><strong>{{item.protection}}</strong></td>
          <td class="arb-malus">{{#if item.malusAgi}}-{{item.malusAgi}}{{else}}0{{/if}}</td>
          <td class="arb-malus">{{#if item.malusPer}}-{{item.malusPer}}{{else}}0{{/if}}</td>
          <td class="arb-action">
            {{#if item.hasInActor}}
            <i class="fas fa-check arb-check" data-tooltip='{{localize "AGONE.Browser.DejaPosse"}}'></i>
            {{else}}
            <button type="button" class="arb-add-btn btn-icon" data-action="addArmure" data-tooltip='{{localize "AGONE.Browser.AjouterPersonnage"}}' aria-label='{{localize "AGONE.Browser.AjouterPersonnage"}}'>
              <i class="fas fa-plus"></i>
            </button>
            {{/if}}
          </td>
        </tr>
        {{/each}}
        {{#unless items.length}}
        <tr><td colspan="5" class="arb-empty">{{localize "AGONE.Browser.AucuneArmureTrouvee"}}</td></tr>
        {{/unless}}
      </tbody>
    </table>
  </div>


  {{> systems/agone/templates/apps/parts/browser-personnalises.hbs}}

</div>
