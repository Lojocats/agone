<div class="armures-browser-app">

  <!-- Barre de filtres -->
  <div class="arb-filters">
    <div class="arb-filter-row">
      <div class="arb-search-wrap">
        <i class="fas fa-search"></i>
        <input type="text" class="arb-search" placeholder='{{localize "AGONE.Browser.Rechercher"}}' value="{{search}}">
      </div>
      <button type="button" class="arb-clear" title='{{localize "AGONE.Browser.EffacerFiltres"}}'>
        <i class="fas fa-eraser"></i>
      </button>
    </div>

    <div class="arb-filter-row2">
      <select class="arb-possede-filter">
        <option value="all" {{#if (eq filterPossede "all")}}selected{{/if}}>{{localize "AGONE.Browser.Toutes"}}</option>
        <option value="oui" {{#if (eq filterPossede "oui")}}selected{{/if}}>{{localize "AGONE.Browser.DejaPosse"}}</option>
        <option value="non" {{#if (eq filterPossede "non")}}selected{{/if}}>{{localize "AGONE.Browser.NonPosse"}}</option>
      </select>
      <span class="arb-count">{{items.length}} {{localize "AGONE.Browser.ArmuresCount"}}</span>
    </div>
  </div>

  <!-- Tableau -->
  <div class="arb-list-wrapper">
    <table class="arb-table">
      <thead>
        <tr>
          <th class="arb-col-name">{{localize "AGONE.Nom"}}</th>
          <th class="arb-col-type">{{localize "AGONE.Browser.Couverture"}}</th>
          <th class="arb-col-prot" title='{{localize "AGONE.Protection"}}'>{{localize "AGONE.Combat.Pro"}}</th>
          <th class="arb-col-malus" title='{{localize "AGONE.MalusAgi"}}'>{{localize "AGONE.Combat.MalusAgi"}}</th>
          <th class="arb-col-malus" title='{{localize "AGONE.MalusPer"}}'>{{localize "AGONE.Combat.MalusPer"}}</th>
          <th class="arb-col-action"></th>
        </tr>
      </thead>
      <tbody>
        {{#each items as |item|}}
        <tr class="arb-row {{#if item.hasInActor}}arb-has-item{{/if}}" data-armure-idx="{{item.idx}}">
          <td class="arb-name">{{item.label}}</td>
          <td class="arb-type">{{item.typeLabel}}</td>
          <td class="arb-prot"><strong>{{item.protection}}</strong></td>
          <td class="arb-malus">{{#if item.malusAgi}}-{{item.malusAgi}}{{else}}0{{/if}}</td>
          <td class="arb-malus">{{#if item.malusPer}}-{{item.malusPer}}{{else}}0{{/if}}</td>
          <td class="arb-action">
            {{#if item.hasInActor}}
            <i class="fas fa-check arb-check" title='{{localize "AGONE.Browser.DejaPosse"}}'></i>
            {{else}}
            <button type="button" class="arb-add-btn btn-icon" data-action="addArmure" title='{{localize "AGONE.Browser.AjouterPersonnage"}}'>
              <i class="fas fa-plus"></i>
            </button>
            {{/if}}
          </td>
        </tr>
        {{/each}}
        {{#unless items.length}}
        <tr><td colspan="5" class="arb-empty">{{localize "AGONE.Browser.AucuneArmureTrouvee"}}</td></tr>
        {{/unless}}
      </tbody>
    </table>
  </div>

</div>
