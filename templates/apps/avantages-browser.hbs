<div class="avantages-browser-app">

  <!-- Barre de filtres -->
  <div class="avb-filters">
    <div class="avb-filter-row">
      <div class="avb-search-wrap">
        <i class="fas fa-search"></i>
        <input type="text" class="avb-search" placeholder='{{localize "AGONE.Browser.Rechercher"}}' value="{{search}}">
      </div>
      <button type="button" class="avb-clear" title='{{localize "AGONE.Browser.EffacerFiltres"}}'>
        <i class="fas fa-eraser"></i>
      </button>
    </div>

    <div class="avb-filter-row2">
      <select class="avb-section-filter">
        <option value="all" {{#if (eq filterSection "all")}}selected{{/if}}>{{localize "AGONE.Browser.ToutesCategories"}}</option>
        {{#each sections as |s|}}
        <option value="{{s.key}}" {{#if (eq ../filterSection s.key)}}selected{{/if}}>{{s.label}}</option>
        {{/each}}
      </select>

      <select class="avb-type-filter">
        <option value="all"      {{#if (eq filterType "all")}}selected{{/if}}>{{localize "AGONE.Browser.AvantagesDefauts"}}</option>
        <option value="avantage" {{#if (eq filterType "avantage")}}selected{{/if}}>{{localize "AGONE.Browser.AvantagesUniquement"}}</option>
        <option value="defaut"   {{#if (eq filterType "defaut")}}selected{{/if}}>{{localize "AGONE.Browser.DefautsUniquement"}}</option>
      </select>

      <select class="avb-charge-filter" title="Filtrer par charge exacte">
        <option value="">{{localize "AGONE.Browser.ToutesCharges"}}</option>
        {{#each allCharges}}
        <option value="{{this}}" {{#if (eq ../filterChargeExact this)}}selected{{/if}}>{{#if (gt this 0)}}+{{/if}}{{this}}</option>
        {{/each}}
      </select>

      <select class="avb-possede-filter">
        <option value="all" {{#if (eq filterPossede "all")}}selected{{/if}}>{{localize "AGONE.Browser.Tous"}}</option>
        <option value="oui" {{#if (eq filterPossede "oui"}}selected{{/if}}>{{localize "AGONE.Browser.DejaPosse"}}</option>
        <option value="non" {{#if (eq filterPossede "non")}}selected{{/if}}>{{localize "AGONE.Browser.NonPosse"}}</option>
      </select>

      <span class="avb-count">{{items.length}} {{localize "AGONE.Browser.ResultatsCount"}}</span>
    </div>
  </div>

  <!-- Liste -->
  <div class="avb-list-wrapper">
    <table class="avb-table">
      <thead>
        <tr>
          <th class="avb-col-toggle"></th>
          <th class="avb-col-name">{{localize "AGONE.Nom"}}</th>
          <th class="avb-col-section">{{localize "AGONE.Categorie"}}</th>
          <th class="avb-col-type">{{localize "AGONE.Type"}}</th>
          <th class="avb-col-charge">{{localize "AGONE.Charge"}}</th>
          <th class="avb-col-action"></th>
        </tr>
      </thead>
      <tbody>
        {{#each items as |item|}}
        <tr class="avb-row avb-row-{{item.type}} {{#if item.hasInActor}}avb-has-item{{/if}}" data-av-idx="{{item.idx}}">
          <td>
            {{#if item.description}}
            <button type="button" class="avb-desc-toggle btn-icon" data-action="toggleAvDesc" title='{{localize "AGONE.VoirDescription"}}'>
              <i class="fas {{#if item.expanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
            </button>
            {{/if}}
          </td>
          <td class="avb-name">{{item.name}}</td>
          <td class="avb-section">
            <span class="avb-section-badge avb-sect-{{item.section}}">{{item.sectionLabel}}</span>
          </td>
          <td class="avb-type">
            {{#if (eq item.type "avantage")}}
            <span class="avb-badge avb-badge-avantage">{{localize "AGONE.Avantage"}}</span>
            {{else}}
            <span class="avb-badge avb-badge-defaut">{{localize "AGONE.Defaut"}}</span>
            {{/if}}
          </td>
          <td class="avb-charge">
            {{#if (eq item.type "avantage")}}
            <span class="avb-charge-pos">+{{item.chargeAbs}}</span>
            {{else}}
            <span class="avb-charge-neg">-{{item.chargeAbs}}</span>
            {{/if}}
          </td>
          <td class="avb-action">
            {{#if item.hasInActor}}
            <i class="fas fa-check avb-check" title='{{localize "AGONE.Browser.DejaPosse"}}'></i>
            {{else}}
            <button type="button" class="avb-add-btn btn-icon" data-action="addAvantage" title='{{localize "AGONE.Browser.AjouterPersonnage"}}'>
              <i class="fas fa-plus"></i>
            </button>
            {{/if}}
          </td>
        </tr>
        {{#if item.description}}
        <tr class="avb-desc-row" data-av-idx="{{item.idx}}" {{#unless item.expanded}}style="display:none"{{/unless}}>
          <td></td>
          <td colspan="5" class="avb-description-cell">
            {{#if item.prerequis}}
            <em class="avb-prerequis">{{localize "AGONE.Prerequis"}} : {{item.prerequis}}</em>
            {{/if}}
            {{item.description}}
          </td>
        </tr>
        {{/if}}
        {{/each}}
        {{#unless items.length}}
        <tr><td colspan="6" class="avb-empty">{{localize "AGONE.Browser.AucunResultatTrouve"}}</td></tr>
        {{/unless}}
      </tbody>
    </table>
  </div>

</div>
