<div class="cb-app">

  <!-- Filtres -->
  <div class="agone-filtres cb-filters">
    {{> systems/agone/templates/apps/parts/browser-filtres-tete.hbs p="cb" search=search compte=competences.length libelle="AGONE.Browser.ResultatsCount"}}

    <div class="agone-filtres-corps">
      <!-- Familles -->
      <div class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Famille"}}</span>
        <div class="agone-chips">
          <label class="agone-chip"><input type="checkbox" class="cb-all-check" {{#if allFamillesSelected}}checked{{/if}}><span>{{localize "AGONE.Browser.Tous"}}</span></label>
          {{#each allFamilles as |f|}}
          <label class="agone-chip"><input type="checkbox" class="cb-fam-check" value="{{f.value}}" {{#if f.active}}checked{{/if}}><span>{{f.label}}</span></label>
          {{/each}}
        </div>
      </div>

      <!-- Attribut lié -->
      <label class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.AttributLie"}}</span>
        <select class="cb-attribut-filter">
          <option value="all" {{#if (eq filterAttribut "all")}}selected{{/if}}>{{localize "AGONE.Browser.Filtres.TousAttributs"}}</option>
          {{#each allAttributs as |a|}}
          <option value="{{a.value}}" {{#if (eq ../filterAttribut a.value)}}selected{{/if}}>{{a.label}}</option>
          {{/each}}
        </select>
      </label>

      <!-- Possédées -->
      <label class="agone-filtre-groupe">
        <span class="agone-filtre-label">{{localize "AGONE.Browser.Filtres.Possession"}}</span>
        <select class="cb-possede-select">
          <option value="all"  {{#if (eq filterPossede "all")}}selected{{/if}}>{{localize "AGONE.Browser.Toutes"}}</option>
          <option value="oui"  {{#if (eq filterPossede "oui")}}selected{{/if}}>{{localize "AGONE.Browser.Possedees"}}</option>
          <option value="non"  {{#if (eq filterPossede "non")}}selected{{/if}}>{{localize "AGONE.Browser.NonPosse"}}</option>
        </select>
      </label>
    </div>
  </div>

  <!-- Tableau -->
  <div class="cb-table-wrap">
    <table class="cb-table">
      <thead>
        <tr>
          <th>{{localize "AGONE.Competences"}}</th>
          <th>{{localize "AGONE.Famille"}}</th>
          <th>{{localize "AGONE.AttributLie"}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each competences as |c|}}
        <tr class="cb-row {{#if c.count}}cb-row-owned{{/if}}">
          <td class="cb-name">
            {{c.displayName}}
            {{#if c.count}}<span class="cb-count-badge" title='{{localize "AGONE.Ui.PossedeeNFois" n=c.count}}'>x{{c.count}}</span>{{/if}}
          </td>
          <td><span class="cb-fam-badge fam-{{c.famille}}">{{c.famille}}</span></td>
          <td class="cb-attr">{{c.attributLabel}}</td>
          <td>
            <button type="button" class="cb-add-btn" data-action="addCompetence"
                    data-name="{{c.name}}" data-attribut-lie="{{c.attributLie}}"
                    title='{{localize "AGONE.Ui.AjouterNom" nom=c.name}}'>
              <i class="fas fa-plus"></i>
            </button>
          </td>
        </tr>
        {{/each}}
        {{#unless competences.length}}
        <tr><td colspan="4" class="cb-empty">{{localize "AGONE.Browser.AucuneCompTrouvee"}}</td></tr>
        {{/unless}}
      </tbody>
    </table>
  </div>


  {{> systems/agone/templates/apps/parts/browser-personnalises.hbs}}

</div>
