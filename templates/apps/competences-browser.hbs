<div class="cb-app">

  <!-- Filtres -->
  <div class="cb-filters">
    <div class="cb-search-wrap">
      <i class="fas fa-search cb-search-icon"></i>
      <input type="text" class="cb-search" placeholder='{{localize "AGONE.Browser.Rechercher"}}' value="{{search}}" />
      {{#if search}}<button type="button" class="cb-search-clear" title='{{localize "AGONE.Browser.Effacer"}}'>✕</button>{{/if}}
    </div>

    <div class="cb-filter-row">
      <!-- Domaines -->
      <div class="cb-dom-filters">
        <label>
          <input type="checkbox" class="cb-all-check" {{#if allFamillesSelected}}checked{{/if}} />
          {{localize "AGONE.Browser.Tous"}}
        </label>
        {{#each allFamilles as |f|}}
        <label>
          <input type="checkbox" class="cb-fam-check" value="{{f.value}}" {{#if f.active}}checked{{/if}} />
          <span class="cb-fam-badge fam-{{f.value}}">{{f.label}}</span>
        </label>
        {{/each}}
      </div>

      <!-- Possédées -->
      <select class="cb-possede-select">
        <option value="all"  {{#if (eq filterPossede "all")}}selected{{/if}}>{{localize "AGONE.Browser.Toutes"}}</option>
        <option value="oui"  {{#if (eq filterPossede "oui"}}selected{{/if}}>{{localize "AGONE.Browser.Possedees"}}</option>
        <option value="non"  {{#if (eq filterPossede "non")}}selected{{/if}}>{{localize "AGONE.Browser.NonPosse"}}</option>
      </select>
    </div>
  </div>

  <!-- Tableau -->
  <div class="cb-table-wrap">
    <table class="cb-table">
      <thead>
        <tr>
          <th>{{localize "AGONE.Competences"}}</th>
          <th>{{localize "AGONE.Famille"}}</th>
          <th>{{localize "AGONE.AttributLie"}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each competences as |c|}}
        <tr class="cb-row {{#if c.count}}cb-row-owned{{/if}}">
          <td class="cb-name">
            {{c.displayName}}
            {{#if c.count}}<span class="cb-count-badge" title="Possédée {{c.count}} fois">x{{c.count}}</span>{{/if}}
          </td>
          <td><span class="cb-fam-badge fam-{{c.famille}}">{{c.famille}}</span></td>
          <td class="cb-attr">{{c.attributLie}}</td>
          <td>
            <button type="button" class="cb-add-btn" data-action="addCompetence"
                    data-name="{{c.name}}" data-attribut-lie="{{c.attributLie}}"
                    title="Ajouter «{{c.name}}»">
              <i class="fas fa-plus"></i>
            </button>
          </td>
        </tr>
        {{/each}}
        {{#unless competences.length}}
        <tr><td colspan="4" class="cb-empty">{{localize "AGONE.Browser.AucuneCompTrouvee"}}</td></tr>
        {{/unless}}
      </tbody>
    </table>
  </div>

</div>
