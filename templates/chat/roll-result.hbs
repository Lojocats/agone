{{! Template de résultat de jet de dés Agone }}
<div class="agone-roll-card">
  <div class="roll-header">
    <span class="roll-label">{{label}}</span>
    {{#if rollType}}
    <span class="roll-type badge-{{rollType}}">
      {{#if (eq rollType "ouvert")}}{{localize "AGONE.JetOuvertLabel"}}{{else}}{{localize "AGONE.JetFermeLabel"}}{{/if}}
    </span>
    {{/if}}
  </div>

  <div class="roll-result">
    <span class="roll-total {{#if isFumble}}fumble-adjusted{{/if}}">
      {{#if fumbleTotal}}{{fumbleTotal}}{{else}}{{total}}{{/if}}
    </span>
    {{#if seuil}}<span class="roll-seuil">/ {{seuil}}</span>{{/if}}
    {{#if resultat}}<span class="roll-resultat {{#if (eq resultat "✔ Succès")}}roll-succes{{else}}roll-echec{{/if}}">{{resultat}}</span>{{/if}}
  </div>

  {{#if details}}
  <details class="roll-details">
    <summary class="roll-details-summary"><i class="fas fa-list-ul"></i> Détails du calcul</summary>
    <table class="roll-breakdown">
      <tbody>
        {{#each details as |detail|}}
        <tr>
          <td class="detail-label">{{detail.label}}</td>
          <td class="detail-value"{{#if detail.tooltip}} title="{{detail.tooltip}}"{{/if}}>{{detail.value}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </details>
  {{/if}}

  {{#if isFumble}}
  <div class="fumble-alert{{#if isMegaFumble}} mega-fumble-alert{{/if}}">
    <i class="fas fa-skull"></i> <strong>{{#if isMegaFumble}}{{localize "AGONE.MegaFumble"}}{{else}}{{localize "AGONE.Fumble"}}{{/if}}</strong>
    — {{localize "AGONE.PenaliteFumble"}} : -{{fumblePenalty}}
    {{#if fumbleTotal}}<span class="fumble-total-adj">({{localize "AGONE.TotalAjuste"}} : {{fumbleTotal}})</span>{{/if}}
  </div>
  {{/if}}

  {{#if isCritique}}
  <div class="critique-alert">
    <i class="fas fa-star"></i> <strong>{{localize "AGONE.JetCritique"}}</strong>
  </div>
  {{/if}}

  {{#if sortMeta}}
  <div class="roll-sort-meta">
    {{#if sortMeta.typeMagie}}<span class="sort-meta-badge sort-type">{{sortMeta.typeMagie}}</span>{{/if}}
    {{#if sortMeta.portee}}<span class="sort-meta-badge"><i class="fas fa-location-arrow"></i> {{sortMeta.portee}}</span>{{/if}}
    {{#if sortMeta.duree}}<span class="sort-meta-badge"><i class="fas fa-hourglass-half"></i> {{sortMeta.duree}}</span>{{/if}}
    {{#if sortMeta.danse}}<span class="sort-meta-badge"><i class="fas fa-music"></i> {{sortMeta.danse}}</span>{{/if}}
  </div>
  {{/if}}

  {{#if armeMeta}}
  <div class="roll-sort-meta">
    {{#if (eq armeMeta.style "trait")}}<span class="sort-meta-badge sort-type"><i class="fas fa-bow-arrow"></i> Trait</span>
    {{else if (eq armeMeta.style "jet")}}<span class="sort-meta-badge sort-type"><i class="fas fa-khanda"></i> Jet</span>
    {{else if (eq armeMeta.style "bouclier")}}<span class="sort-meta-badge sort-type"><i class="fas fa-shield-alt"></i> Bouclier</span>
    {{else}}<span class="sort-meta-badge sort-type"><i class="fas fa-sword"></i> Mêlée</span>{{/if}}
    {{#if armeMeta.portee}}<span class="sort-meta-badge"><i class="fas fa-location-arrow"></i> {{armeMeta.portee}}</span>{{/if}}
    {{#if armeMeta.dommages}}<span class="sort-meta-badge"><i class="fas fa-tint"></i> Dom : {{armeMeta.dommages}}{{#if armeMeta.dommagesTotal}} (tot. {{armeMeta.dommagesTotal}}){{/if}}</span>{{/if}}
  </div>
  {{/if}}

  {{#if description}}
  <details class="roll-sort-description">
    <summary><i class="fas fa-book-open"></i> {{#if sortMeta}}Description du sort{{else}}Description{{/if}}</summary>
    <div class="roll-sort-desc-content">{{{description}}}</div>
  </details>
  {{/if}}
</div>
