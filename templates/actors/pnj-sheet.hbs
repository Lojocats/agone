<form class="agone sheet actor pnj" autocomplete="off">
  <header class="sheet-header">
    <div class="header-portrait">
      <img class="profile-img" src="{{actor.img}}" data-edit="img" data-tooltip="{{actor.name}}" />
    </div>
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'AGONE.FeuillePnj'}}" />
      </h1>
      <div class="header-row secondary-stats">
        <div class="stat-box">
          <label>{{localize "AGONE.PdV"}}</label>
          <input type="number" name="system.pdv.valeur" value="{{system.pdv.valeur}}" class="stat-num" />
          <span>/</span>
          <input type="number" name="system.pdv.max" value="{{system.pdv.max}}" class="stat-num" />
        </div>
        <div class="stat-box">
          <label class="txt-flamme">{{localize "AGONE.Flamme"}}</label>
          <span class="stat-num txt-flamme flamme-glow">{{system.flamme}}</span>
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.MV"}}</label>
          <input type="number" name="system.mv" value="{{system.mv}}" class="stat-num" />
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.TAI"}}</label>
          <input type="number" name="system.tai" value="{{system.tai}}" class="stat-num" />
        </div>
        <div class="stat-box npc-text-box">
          <label>{{localize "AGONE.Race"}}</label>
          <input type="text" name="system.race" value="{{system.race}}" class="stat-text" list="agone-pnj-peuples-{{actor.id}}"
                 data-tooltip='{{localize "AGONE.RacePnjTooltip"}}' />
          <datalist id="agone-pnj-peuples-{{actor.id}}">
            {{#each peuplesNoms as |nom|}}<option value="{{nom}}"></option>{{/each}}
          </datalist>
        </div>
      </div>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="attributs">{{localize "AGONE.Attributs"}}</a>
    <a class="item" data-tab="combat">{{localize "AGONE.Combat.Combat"}}</a>
    <a class="item" data-tab="competences">{{localize "AGONE.Competences"}}</a>
    <a class="item" data-tab="magie">{{localize "AGONE.Magie"}}</a>
    <a class="item" data-tab="notes">{{localize "AGONE.Notes"}}</a>
  </nav>

  <section class="sheet-body">

    <!-- ATTRIBUTS -->
    <div class="tab" data-group="primary" data-tab="attributs">

      <!-- Aspects -->
      <div class="combat-card npc-card-espace-bas">
        <h3 class="combat-card-title"><i class="fas fa-fire"></i> {{localize "AGONE.Aspects"}}</h3>
        <div class="cstats-grid">
          <div class="cstat-item">
            <input type="number" name="system.corps" value="{{source.corps}}" class="stat-num cstat-input" />
            <span class="cstat-label">{{localize "AGONE.Corps"}}</span>
            {{> systems/agone/templates/actors/parts/badges-bonus.hbs badges=badges.corps}}
          </div>
          <div class="cstat-item">
            <input type="number" name="system.esprit" value="{{source.esprit}}" class="stat-num cstat-input" />
            <span class="cstat-label">{{localize "AGONE.Esprit"}}</span>
            {{> systems/agone/templates/actors/parts/badges-bonus.hbs badges=badges.esprit}}
          </div>
          <div class="cstat-item">
            <input type="number" name="system.ame" value="{{source.ame}}" class="stat-num cstat-input" />
            <span class="cstat-label">{{localize "AGONE.Ame"}}</span>
            {{> systems/agone/templates/actors/parts/badges-bonus.hbs badges=badges.ame}}
          </div>
          <div class="cstat-item">
            <span class="cstat-score txt-flamme flamme-glow">{{system.flamme}}</span>
            <span class="cstat-label txt-flamme">{{localize "AGONE.Flamme"}}</span>
          </div>
          <div class="cstat-item">
            <span class="cstat-score">{{system.art}}</span>
            <span class="cstat-label">{{localize "AGONE.Art"}}</span>
            {{> systems/agone/templates/actors/parts/badges-bonus.hbs badges=badges.art}}
          </div>
        </div>
      </div>

      <div class="npc-sheet-layout">

        <!-- Caracs primaires -->
        <div class="npc-left-col">
          <div class="combat-card">
            <h3 class="combat-card-title"><i class="fas fa-person"></i> {{localize "AGONE.Caracteristiques"}}</h3>
            {{> systems/agone/templates/actors/parts/caracs-simples.hbs}}
          </div>
        </div>

        <!-- Stats dérivées + Santé -->
        <div class="npc-right-col">
          <div class="combat-card">
            <h3 class="combat-card-title"><i class="fas fa-khanda"></i> {{localize "AGONE.StatsCombat"}}</h3>
            {{> systems/agone/templates/actors/parts/cstats-simples.hbs}}
            <div class="npc-bloc-espace">
              <div class="carac-row">
                <label>{{localize "AGONE.ObedienceMagique"}}</label>
                <select name="system.typeMage" class="emprise-type-select">
                  <option value="jorniste"       {{#if (eq system.typeMage "jorniste")}}selected{{/if}}>{{localize "AGONE.JornisteDetail"}}</option>
                  <option value="eclipsiste"     {{#if (eq system.typeMage "eclipsiste")}}selected{{/if}}>{{localize "AGONE.EclipsisteDetail"}}</option>
                  <option value="obscurantiste"  {{#if (eq system.typeMage "obscurantiste")}}selected{{/if}}>{{localize "AGONE.ObscurantisteDetail"}}</option>
                </select>
              </div>
            </div>
          </div>

          {{> systems/agone/templates/actors/parts/sante-simple.hbs jauge=system.pdv labelJauge="PdV" pct=pdvPercent classeCarte="npc-card-espace"}}
        </div>

      </div>
    </div>

    <!-- COMBAT -->
    <div class="tab" data-group="primary" data-tab="combat">
      <div class="combat-section">

        <!-- LIGNE HAUTE : Santé + Stats Combat -->
        <div class="combat-top-row">
          {{> systems/agone/templates/actors/parts/sante-simple.hbs jauge=system.pdv labelJauge="PdV" pct=pdvPercent}}

          <div class="combat-card cstats-card">
            <h3 class="combat-card-title"><i class="fas fa-khanda"></i> {{localize "AGONE.StatsCombat"}}</h3>
            {{> systems/agone/templates/actors/parts/cstats-simples.hbs}}
          </div>
        </div><!-- /.combat-top-row -->

        {{> systems/agone/templates/actors/parts/armures-card.hbs}}

        {{> systems/agone/templates/actors/parts/armes-card.hbs}}

        {{> systems/agone/templates/actors/parts/manoeuvres-card.hbs}}

      </div><!-- /.combat-section -->
    </div>

    <!-- COMPÉTENCES -->
    <div class="tab" data-group="primary" data-tab="competences">
      {{> systems/agone/templates/actors/parts/competences.hbs}}
    </div>

    <!-- MAGIE -->
    <div class="tab" data-group="primary" data-tab="magie">
      {{> systems/agone/templates/actors/parts/magie.hbs}}
    </div>

    <!-- NOTES -->
    <div class="tab" data-group="primary" data-tab="notes">
      <div class="npc-notes-block">
        <h3 class="npc-notes-title">{{localize "AGONE.Notes"}}</h3>
        <div class="editor-container">
          {{#if editable}}
            <prose-mirror name="system.description" value="{{system.description}}" document-uuid="{{actor.uuid}}"></prose-mirror>
          {{else}}
            <div class="editor-content">{{{descriptionHTML}}}</div>
          {{/if}}
        </div>
      </div>
      <div class="npc-notes-block">
        <h3 class="npc-notes-title">{{localize "AGONE.Equipement"}}</h3>
        <textarea name="system.equipement" class="npc-equip-textarea" placeholder='{{localize "AGONE.Ui.EquipementPlaceholder"}}'>{{system.equipement}}</textarea>
      </div>
    </div>

  </section>
</form>
