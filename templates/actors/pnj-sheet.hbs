<form class="agone sheet actor pnj" autocomplete="off">
  <header class="sheet-header">
    <div class="header-portrait">
      <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    </div>
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder="Nom du PNJ" />
      </h1>
      <div class="header-row secondary-stats">
        <div class="stat-box">
          <label>{{localize "AGONE.PdV"}}</label>
          <input type="number" name="system.pdv.valeur" value="{{system.pdv.valeur}}" class="stat-num" />
          <span>/</span>
          <input type="number" name="system.pdv.max" value="{{system.pdv.max}}" class="stat-num" />
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.Flamme"}}</label>
          <input type="number" name="system.flamme" value="{{system.flamme}}" class="stat-num" />
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.Initiative"}}</label>
          <span class="derived-val">{{system.initiative}}</span>
          <button type="button" class="roll-btn-small" data-action="rollInitiative">
            <i class="fas fa-dice-d10"></i>
          </button>
        </div>
      </div>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="attributs">{{localize "AGONE.Attributs"}}</a>
    <a class="item" data-tab="combat">{{localize "AGONE.Combat"}}</a>
    <a class="item" data-tab="notes">{{localize "AGONE.Notes"}}</a>
  </nav>

  <section class="sheet-body">

    <!-- ATTRIBUTS -->
    <div class="tab" data-group="primary" data-tab="attributs">
      <div class="carac-grid">
        <div class="carac-row">
          <label>{{localize "AGONE.Attribut.Agilite"}}</label>
          <input type="number" name="system.agilite" value="{{system.agilite}}" class="stat-num" />
        </div>
        <div class="carac-row">
          <label>{{localize "AGONE.Attribut.Force"}}</label>
          <input type="number" name="system.force" value="{{system.force}}" class="stat-num" />
        </div>
        <div class="carac-row">
          <label>{{localize "AGONE.Attribut.Perception"}}</label>
          <input type="number" name="system.perception" value="{{system.perception}}" class="stat-num" />
        </div>
        <div class="carac-row">
          <label>{{localize "AGONE.Attribut.Resistance"}}</label>
          <input type="number" name="system.resistance" value="{{system.resistance}}" class="stat-num" />
        </div>
        <div class="carac-row">
          <label>{{localize "AGONE.Attribut.Intelligence"}}</label>
          <input type="number" name="system.intelligence" value="{{system.intelligence}}" class="stat-num" />
        </div>
        <div class="carac-row">
          <label>{{localize "AGONE.Attribut.Volonte"}}</label>
          <input type="number" name="system.volonte" value="{{system.volonte}}" class="stat-num" />
        </div>
        <div class="carac-row">
          <label>{{localize "AGONE.Attribut.Charisma"}}</label>
          <input type="number" name="system.charisma" value="{{system.charisma}}" class="stat-num" />
        </div>
        <div class="carac-row">
          <label>{{localize "AGONE.Attribut.Creativite"}}</label>
          <input type="number" name="system.creativite" value="{{system.creativite}}" class="stat-num" />
        </div>
      </div>
      <div class="derived-grid">
        <div class="derived-row">
          <label>{{localize "AGONE.Melee"}}</label><span class="derived-val">{{system.melee}}</span>
        </div>
        <div class="derived-row">
          <label>{{localize "AGONE.Tir"}}</label><span class="derived-val">{{system.tir}}</span>
        </div>
        <div class="derived-row">
          <label>{{localize "AGONE.BD"}}</label>
          <input type="number" name="system.bd" value="{{system.bd}}" class="stat-num" />
        </div>
      </div>
    </div>

    <!-- COMBAT -->
    <div class="tab" data-group="primary" data-tab="combat">
      <div class="section-header">
        <h3>{{localize "AGONE.Armes"}}</h3>
        <button type="button" class="item-create" data-type="arme"><i class="fas fa-plus"></i></button>
      </div>
      {{#if armes.length}}
      <table class="armes-table">
        <thead>
          <tr>
            <th>{{localize "AGONE.Nom"}}</th>
            <th>{{localize "AGONE.Dommages"}}</th>
            <th>{{localize "AGONE.AttaqTotal"}}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each armes as |arme|}}
          <tr class="item-row" data-item-id="{{arme.id}}">
            <td>{{arme.name}}</td>
            <td>{{arme.system.dommages}}</td>
            <td>{{arme.system.attackTotal}}</td>
            <td>
              <button type="button" class="roll-btn-small" data-action="rollAttaque" data-item-id="{{arme.id}}">
                <i class="fas fa-dice-d10"></i>
              </button>
              <a class="item-edit" data-item-id="{{arme.id}}"><i class="fas fa-edit"></i></a>
              <a class="item-delete" data-item-id="{{arme.id}}"><i class="fas fa-trash"></i></a>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{/if}}

      <!-- Armures PNJ -->
      <div class="section-header">
        <h3>{{localize "AGONE.Armure.Label"}}</h3>
        <button type="button" class="item-create" data-type="armure"><i class="fas fa-plus"></i></button>
      </div>
      {{#if armures.length}}
      <ul>
        {{#each armures as |armure|}}
        <li class="item-row" data-item-id="{{armure.id}}">
          {{armure.name}} — PRO {{armure.system.protection}}
          <a class="item-edit" data-item-id="{{armure.id}}"><i class="fas fa-edit"></i></a>
          <a class="item-delete" data-item-id="{{armure.id}}"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ul>
      {{/if}}
    </div>

    <!-- NOTES -->
    <div class="tab" data-group="primary" data-tab="notes">
      <div class="editor-container">
        {{editor descriptionHTML target="system.description" button=true editable=owner}}
      </div>
    </div>
  </section>
</form>
