<form class="agone sheet actor compagnon" autocomplete="off">
  <header class="sheet-header">
    <div class="header-portrait">
      <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    </div>
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'AGONE.FeuilleCompagnon'}}" />
      </h1>
      <div class="header-row secondary-stats">
        <div class="stat-box">
          <label>{{localize "AGONE.PdV"}}</label>
          <input type="number" name="system.pdv.valeur" value="{{system.pdv.valeur}}" class="stat-num" />
          <span>/</span>
          <input type="number" name="system.pdv.max" value="{{system.pdv.max}}" class="stat-num" />
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.MV"}}</label>
          <input type="number" name="system.mv" value="{{system.mv}}" class="stat-num" />
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.VitesseVol"}}</label>
          <input type="number" name="system.mvVol" value="{{system.mvVol}}" class="stat-num" />
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.TAI"}}</label>
          <input type="number" name="system.tai" value="{{system.tai}}" class="stat-num" />
        </div>
        <div class="stat-box npc-text-box">
          <label>{{localize "AGONE.Espece"}}</label>
          <input type="text" name="system.espece" value="{{system.espece}}" class="stat-text" />
        </div>
      </div>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="attributs">{{localize "AGONE.Attributs"}}</a>
    <a class="item" data-tab="combat">{{localize "AGONE.Combat"}}</a>
    <a class="item" data-tab="notes">{{localize "AGONE.Notes"}}</a>
  </nav>

  <section class="sheet-body">

    <!-- ATTRIBUTS -->
    <div class="tab" data-group="primary" data-tab="attributs">
      <div class="npc-sheet-layout">

        <!-- Caracs + Stats dérivées -->
        <div class="npc-left-col">
          <div class="combat-card">
            <h3 class="combat-card-title"><i class="fas fa-fist-raised"></i> {{localize "AGONE.Caracteristiques"}}</h3>
            <div class="carac-grid npc-carac-grid">
              <div class="carac-row">
                <label>{{localize "AGONE.Attribut.Agilite"}}</label>
                <input type="number" name="system.agilite" value="{{system.agilite}}" class="stat-num" />
              </div>
              <div class="carac-row">
                <label>{{localize "AGONE.Attribut.Force"}}</label>
                <input type="number" name="system.force" value="{{system.force}}" class="stat-num" />
              </div>
              <div class="carac-row">
                <label>{{localize "AGONE.Attribut.Perception"}}</label>
                <input type="number" name="system.perception" value="{{system.perception}}" class="stat-num" />
              </div>
              <div class="carac-row">
                <label>{{localize "AGONE.Attribut.Resistance"}}</label>
                <input type="number" name="system.resistance" value="{{system.resistance}}" class="stat-num" />
              </div>
              <div class="carac-row">
                <label>{{localize "AGONE.ChargeMax"}}</label>
                <input type="number" name="system.chargeMax" value="{{system.chargeMax}}" class="stat-num" />
              </div>
            </div>
          </div>

          <div class="combat-card" style="margin-top:8px;">
            <h3 class="combat-card-title"><i class="fas fa-khanda"></i> {{localize "AGONE.StatsCombat"}}</h3>
            <div class="cstats-grid">
              <div class="cstat-item">
                <button type="button" class="cstat-roll" data-action="rollInitiative"
                        title='{{localize "AGONE.JeterInitiative"}}'><i class="fas fa-bolt"></i></button>
                <span class="cstat-score">{{system.initiative}}</span>
                <span class="cstat-label">{{localize "AGONE.Initiative"}}</span>
              </div>
              <div class="cstat-item">
                <span class="cstat-roll cstat-passive"><i class="fas fa-sword"></i></span>
                <span class="cstat-score">{{system.melee}}</span>
                <span class="cstat-label">{{localize "AGONE.Melee"}}</span>
              </div>
              <div class="cstat-item">
                <span class="cstat-roll cstat-passive"><i class="fas fa-weight-hanging"></i></span>
                <span class="cstat-score">{{system.demiCharge}}</span>
                <span class="cstat-label">{{localize "AGONE.DemiCharge"}}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Santé -->
        <div class="npc-right-col">
          <div class="combat-card sante-card">
            <h3 class="combat-card-title"><i class="fas fa-heartbeat"></i> {{localize "AGONE.EtatSante"}}</h3>
            <div class="pdv-bar-wrap">
              <div class="pdv-values">
                <span class="pdv-current">{{system.pdv.valeur}}</span>
                <span class="pdv-sep">/</span>
                <span class="pdv-max">{{system.pdv.max}}</span>
                <span class="pdv-label">PdV</span>
              </div>
              {{#if system.pdv.max}}
              <div class="pdv-track">
                <div class="pdv-fill" style="width:{{pdvPercent}}%;"></div>
              </div>
              {{/if}}
            </div>
            <div class="blessures-section">
              <div class="bg-row">
                <span class="bg-title">{{localize "AGONE.BlessuresGraves"}}</span>
                <label class="bg-cell {{#if system.blessureGrave1}}bg-active{{/if}}">
                  <input type="checkbox" name="system.blessureGrave1" {{#if system.blessureGrave1}}checked{{/if}} />
                  <span class="bg-dot">1</span><span class="bg-pen">−2</span>
                </label>
                <label class="bg-cell {{#if system.blessureGrave2}}bg-active{{/if}}">
                  <input type="checkbox" name="system.blessureGrave2" {{#if system.blessureGrave2}}checked{{/if}} />
                  <span class="bg-dot">2</span><span class="bg-pen">−6</span>
                </label>
                <label class="bg-cell {{#if system.blessureGrave3}}bg-active{{/if}}">
                  <input type="checkbox" name="system.blessureGrave3" {{#if system.blessureGrave3}}checked{{/if}} />
                  <span class="bg-dot">3</span><span class="bg-pen">−12</span>
                </label>
                {{#if system.malusBlessureGrave}}<span class="bg-total">{{system.malusBlessureGrave}}</span>{{/if}}
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- COMBAT -->
    <div class="tab" data-group="primary" data-tab="combat">
      <div class="section-header">
        <h3>{{localize "AGONE.Armes"}}</h3>
        {{#if isOwner}}
        <button type="button" class="item-create" data-type="arme">
          <i class="fas fa-plus"></i> {{localize "AGONE.AjouterArme"}}
        </button>
        {{/if}}
      </div>
      {{#if armes.length}}
      <table class="armes-table">
        <thead>
          <tr>
            <th class="col-arme-name">{{localize "AGONE.Nom"}}</th>
            <th>{{localize "AGONE.Attaque"}}</th>
            <th>{{localize "AGONE.Dommages"}}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each armes as |arme|}}
          <tr class="item-row" data-item-id="{{arme.id}}">
            <td class="col-arme-name">{{arme.name}}</td>
            <td><span class="arme-score">{{arme.system.attackTotal}}</span></td>
            <td><span class="dom-base">{{arme.system.dommages}}</span></td>
            <td class="col-row-actions">
              <button type="button" class="roll-btn-small roll-atk-btn" data-action="rollAttaque"
                      title="Attaque"><i class="fas fa-dice-d10"></i></button>
              {{#if ../isOwner}}
              <a class="item-edit"><i class="fas fa-edit"></i></a>
              <a class="item-delete"><i class="fas fa-trash"></i></a>
              {{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="npc-empty-hint">{{localize "AGONE.AucuneArme"}}</p>
      {{/if}}
    </div>

    <!-- NOTES -->
    <div class="tab" data-group="primary" data-tab="notes">
      <div class="editor-container">
        {{editor descriptionHTML target="system.description" button=true editable=owner}}
      </div>
    </div>

  </section>
</form>

      <div class="header-row secondary-stats">
        <div class="stat-box">
          <label>{{localize "AGONE.PdV"}}</label>
          <input type="number" name="system.pdv.valeur" value="{{system.pdv.valeur}}" class="stat-num" />
          <span>/</span>
          <input type="number" name="system.pdv.max" value="{{system.pdv.max}}" class="stat-num" />
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.BlessuresGraves"}}</label>
          <input type="number" name="system.blessuresGraves" value="{{system.blessuresGraves}}" class="stat-num" max="3" />
        </div>
      </div>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="infos">{{localize "AGONE.Caracteristiques"}}</a>
    <a class="item" data-tab="combat">{{localize "AGONE.Combat"}}</a>
  </nav>

  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="infos">
      <div class="carac-grid">
        <div class="carac-row">
          <label>{{localize "AGONE.Attribut.Agilite"}}</label>
          <input type="number" name="system.agilite" value="{{system.agilite}}" class="stat-num" />
        </div>
        <div class="carac-row">
          <label>{{localize "AGONE.Attribut.Force"}}</label>
          <input type="number" name="system.force" value="{{system.force}}" class="stat-num" />
        </div>
        <div class="carac-row">
          <label>{{localize "AGONE.Attribut.Perception"}}</label>
          <input type="number" name="system.perception" value="{{system.perception}}" class="stat-num" />
        </div>
        <div class="carac-row">
          <label>{{localize "AGONE.Attribut.Resistance"}}</label>
          <input type="number" name="system.resistance" value="{{system.resistance}}" class="stat-num" />
        </div>
        <div class="carac-row">
          <label>{{localize "AGONE.ChargeMax"}}</label>
          <input type="number" name="system.chargeMax" value="{{system.chargeMax}}" class="stat-num" />
        </div>
        <div class="carac-row">
          <label>{{localize "AGONE.Initiative"}}</label>
          <span class="derived-val">{{system.initiative}}</span>
          <button type="button" class="roll-btn-small" data-action="rollInitiative">
            <i class="fas fa-dice-d10"></i>
          </button>
        </div>
      </div>
    </div>

    <div class="tab" data-group="primary" data-tab="combat">
      <div class="section-header">
        <h3>{{localize "AGONE.Armes"}}</h3>
        <button type="button" class="item-create" data-type="arme"><i class="fas fa-plus"></i></button>
      </div>
      {{#if armes.length}}
      <table class="armes-table">
        <thead>
          <tr>
            <th>{{localize "AGONE.Nom"}}</th>
            <th>{{localize "AGONE.Dommages"}}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each armes as |arme|}}
          <tr class="item-row" data-item-id="{{arme.id}}">
            <td>{{arme.name}}</td>
            <td>{{arme.system.dommages}}</td>
            <td>
              <button type="button" class="roll-btn-small" data-action="rollAttaque" data-item-id="{{arme.id}}">
                <i class="fas fa-dice-d10"></i>
              </button>
              <a class="item-edit" data-item-id="{{arme.id}}"><i class="fas fa-edit"></i></a>
              <a class="item-delete" data-item-id="{{arme.id}}"><i class="fas fa-trash"></i></a>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{/if}}
    </div>
  </section>
</form>
