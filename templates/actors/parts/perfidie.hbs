<!-- PARTIAL : PEINES DE PERFIDIE -->
<div class="perfidie-section">

  <!-- ── Barre de stats ─────────────────────────────────────── -->
  <div class="perf-stats-bar">
    <div class="perf-stat-item">
      <label>{{localize "AGONE.Perfidie"}}</label>
      <input type="number" name="system.perfidie" value="{{system.perfidie}}" class="stat-num" min="0" />
    </div>
    <div class="perf-stat-separator"></div>
    <div class="perf-stat-item">
      <label>{{localize "AGONE.DifVolCorruption"}}</label>
      <span class="derived-val perf-dif-val">{{system.difVolCorruption}}</span>
    </div>
    <div class="perf-stat-separator"></div>
    <div class="perf-dif-legend">
      <span class="perf-dif-range {{#ifGT system.perfidie 0}}perf-range-active{{/ifGT}}">{{localize "AGONE.PerfidieRangeDif15"}}</span>
      <span class="perf-dif-range {{#ifGT system.perfidie 50}}perf-range-active{{/ifGT}}">{{localize "AGONE.PerfidieRangeDif20"}}</span>
      <span class="perf-dif-range {{#ifGT system.perfidie 75}}perf-range-active{{/ifGT}}">{{localize "AGONE.PerfidieRangeDif25"}}</span>
      <span class="perf-dif-range {{#ifGT system.perfidie 89}}perf-range-active{{/ifGT}}">{{localize "AGONE.PerfidieRangeDif30"}}</span>
    </div>
  </div>

  <!-- ── Corps principal ────────────────────────────────────── -->
  <div class="perf-content">

    <!-- Tableau des Peines acquises -->
    <div class="peines-perfidie-section">
      <div class="section-header">
        <h3 class="section-title">{{localize "AGONE.PeinesPerfidie"}}</h3>
        {{#if isOwner}}
        <button type="button" class="btn-icon compendium-browse" data-pack="agone.peines" title="{{localize "AGONE.OuvrirListePeines"}}">
          <i class="fas fa-search"></i>
        </button>
        {{/if}}
      </div>

      {{#if peines.length}}
      <table class="peines-table">
        <thead>
          <tr>
            <th class="item-drag-handle-col"></th>
            <th class="peine-col-desc"><button type="button" class="desc-bascule-tout" aria-expanded="false"><i class="fas fa-angles-down"></i></button></th>
            <th>{{localize "AGONE.NomPeine"}}</th>
            <th>{{localize "AGONE.NoirEffect"}}</th>
            <th>{{localize "AGONE.Bienfaits"}}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each peines as |peine|}}
          <tr class="peine-row item-row" data-item-id="{{peine.id}}">
            <td class="item-drag-handle"><i class="fas fa-grip-vertical"></i></td>
            <td class="peine-col-desc"><button type="button" class="desc-bascule" data-desc="{{peine.id}}" aria-expanded="false"><i class="fas fa-chevron-right"></i></button></td>
            <td class="peine-name"><a class="item-edit" data-item-id="{{peine.id}}" title='{{localize "AGONE.Peine.Modifier"}}'>{{peine.name}}</a></td>
            <td class="peine-noir">
              {{#if (eq peine.system.noirEffect "corps")}}
              <span class="pn-noir-badge pn-noir-corps" data-tooltip='{{localize "AGONE.PerfidieCorpsNoir1"}}'>{{localize "AGONE.Corps"}}</span>
              {{else if (eq peine.system.noirEffect "ame")}}
              <span class="pn-noir-badge pn-noir-ame" data-tooltip='{{localize "AGONE.PerfidieAmeNoire1"}}'>{{localize "AGONE.Ame"}}</span>
              {{else}}
              <span class="pn-noir-none">—</span>
              {{/if}}
            </td>
            <td class="peine-bienfait-cell">
              {{#if peine.system.bienfait}}
                {{#if peine.system.bienfaitAcquis}}
                  <span class="pn-bienfait-acquis" data-tooltip='{{localize "AGONE.PerfidieBienfaitAcquis" nom=peine.system.bienfait}}'>
                    <i class="fas fa-star"></i> {{peine.system.bienfait}}
                  </span>
                {{else if isOwner}}
                  <button type="button" class="pn-acquerir-btn" data-action="acquerirBienfait" data-item-id="{{peine.id}}"
                          data-tooltip='{{localize "AGONE.AcquerirBienfait"}} « {{peine.system.bienfait}} »'>
                    <i class="fas fa-unlock"></i> {{peine.system.bienfait}}
                  </button>
                {{else}}
                  <span class="pn-bienfait-dispo" data-tooltip='{{peine.system.bienfait}} {{localize "AGONE.PerfidieNonAcquis"}}'>  
                    <i class="fas fa-lock"></i> {{peine.system.bienfait}}
                  </span>
                {{/if}}
                {{#if peine._bienfaitDescription}}<i class="fas fa-info-circle pn-bienfait-info" data-tooltip="{{peine._bienfaitDescription}}" data-tooltip-class="agone-tooltip-texte"></i>{{/if}}
              {{else}}
                <span class="pn-bienfait-none">{{localize "AGONE.Aucun"}}</span>
              {{/if}}
            </td>
            <td class="peine-actions">
              <a class="item-edit" data-item-id="{{peine.id}}" title='{{localize "AGONE.Peine.Modifier"}}' tabindex="-1">
                <i class="fas fa-edit fa-xs"></i>
              </a>
              {{#if isOwner}}
              <a class="item-delete" data-item-id="{{peine.id}}" title='{{localize "AGONE.Supprimer"}}' tabindex="-1">
                <i class="fas fa-trash fa-xs"></i>
              </a>
              {{/if}}
            </td>
          </tr>
          <tr class="peine-desc-row desc-pliable" data-desc-de="{{peine.id}}" hidden>
            <td></td>
            <td></td>
            <td colspan="4" class="peine-desc-cell">
              {{> systems/agone/templates/apps/parts/peine-details.hbs
                  description=peine.system.description
                  noirEffectLabel=peine._noirEffectLabel
                  effetsPeine=peine._effetsPeine
                  bienfaitNom=peine.system.bienfait
                  bienfaitHTML=peine._bienfaitHTML
                  bienfaitEtatLabel=peine._bienfaitEtatLabel }}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="perf-empty">{{localize "AGONE.AucunePeinePerfidie"}}</p>
      {{/if}}
    </div>

    <!-- Bienfaits acquis -->
    {{#if bienfaitsActifsPerfidie.length}}
    <div class="bienfaits-perfidie-section desc-groupe">
      <h3 class="section-title">
        {{localize "AGONE.BienfaitsPerfidie"}}
        <button type="button" class="desc-bascule-tout" aria-expanded="false"><i class="fas fa-angles-down"></i></button>
      </h3>
      <ul class="bienfaits-perfidie-list">
        {{#each bienfaitsActifsPerfidie as |b|}}
        <li class="bienfait-perfidie-item">
          <div class="bienfait-perfidie-header">
            {{#if b.description}}<button type="button" class="desc-bascule" data-desc="bienfait:{{b.name}}" aria-expanded="false"><i class="fas fa-chevron-right"></i></button>{{else}}<span class="desc-bascule-vide"></span>{{/if}}
            <i class="fas fa-star pn-star-icon"></i>
            <strong>{{b.name}}</strong>
            <span class="bienfait-peines-src">({{b.sourceNames}})</span>
          </div>
          {{#if b.description}}
          <div class="bienfait-perfidie-desc desc-pliable" data-desc-de="bienfait:{{b.name}}" hidden>{{{b.description}}}</div>
          {{/if}}
        </li>
        {{/each}}
      </ul>
    </div>
    {{/if}}

  </div><!-- /.perf-content -->
</div><!-- /.perfidie-section -->
