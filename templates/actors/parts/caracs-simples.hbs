{{!-- Caractéristiques des compagnons, démons et PNJ, groupées par aspect.
      Contexte : caracGroups (caracsParAspect), caracExtras (champs complémentaires), showLevelUp. --}}
<div class="npc-caracs">
  {{#each caracGroups as |g|}}
  <div class="carac-aspect-group">
    <h4 class="carac-aspect-label">{{localize g.label}}</h4>
    {{#each g.caracs as |c|}}
    <div class="carac-row">
      <button type="button" class="roll-btn stat-label" data-action="rollAttribut" data-carac="{{c.key}}"
              data-tooltip='{{localize "AGONE.JeterDe"}} {{localize c.labelKey}}'>{{localize c.labelKey}}</button>
      {{#if c.derivee}}
      <span class="derived-val" data-tooltip="{{c.derivee}}">{{c.score}}</span>
      {{else}}
      <input type="number" name="system.{{c.key}}" value="{{c.score}}" class="stat-num" min="0" />
      {{#if c.bonus}}
      <span class="racial-bonus-badge {{#if (gt c.bonus 0)}}racial-pos{{else}}racial-neg{{/if}}"
            data-tooltip='{{localize "AGONE.Effets.Titre"}}'>{{#if (gt c.bonus 0)}}+{{/if}}{{c.bonus}}</span>
      <span class="derived-val carac-total-val">{{c.total}}</span>
      {{/if}}
      {{/if}}
      {{#if c.expField}}{{#if @root.showLevelUp}}
      <input type="number" name="system.{{c.expField}}" value="{{c.localExp}}" class="stat-num exp" min="0"
             data-tooltip='{{c.shortLabel}} — {{localize "AGONE.ExpReservee"}}' />
      <button type="button" class="leveldown-btn" data-action="levelDownCaracDemon"
              data-key="{{c.key}}" data-exp-field="{{c.expField}}" data-label="{{c.shortLabel}}"
              {{#unless c.canDown}}disabled{{/unless}}
              data-tooltip='{{localize "AGONE.RetrograderCaracXP" stat=c.shortLabel cout=c.coutDown}}'
              aria-label='{{localize "AGONE.RetrograderCaracXP" stat=c.shortLabel cout=c.coutDown}}'>
        <i class="fas fa-arrow-down"></i>
      </button>
      <button type="button" class="levelup-btn" data-action="levelUpCaracDemon"
              data-key="{{c.key}}" data-exp-field="{{c.expField}}" data-label="{{c.shortLabel}}"
              {{#unless c.canUp}}disabled{{/unless}}
              data-tooltip='{{localize "AGONE.MonterCaracXP" stat=c.shortLabel cout=c.cout}}'>
        <i class="fas fa-arrow-up"></i> {{c.cout}}
      </button>
      {{/if}}{{/if}}
    </div>
    {{/each}}
  </div>
  {{/each}}

  {{#if caracExtras.length}}
  <div class="carac-extras">
    {{#each caracExtras as |x|}}
    <div class="carac-row">
      <label class="stat-label">{{localize x.labelKey}}</label>
      <input type="number" name="system.{{x.key}}" value="{{x.value}}" class="stat-num" />
    </div>
    {{/each}}
  </div>
  {{/if}}
</div>
