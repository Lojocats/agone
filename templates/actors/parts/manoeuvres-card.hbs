<!-- PARTIAL : MANŒUVRES & BOTTES (fiche personnage et acteurs simples) -->
<div class="combat-card manoeuvres-card">
  <div class="combat-card-header">
    <h3 class="combat-card-title"><i class="fas fa-fist-raised"></i> {{localize "AGONE.Manoeuvres"}}</h3>
    <div class="card-btns">
      <button type="button" class="compendium-browse btn-icon" data-pack="agone.manoeuvres" data-tooltip='{{localize "AGONE.ParcourirManoeuvres"}}' aria-label='{{localize "AGONE.ParcourirManoeuvres"}}'><i class="fas fa-search"></i></button>
      <button type="button" class="item-create btn-icon" data-type="manoeuvre" data-tooltip='{{localize "AGONE.AjouterManoeuvre"}}' aria-label='{{localize "AGONE.AjouterManoeuvre"}}'><i class="fas fa-plus"></i></button>
    </div>
  </div>
  {{#if manoeuvres.length}}
  <table class="manoeuvres-table">
    <thead>
      <tr>
        <th class="man-col-toggle"><button type="button" class="desc-bascule-tout" aria-expanded="false" aria-label="{{localize 'AGONE.DescriptionsToutes'}}"><i class="fas fa-angles-down"></i></button></th>
        <th class="man-col-name">{{localize "AGONE.Nom"}}</th>
        <th class="man-col-num" data-tooltip='{{localize "AGONE.Combat.ModInit"}}'>INI</th>
        <th class="man-col-num" data-tooltip='{{localize "AGONE.Combat.ModAtt"}}'>ATT</th>
        <th class="man-col-num" data-tooltip='{{localize "AGONE.Combat.ModDef"}}'>DEF</th>
        <th class="man-col-dom" data-tooltip='{{localize "AGONE.Dommages"}}'>DOM</th>
        <th class="man-col-actions"></th>
        <th class="col-drag"></th>
      </tr>
    </thead>
    <tbody>
      {{#each manoeuvres as |man|}}
      <tr class="item-row man-row" data-item-id="{{man.id}}">
        <td class="man-col-toggle">{{#if man.system.description}}<button type="button" class="desc-bascule" data-desc="{{man.id}}" aria-expanded="false" aria-label="{{localize 'AGONE.VoirDescription'}}"><i class="fas fa-chevron-right"></i></button>{{/if}}</td>
        <td class="man-col-name">
          <div class="man-name-line">
            <span class="man-badge man-badge-{{man.system.categorie}}">
              {{#if (eq man.system.categorie "botte")}}{{localize "AGONE.Botte"}}{{else}}{{localize "AGONE.Ui.ManoeuvreAbr"}}{{/if}}
            </span>
            <button type="button" class="roll-btn item-name" data-action="rollManoeuvre" data-item-id="{{man.id}}">
              {{man.name}}
            </button>
          </div>
          {{#if man.system.condition}}
          <div class="man-condition">{{man.system.condition}}</div>
          {{/if}}
        </td>
        <td class="man-col-num">
          <span class="man-val {{#if (eq man.system.ini null)}}man-val-var{{else if (gt man.system.ini 0)}}man-val-pos{{else if (lt man.system.ini 0)}}man-val-neg{{else}}man-val-zero{{/if}}">
            {{#if (eq man.system.ini null)}}{{localize "AGONE.Browser.Var"}}{{else if (gt man.system.ini 0)}}+{{man.system.ini}}{{else if (lt man.system.ini 0)}}{{man.system.ini}}{{else}}0{{/if}}
          </span>
        </td>
        <td class="man-col-num">
          <span class="man-val {{#if (eq man.system.att null)}}man-val-var{{else if (gt man.system.att 0)}}man-val-pos{{else if (lt man.system.att 0)}}man-val-neg{{else}}man-val-zero{{/if}}">
            {{#if (eq man.system.att null)}}{{localize "AGONE.Browser.Var"}}{{else if (gt man.system.att 0)}}+{{man.system.att}}{{else if (lt man.system.att 0)}}{{man.system.att}}{{else}}0{{/if}}
          </span>
        </td>
        <td class="man-col-num">
          <span class="man-val {{#if (eq man.system.def null)}}man-val-var{{else if (gt man.system.def 0)}}man-val-pos{{else if (lt man.system.def 0)}}man-val-neg{{else}}man-val-zero{{/if}}">
            {{#if (eq man.system.def null)}}{{localize "AGONE.Browser.Var"}}{{else if (gt man.system.def 0)}}+{{man.system.def}}{{else if (lt man.system.def 0)}}{{man.system.def}}{{else}}0{{/if}}
          </span>
        </td>
        <td class="man-col-dom">
          <span class="man-dom">{{#if man.system.dom}}{{man.system.dom}}{{else}}—{{/if}}</span>
        </td>
        <td class="man-col-actions">
          <a class="item-edit" data-item-id="{{man.id}}" data-tooltip='{{localize "AGONE.Editer"}}' role="button" tabindex="0" aria-label='{{localize "AGONE.Editer"}}'><i class="fas fa-edit"></i></a>
          <a class="item-delete" data-item-id="{{man.id}}" data-tooltip='{{localize "AGONE.Supprimer"}}' role="button" tabindex="0" aria-label='{{localize "AGONE.Supprimer"}}'><i class="fas fa-trash"></i></a>
        </td>
        <td class="col-drag"><span class="item-drag-handle" data-tooltip='{{localize "AGONE.Deplacer"}}'><i class="fas fa-grip-vertical"></i></span></td>
      </tr>
      {{#if man.system.description}}
      <tr class="man-desc-row desc-pliable" data-desc-de="{{man.id}}" hidden>
        <td></td>
        <td colspan="7" class="man-desc-cell">
          <div class="item-desc-content">{{{man.system.description}}}</div>
        </td>
      </tr>
      {{/if}}
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="empty-list">{{localize "AGONE.AucuneManoeuvre"}}</p>
  {{/if}}
</div>
