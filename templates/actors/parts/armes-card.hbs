<!-- PARTIAL : ARMES (fiche personnage et acteurs simples) -->
<div class="combat-card armes-card">
  <div class="combat-card-header">
    <h3 class="combat-card-title"><i class="fas fa-khanda"></i> {{localize "AGONE.Armes"}}</h3>
    <div class="card-btns">
      <button type="button" class="compendium-browse btn-icon" data-pack="agone.armes" data-tooltip='{{localize "AGONE.ParcourirArmes"}}' aria-label='{{localize "AGONE.ParcourirArmes"}}'><i class="fas fa-search"></i></button>
      <button type="button" class="item-create btn-icon" data-type="arme" data-tooltip='{{localize "AGONE.AjouterArme"}}' aria-label='{{localize "AGONE.AjouterArme"}}'><i class="fas fa-plus"></i></button>
    </div>
  </div>
  {{#if armes.length}}
  <table class="armes-table">
    <thead>
      <tr>
        <th class="col-equipe" data-tooltip="{{localize 'AGONE.Equipe'}}"><i class="fas fa-hand-paper"></i></th>
        <th class="col-arme-name">{{localize "AGONE.Nom"}}</th>
        <th class="col-tai">{{localize "AGONE.TAI"}}</th>
        <th class="col-type">{{localize "AGONE.Type"}}</th>
        <th class="col-init"><i class="fas fa-bolt"></i> {{localize "AGONE.Combat.Init"}}</th>
        <th class="col-atk"><i class="fas fa-dice-d10"></i> {{localize "AGONE.Combat.Atk"}}</th>
        <th class="col-def"><i class="fas fa-shield-alt"></i> {{localize "AGONE.Combat.Def"}}</th>
        <th class="col-dom">{{localize "AGONE.Combat.Dom"}}</th>
        <th class="col-row-actions"></th>
      </tr>
    </thead>
    <tbody>
      {{#each armes as |arme|}}
      <tr class="item-row {{#if arme.system.equipe}}arme-equipee{{/if}}" data-item-id="{{arme.id}}">
        <td class="col-equipe">
          <label class="arme-equipe-toggle" data-tooltip="{{#if arme.system.equipe}}{{localize "AGONE.Equipee"}}{{else}}{{localize "AGONE.Rangee"}}{{/if}}">
            <input type="checkbox" class="arme-equipe" data-item-id="{{arme.id}}" {{#if arme.system.equipe}}checked{{/if}}
                   aria-label="{{#if arme.system.equipe}}{{localize "AGONE.Equipee"}}{{else}}{{localize "AGONE.Rangee"}}{{/if}}" />
            <i class="fas {{#if (eq arme.system.style 'bouclier')}}fa-shield{{else}}fa-hand-paper{{/if}} arme-equipe-icon"></i>
          </label>
        </td>
        <td class="col-arme-name">
          <span class="roll-btn item-name" data-action="rollItemChat" data-item-id="{{arme.id}}">{{arme.name}}</span>
          {{#if (eq arme.system.style "bouclier")}}
          <span class="armure-badge pro-badge">{{localize "AGONE.Combat.Pro"}} {{arme.system.protection}}</span>
          {{#if arme.system.malusAgi}}<span class="armure-badge malus-badge">{{localize "AGONE.Combat.MalusAgi"}} {{arme.system.malusAgi}}</span>{{/if}}
          {{/if}}
        </td>
        <td class="col-tai">{{arme.system.tai}}</td>
        <td class="col-type">{{#if (eq arme.system.style "bouclier")}}<i class="fas fa-shield-alt" data-tooltip='{{localize "AGONE.Bouclier"}}'></i>{{else}}{{arme.system.type}}{{/if}}</td>
        <td class="col-init">
          {{#if (eq arme.system.style "bouclier")}}
          <span class="arme-score arme-score-inactive">—</span>
          {{else}}
          <div class="arme-cell">
            <span class="arme-score">{{arme.system.initTotal}}</span>
            <button type="button" class="roll-btn-small roll-init-btn" data-action="rollInitiative" data-item-id="{{arme.id}}" data-tooltip='{{localize "AGONE.JeterInitiative"}}' aria-label='{{localize "AGONE.JeterInitiative"}}'><i class="fas fa-bolt"></i></button>
          </div>
          {{/if}}
        </td>
        <td class="col-atk">
          {{#if (eq arme.system.style "bouclier")}}
          <span class="arme-score arme-score-inactive">—</span>
          {{else}}
          <div class="arme-cell">
            <span class="arme-score">{{arme.system.attackTotal}}</span>
            <button type="button" class="roll-btn-small roll-atk-btn" data-action="rollAttaque" data-item-id="{{arme.id}}" data-tooltip='{{localize "AGONE.JeterAttaque"}}' aria-label='{{localize "AGONE.JeterAttaque"}}'><i class="fas fa-dice-d10"></i></button>
          </div>
          {{/if}}
        </td>
        <td class="col-def">
          <div class="arme-cell">
            <span class="arme-score">{{arme.system.defenseTotal}}</span>
            <button type="button" class="roll-btn-small roll-def-btn" data-action="rollParade" data-item-id="{{arme.id}}" data-tooltip='{{localize "AGONE.JeterParade"}}' aria-label='{{localize "AGONE.JeterParade"}}'><i class="fas fa-shield-alt"></i></button>
          </div>
        </td>
        <td class="col-dom">
          {{#if (eq arme.system.style "bouclier")}}
          <span class="arme-score arme-score-inactive">—</span>
          {{else}}
          <span class="dom-base">{{arme.system.dommages}}</span>
          {{#if @root.system.bd}}<span class="dom-bd">+{{@root.system.bd}}</span>{{/if}}
          {{/if}}
        </td>
        <td class="col-row-actions">
          <a class="item-edit" data-item-id="{{arme.id}}" data-tooltip='{{localize "AGONE.Editer"}}' role="button" tabindex="0" aria-label='{{localize "AGONE.Editer"}}'><i class="fas fa-pen"></i></a>
          <a class="item-delete" data-item-id="{{arme.id}}" data-tooltip='{{localize "AGONE.Supprimer"}}' role="button" tabindex="0" aria-label='{{localize "AGONE.Supprimer"}}'><i class="fas fa-trash"></i></a>
          <span class="item-drag-handle" data-tooltip='{{localize "AGONE.Deplacer"}}'><i class="fas fa-grip-vertical"></i></span>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="empty-list">{{localize "AGONE.AucuneArme"}}</p>
  {{/if}}
</div>
