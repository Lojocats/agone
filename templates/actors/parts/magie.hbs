<!-- PARTIAL : MAGIE -->
<div class="magie-section">

  <!-- Aptitudes magiques -->
  <div class="aptitudes-block">
    <h3 class="section-title">{{localize "AGONE.AptitudesMagiques"}}</h3>

    <!-- Arts Magiques par domaine -->
    {{#if artsMagiquesByDomaine.length}}
    <table class="arts-domaines-table">
      <thead>
        <tr>
          <th>{{localize "AGONE.Domaine"}}</th>
          <th class="col-score">{{localize "AGONE.Score"}}</th>
          <th class="col-apt">{{localize "AGONE.Potentiel"}}</th>
          <th class="col-apt">{{localize "AGONE.Improvisation"}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each artsMagiquesByDomaine as |d|}}
        <tr class="item-row {{#unless d.comp}}arts-absent{{/unless}}" {{#if d.comp}}data-item-id="{{d.comp.id}}"{{/if}}>
          <td>
            {{#if d.comp}}
            <span class="roll-btn item-name" data-action="rollCompetence" data-item-id="{{d.comp.id}}">{{d.domaine}}</span>
            {{else}}
            <span class="arts-domaine-absent">{{d.domaine}}</span>
            {{/if}}
          </td>
          <td class="col-score">
            {{#if d.comp}}
            <span class="arts-scores-pair">
              <span title="Score Arts Magiques">{{d.comp.system.score}}</span>
              <span class="arts-comp-liee-score {{#unless d.compLiee}}arts-comp-liee-manquante{{/unless}}"
                    title="{{d.nomCompLiee}}{{#unless d.compLiee}} (non possédée){{/unless}}">
                / {{d.scoreCompLiee}} <em class="arts-comp-liee-nom">{{d.nomCompLiee}}</em>
              </span>
            </span>
            {{#if ../showLevelUpComp}}
            <div class="arts-levelup-pair">
              <button type="button" class="levelup-btn" data-action="levelUp"
                      data-type="competence" data-item-id="{{d.comp.id}}" data-cout="{{d.comp.xpCout}}" data-crea-cout="{{d.comp.creaCout}}"
                      title='{{localize "AGONE.MonterNiveau"}} Arts Magiques ({{d.comp.coutAffiche}})'>
                <i class="fas fa-arrow-up"></i> Arts ({{d.comp.coutAffiche}})
              </button>
              <button type="button" class="leveldown-btn" data-action="levelDown"
                      data-type="competence" data-item-id="{{d.comp.id}}"
                      title='{{localize "AGONE.RetrograderNiveau"}}'
                      {{#unless d.comp.system.score}}disabled{{/unless}}>
                <i class="fas fa-arrow-down"></i> {{d.comp.coutAfficheDown}}
              </button>
              {{#if d.compLiee}}
              <button type="button" class="levelup-btn levelup-btn-liee" data-action="levelUp"
                      data-type="competence" data-item-id="{{d.compLiee.id}}" data-cout="{{d.compLiee.xpCout}}" data-crea-cout="{{d.compLiee.creaCout}}"
                      title='{{localize "AGONE.MonterNiveau"}} {{d.nomCompLiee}} ({{d.compLiee.coutAffiche}})'>
                <i class="fas fa-arrow-up"></i> {{d.nomCompLiee}} ({{d.compLiee.coutAffiche}})
              </button>
              <button type="button" class="leveldown-btn" data-action="levelDown"
                      data-type="competence" data-item-id="{{d.compLiee.id}}"
                      title='{{localize "AGONE.RetrograderNiveau"}}'
                      {{#unless d.compLiee.system.score}}disabled{{/unless}}>
                <i class="fas fa-arrow-down"></i> {{d.compLiee.coutAfficheDown}}
              </button>
              {{else}}
              <span class="arts-comp-liee-manquante arts-levelup-absent" title="{{d.nomCompLiee}} non possédée">
                <i class="fas fa-arrow-up"></i> {{d.nomCompLiee}} —
              </span>
              {{/if}}
            </div>
            {{/if}}
            {{else}}—{{/if}}
          </td>
          <td class="col-apt">
            {{#if d.comp}}
            <span class="arts-apt-val">{{d.potentiel}}</span>
            {{#if d.specialite}}<span class="arts-spe-hint">★ {{d.specialite}}</span>{{/if}}
            <button type="button" class="roll-btn-small" data-action="rollArtDomaine"
                    data-domaine="{{d.domaine}}" data-apt="{{d.potentiel}}" data-specialite="{{d.specialite}}"
                    data-art="{{d.artVal}}" data-score-arts="{{d.scoreArtsMag}}"
                    data-score-comp="{{d.scoreCompLiee}}" data-nom-comp="{{d.nomCompLiee}}"
                    data-score-eff="{{d.scoreEffectif}}" data-bonus-ame="{{d.bonusAmeVal}}"
                    title='{{localize "AGONE.JeterAptitudeMagie"}} &mdash; {{d.domaine}}'>
              <i class="fas fa-dice-d10"></i>
            </button>
            {{else}}&mdash;{{/if}}
          </td>
          <td class="col-apt">
            {{#if d.comp}}
            <span class="arts-apt-val">{{d.impro}}</span>
            {{#if d.specialite}}<span class="arts-spe-hint">★ {{d.specialite}}</span>{{/if}}
            <button type="button" class="roll-btn-small" data-action="rollImpArtDomaine"
                    data-domaine="{{d.domaine}}" data-apt="{{d.impro}}" data-specialite="{{d.specialite}}"
                    data-cre="{{d.creVal}}" data-score-arts="{{d.scoreArtsMag}}"
                    data-score-comp="{{d.scoreCompLiee}}" data-nom-comp="{{d.nomCompLiee}}"
                    data-score-eff="{{d.scoreEffectif}}" data-bonus-ame="{{d.bonusAmeVal}}"
                    title='{{localize "AGONE.JeterImprovisation"}} &mdash; {{d.domaine}}'>
              <i class="fas fa-dice-d10"></i>
            </button>
            {{else}}&mdash;{{/if}}
          </td>
          <td>
            {{#if d.comp}}<a class="item-edit" data-item-id="{{d.comp.id}}"><i class="fas fa-edit"></i></a>{{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}
  </div>

  <div class="magie-main">
  <!-- Sorts -->
  <div class="sorts-block">
    <div class="section-header">
      <h3>{{localize "AGONE.Sorts"}}</h3>
      <button type="button" class="compendium-browse btn-icon" data-pack="agone.sorts" title='{{localize "AGONE.ParcourirSorts"}}'>
        <i class="fas fa-search"></i>
      </button>
      <button type="button" class="item-create" data-type="sort" title='{{localize "AGONE.AjouterSort"}}'>
        <i class="fas fa-plus"></i>
      </button>
      <button type="button" class="btn-icon tri-toggle-btn" data-action="triSortsToggle"
              title='{{#if triSortsEstType}}{{localize "AGONE.TrierParSeuil"}}{{else}}{{localize "AGONE.TrierParType"}}{{/if}}'>
        <i class="fas fa-sort"></i> {{#if triSortsEstType}}{{localize "AGONE.Type"}}{{else}}{{localize "AGONE.Seuil"}}{{/if}}
      </button>
    </div>

    <!-- Références de portée & MQ -->
    <div class="portees-ref">
      <div class="portees-ref-cols">
        <div class="portees-ref-section">
          <div class="portees-ref-title">{{localize "AGONE.MagiePorteesTitre"}}</div>
          <div class="portee-ref-row">
            <span class="portee-ref-label">{{localize "AGONE.MagiePorteePersonnel"}}</span>
            <span class="portee-ref-desc">{{localize "AGONE.MagiePorteePersonnelDesc"}}</span>
          </div>
          <div class="portee-ref-row">
            <span class="portee-ref-label">{{localize "AGONE.MagiePorteeContact"}}</span>
            <span class="portee-ref-desc">{{localize "AGONE.MagiePorteeContactDesc"}}</span>
          </div>
          <div class="portee-ref-row">
            <span class="portee-ref-label">{{localize "AGONE.MagiePorteeRegard"}}</span>
            <span class="portee-ref-desc">{{localize "AGONE.MagiePorteeRegardDesc"}}</span>
          </div>
          <div class="portee-ref-row">
            <span class="portee-ref-label">{{localize "AGONE.MagiePorteeVue"}}</span>
            <span class="portee-ref-desc">{{localize "AGONE.MagiePorteeVueDesc"}}</span>
          </div>
          <div class="portee-ref-row">
            <span class="portee-ref-label">{{localize "AGONE.MagiePorteeSpecial"}}</span>
            <span class="portee-ref-desc">{{localize "AGONE.MagiePorteeSpecialDesc"}}</span>
          </div>
        </div>
        <div class="portees-ref-section">
          <div class="portees-ref-title">🎲 Marge de qualité</div>
          <div class="portee-ref-row">
            <span class="portee-ref-label mq-label">MQ 0</span>
            <span class="portee-ref-desc">Aucune marge — effet de base</span>
          </div>
          <div class="portee-ref-row">
            <span class="portee-ref-label mq-label">MQ +1 à +4</span>
            <span class="portee-ref-desc">x 2</span>
          </div>
          <div class="portee-ref-row">
            <span class="portee-ref-label mq-label">MQ +5 à +9</span>
            <span class="portee-ref-desc">x 5</span>
          </div>
          <div class="portee-ref-row">
            <span class="portee-ref-label mq-label">MQ +10 à +15</span>
            <span class="portee-ref-desc">x 10</span>
          </div>
          <div class="portee-ref-row">
            <span class="portee-ref-label mq-label">MQ +16 à +20</span>
            <span class="portee-ref-desc">x 30</span>
          </div>
          <div class="portee-ref-row">
            <span class="portee-ref-label mq-label">MQ +21 et plus</span>
            <span class="portee-ref-desc">x 100</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Mini-filtre sorts -->
    <div class="sorts-mini-filter">
      <div class="smf-search-wrap">
        <i class="fas fa-search"></i>
        <input type="text" class="smf-search" placeholder='{{localize "AGONE.MagieFiltrerSorts"}}'>
      </div>
      {{#if sortTypes.length}}
      <div class="smf-checks">
        {{#each sortTypes as |t|}}
        <label class="smf-lbl">
          <input type="checkbox" class="smf-check" value="{{t.value}}"> {{t.label}}
        </label>
        {{/each}}
      </div>
      {{/if}}
    </div>

    {{#if sorts.length}}
    <div class="sorts-groups-container">
      {{#each sortsGroups as |group|}}
      <div class="sort-group" data-key="{{group.label}}">
        <div class="sort-group-header">
          <span class="sort-seuil-badge">{{group.label}}</span>
          <span class="sort-group-count">{{group.sorts.length}}</span>
        </div>
        <div class="sorts-cards-container">
          {{#each group.sorts as |sort|}}
          <div class="sort-card item-row" data-item-id="{{sort.id}}" draggable="true">
            <div class="sort-card-top">
              {{#if sort.system.description}}
              <button type="button" class="sort-desc-toggle btn-icon" data-action="toggleSortDesc"
                      data-item-id="{{sort.id}}" title="Description">
                <i class="fas fa-chevron-right sort-toggle-icon"></i>
              </button>
              {{/if}}
              <button type="button" class="roll-btn sort-card-name item-name" data-action="rollSort"
                      data-item-id="{{sort.id}}">{{sort.name}}</button>
            </div>
            <div>
              {{#if sort.system.typeMagie}}<span class="sort-type-badge">{{sort.system.typeMagie}}</span>{{/if}}
              {{#if sort.system.instrument}}<span class="sort-type-badge">{{sort.system.instrument}}</span>{{/if}}
              {{#if sort.system.seuil}}<span class="sort-type-badge">seuil {{sort.system.seuil}}</span>{{/if}}
            </div>
            <div class="sort-card-stats">
              {{#if sort.system.portee}}<span class="sort-stat"><em>Portée</em> {{sort.system.portee}}</span>{{/if}}
              {{#if sort.system.duree}}<span class="sort-stat"><em>Durée</em> {{sort.system.duree}}</span>{{/if}}
              {{#if sort.system.danse}}<span class="sort-stat"><em>Lancer</em> {{sort.system.danse}}</span>{{/if}}
            </div>
            {{#if sort.system.description}}
            <div class="sort-desc-panel" style="display:none">{{{sort.system.description}}}</div>
            {{/if}}
            <div class="sort-card-actions">
              <a class="item-edit" data-item-id="{{sort.id}}" title='{{localize "AGONE.Editer"}}'><i class="fas fa-edit"></i></a>
              <a class="item-delete" data-item-id="{{sort.id}}" title='{{localize "AGONE.Supprimer"}}'><i class="fas fa-trash"></i></a>
              <span class="sort-card-drag-handle" title='{{localize "AGONE.Deplacer"}}'><i class="fas fa-grip-vertical"></i></span>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="empty-list">{{localize "AGONE.AucunSort"}}</p>
    {{/if}}
  </div>

  <!-- Danseurs -->
  <div class="danseurs-block">
    <div class="section-header">
      <h3>{{localize "AGONE.Danseurs"}}</h3>
      <button type="button" class="item-create" data-type="danseur" title='{{localize "AGONE.NouveauDanseur"}}'>
        <i class="fas fa-plus"></i>
      </button>
    </div>
    {{#if danseurs.length}}
    {{#each danseurs as |d|}}
    <div class="danseur-card item-row" data-item-id="{{d.id}}">
      <!-- HEADER : nom + stats + actions -->
      <div class="danseur-header">
        <div class="danseur-info">
          <span class="danseur-nom">{{d.name}}</span>
          {{#if d.system.modeCreation}}
          <span class="danseur-pts-badge {{#if (lt d.system.ptsCreationRestants 0)}}pts-deficit{{/if}}">
            {{d.system.ptsCreationDepense}}/{{d.system.ptsCreationMax}} pts
          </span>
          {{else}}
          <span class="danseur-stat danseur-mem {{#if d.isFull}}mem-full{{/if}}" title="Mémoire">Mém : {{d.assignedCount}}/{{d.system.memoireMax}}</span>
          <span class="danseur-stat" title="Endurance">End :
            <input class="danseur-inline-num" type="number" data-item-id="{{d.id}}" data-field="enduranceActuelle" value="{{d.system.enduranceActuelle}}" min="0">
            /{{d.system.enduranceMax}}
          </span>
          <span class="danseur-stat" title="Bonus d'Emprise">EMP+{{d.system.bonusEmprise}}</span>
          <span class="danseur-stat" title="Empathie">Emp {{d.system.empathie}}</span>

          {{/if}}
        </div>
        <div class="danseur-actions">
          {{#unless d.system.modeCreation}}
          <button type="button" class="danseur-roll-btn" data-action="rollEmprise" data-item-id="{{d.id}}" title='{{localize "AGONE.JeterEmprise"}}'>
            <i class="fas fa-dice-d10"></i> Emprise
          </button>
          <button type="button" class="danseur-roll-btn" data-action="rollImprovisation" data-item-id="{{d.id}}" title='{{localize "AGONE.JeterImprovisation"}}'>
            <i class="fas fa-dice-d10"></i> Impro
          </button>
          <button type="button" class="danseur-recrea-btn btn-icon" data-action="reactiverCreationDanseur" data-item-id="{{d.id}}" title='{{localize "AGONE.DanseurReactiverCrea"}}'>
            <i class="fas fa-table"></i>
          </button>
          {{else}}
          <button type="button" class="danseur-valider-btn" data-action="validerCreationDanseur" data-item-id="{{d.id}}" title='{{localize "AGONE.DanseurValiderCrea"}}'>
            <i class="fas fa-check"></i> Valider
          </button>
          {{/unless}}
          <a class="item-delete" data-item-id="{{d.id}}" title="Supprimer"><i class="fas fa-trash"></i></a>
        </div>
      </div>

      {{#if d.system.modeCreation}}
      <!-- MODE CRÉATION : table officielle +/- niveaux -->
      <div class="danseur-crea-section">
        {{#each d.creaNiveaux as |cn|}}
        <div class="danseur-crea-row">
          <span class="danseur-crea-label">{{cn.label}}</span>
          <button type="button" class="danseur-niv-btn" data-action="danseurNiveauDown"
                  data-item-id="{{d.id}}" data-stat="{{cn.nivField}}"
                  {{#unless cn.canDown}}disabled{{/unless}}>-</button>
          <span class="danseur-niv-num">{{cn.niv}}</span>
          <button type="button" class="danseur-niv-btn" data-action="danseurNiveauUp"
                  data-item-id="{{d.id}}" data-stat="{{cn.nivField}}"
                  {{#unless cn.canUp}}disabled{{/unless}}>+</button>
          <span class="danseur-crea-arrow">&#8594;</span>
          <span class="danseur-crea-val">{{cn.prefix}}{{cn.val}}</span>
          {{#if cn.nextVal}}<span class="danseur-next-val">(niv.{{cn.nextNiv}} &#8594; {{cn.prefix}}{{cn.nextVal}})</span>{{/if}}
        </div>
        {{/each}}
      </div>
      {{else}}
      {{/if}}

      <!-- SORTS mémorisés (toujours visible) -->
      <div class="danseur-slots" data-danseur-id="{{d.id}}">
        {{#each d.assignedSorts as |s|}}
        <div class="danseur-slot-sort" data-sort-id="{{s.id}}">
          <div class="slot-main">
            <button type="button" class="slot-name" data-action="rollSortDanseur"
                    data-sort-id="{{s.id}}" data-danseur-id="{{d.id}}"
                    title="Lancer {{s.name}} (End. {{../system.enduranceActuelle}}/{{../system.enduranceMax}})">{{s.name}}</button>
            <button type="button" class="slot-remove" data-sort-id="{{s.id}}" title="Retirer">x</button>
          </div>
          <div class="slot-meta">
            {{#if s.seuil}}<span>Seuil : {{s.seuil}}</span>{{/if}}
            {{#if s.portee}}<span>Portée : {{s.portee}}</span>{{/if}}
            {{#if s.duree}}<span>Durée : {{s.duree}}</span>{{/if}}
            {{#if s.danse}}<span>Incant. : {{s.danse}}</span>{{/if}}
          </div>
        </div>
        {{/each}}
        {{#unless d.isFull}}
        <div class="danseur-drop-hint"><i class="fas fa-arrow-down"></i> Glisser un sort ici</div>
        {{/unless}}
      </div>
    </div>
    {{/each}}
    {{else}}
    <p class="empty-list">{{localize "AGONE.AucunDanseur"}}</p>
    {{/if}}
  </div><!-- /danseurs-block -->
  </div><!-- /magie-main -->

  <!-- Pouvoirs de la Flamme / Saisonins -->
  <div class="pouvoirs-block">
    <div class="section-header">
      <h3>{{localize "AGONE.PouvoirsFlamme"}}</h3>
      <button type="button" class="compendium-browse btn-icon" data-pack="agone.pouvoirs" title='{{localize "AGONE.ParcourirPouvoirs"}}'>
        <i class="fas fa-search"></i>
      </button>
      <button type="button" class="item-create" data-type="pouvoir">
        <i class="fas fa-plus"></i>
      </button>
    </div>

    {{#if pouvoirs.length}}
    <ul class="pouvoirs-list">
      {{#each pouvoirs as |pouvoir|}}
      <li class="pouvoir-row item-row" data-item-id="{{pouvoir.id}}">
        {{#if pouvoir.system.description}}
        <button type="button" class="pouvoir-desc-toggle btn-icon" data-item-id="{{pouvoir.id}}" title="Description">
          <i class="fas fa-chevron-right pouvoir-toggle-icon"></i>
        </button>
        {{else}}
        <span style="width:14px;display:inline-block"></span>
        {{/if}}
        <span class="pouvoir-categorie tag-{{pouvoir.system.categorie}}">{{pouvoir.system.categorie}}</span>
        <button type="button" class="pouvoir-name-btn btn-text" data-action="chatPouvoir" data-item-id="{{pouvoir.id}}" title='Envoyer dans le chat'>{{pouvoir.name}}</button>
        <a class="item-edit" data-item-id="{{pouvoir.id}}"><i class="fas fa-edit"></i></a>
        <a class="item-delete" data-item-id="{{pouvoir.id}}"><i class="fas fa-trash"></i></a>
      </li>
      {{#if pouvoir.system.description}}
      <li class="pouvoir-desc-expand" data-item-id="{{pouvoir.id}}">{{pouvoir.system.description}}</li>
      {{/if}}
      {{/each}}
    </ul>
    {{else}}
    <p class="empty-list">{{localize "AGONE.AucunPouvoir"}}</p>
    {{/if}}
  </div>

</div>
