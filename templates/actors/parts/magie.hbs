<!-- PARTIAL : MAGIE -->
<div class="magie-section">

  <!-- Aptitudes magiques -->
  <div class="aptitudes-block">
    <h3 class="section-title">{{localize "AGONE.AptitudesMagiques"}}</h3>
    <div class="aptitudes-grid">
      <div class="aptitude-row">
        <label>{{localize "AGONE.AptitudeArtsMagiques"}}</label>
        <span class="derived-val">{{system.aptitudeArtsMagiques}}</span>
        <button type="button" class="roll-btn-small" data-action="rollAptitudeMagie" title='{{localize "AGONE.JeterAptitudeMagie"}}'>
          <i class="fas fa-dice-d10"></i>
        </button>
      </div>
      <div class="aptitude-row">
        <label>{{localize "AGONE.AptitudeConjuration"}}</label>
        <span class="derived-val">{{system.aptitudeConjuration}}</span>
        <button type="button" class="roll-btn-small" data-action="rollAptitudeConjuration" title='{{localize "AGONE.JeterAptitudeConj"}}'>
          <i class="fas fa-dice-d10"></i>
        </button>
      </div>
    </div>

    {{#if competencesMagie.length}}
    <div class="section-header">
      <h4>{{localize "AGONE.CompetencesMagie"}}</h4>
      <button type="button" class="compendium-browse btn-icon" data-pack="agone.competences" title='{{localize "AGONE.ParcourirCompetences"}}'>
        <i class="fas fa-search"></i>
      </button>
    </div>
    <table class="competences-magie-table">
      <thead>
        <tr>
          <th>{{localize "AGONE.Nom"}}</th>
          <th class="col-score">{{localize "AGONE.Score"}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each competencesMagie as |comp|}}
        <tr class="item-row" data-item-id="{{comp.id}}">
          <td>
            <span class="roll-btn item-name" data-action="rollCompetence" data-item-id="{{comp.id}}">{{comp.name}}</span>
          </td>
          <td class="col-score">{{comp.system.score}}</td>
          <td>
            <a class="item-edit" data-item-id="{{comp.id}}"><i class="fas fa-edit"></i></a>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}
  </div>

  <!-- Sorts -->
  <div class="sorts-block">
    <div class="section-header">
      <h3>{{localize "AGONE.Sorts"}}</h3>
      <button type="button" class="compendium-browse btn-icon" data-pack="agone.sorts" title='{{localize "AGONE.ParcourirSorts"}}'>
        <i class="fas fa-search"></i>
      </button>
      <button type="button" class="item-create" data-type="sort" title='{{localize "AGONE.AjouterSort"}}'>
        <i class="fas fa-plus"></i>
      </button>
    </div>

    <!-- Mini-filtre sorts -->
    <div class="sorts-mini-filter">
      <div class="smf-search-wrap">
        <i class="fas fa-search"></i>
        <input type="text" class="smf-search" placeholder="Filtrer les sorts...">
      </div>
      {{#if sortTypes.length}}
      <div class="smf-checks">
        {{#each sortTypes as |t|}}
        <label class="smf-lbl">
          <input type="checkbox" class="smf-check" value="{{t.value}}"> {{t.label}}
        </label>
        {{/each}}
      </div>
      {{/if}}
    </div>

    {{#if sorts.length}}
    <table class="sorts-table">
      <thead>
        <tr>
          <th>{{localize "AGONE.Nom"}}</th>
          <th>{{localize "AGONE.TypeMagie"}}</th>
          <th>{{localize "AGONE.Seuil"}}</th>
          <th>{{localize "AGONE.Portee"}}</th>
          <th>{{localize "AGONE.Duree"}}</th>
          <th>{{localize "AGONE.Danse"}}</th>
          <th></th>
          <th class="col-drag"></th>
        </tr>
      </thead>
      <tbody>
        {{#each sorts as |sort|}}
        <tr class="item-row sort-main-row" data-item-id="{{sort.id}}" draggable="true">
          <td class="sort-name-cell">
            {{#if sort.system.description}}
            <button type="button" class="sort-desc-toggle btn-icon" data-action="toggleSortDesc" data-item-id="{{sort.id}}" title="Afficher la description">
              <i class="fas fa-chevron-right"></i>
            </button>
            {{/if}}
            <button type="button" class="roll-btn item-name" data-action="rollSort" data-item-id="{{sort.id}}">
              {{sort.name}}
            </button>
          </td>
          <td>{{sort.system.typeMagie}}{{#if sort.system.instrument}} / {{sort.system.instrument}}{{/if}}</td>
          <td>{{sort.system.seuil}}</td>
          <td>{{sort.system.portee}}</td>
          <td>{{sort.system.duree}}</td>
          <td>{{sort.system.danse}}</td>
          <td>
            {{#if sort.system.danseurNom}}<span class="sort-danseur-badge">{{sort.system.danseurNom}}</span>{{/if}}
          </td>
          <td>
            <a class="item-edit" data-item-id="{{sort.id}}"><i class="fas fa-edit"></i></a>
            <a class="item-delete" data-item-id="{{sort.id}}"><i class="fas fa-trash"></i></a>
          </td>
          <td class="sort-drag-handle" title="Déplacer"><i class="fas fa-grip-vertical"></i></td>
        </tr>
        {{#if sort.system.description}}
        <tr class="sort-desc-row" data-item-id="{{sort.id}}" style="display:none">
          <td colspan="9" class="sort-description-cell">{{sort.system.description}}</td>
        </tr>
        {{/if}}
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="empty-list">{{localize "AGONE.AucunSort"}}</p>
    {{/if}}
  </div>

  <!-- Danseurs -->
  <div class="danseurs-block">
    <div class="section-header">
      <h3>{{localize "AGONE.Danseurs"}}</h3>
      <button type="button" class="item-create" data-type="danseur" title='{{localize "AGONE.NouveauDanseur"}}'>
        <i class="fas fa-plus"></i>
      </button>
    </div>
    {{#if danseurs.length}}
    {{#each danseurs as |d|}}
    <div class="danseur-row item-row" data-item-id="{{d.id}}">
      <div class="danseur-header">
        <span class="danseur-nom">{{d.name}}</span>
        <span class="danseur-stat danseur-mem {{#if d.isFull}}mem-full{{/if}}" title="Mémoire">Mém : {{d.assignedCount}}/{{d.system.memoireMax}}</span>
        <span class="danseur-stat" title="Endurance">End : {{d.system.enduranceActuelle}}/{{d.system.enduranceMax}}</span>
        <span class="danseur-stat" title="Bonus d'Emprise">EMP+{{d.system.bonusEmprise}}</span>
        <button type="button" class="danseur-roll-btn" data-action="rollEmprise" data-item-id="{{d.id}}" title='{{localize "AGONE.JeterEmprise"}}'>
          <i class="fas fa-dice-d10"></i> Emprise
        </button>
        <button type="button" class="danseur-roll-btn" data-action="rollImprovisation" data-item-id="{{d.id}}" title='{{localize "AGONE.JeterImprovisation"}}'>
          <i class="fas fa-dice-d10"></i> Impro
        </button>
        <a class="item-edit" data-item-id="{{d.id}}"><i class="fas fa-edit"></i></a>
        <a class="item-delete" data-item-id="{{d.id}}"><i class="fas fa-trash"></i></a>
      </div>
      <div class="danseur-slots" data-danseur-id="{{d.id}}">
        {{#each d.assignedSorts as |s|}}
        <div class="danseur-slot-sort" data-sort-id="{{s.id}}">
          <span class="slot-name">{{s.name}}</span>
          <span class="slot-type">{{s.typeMagie}}</span>
          <button type="button" class="slot-remove" data-sort-id="{{s.id}}" title="Retirer">×</button>
        </div>
        {{/each}}
        {{#unless d.isFull}}
        <div class="danseur-drop-hint"><i class="fas fa-arrow-down"></i> Glisser un sort ici</div>
        {{/unless}}
      </div>
    </div>
    {{/each}}
    {{else}}
    <p class="empty-list">{{localize "AGONE.AucunDanseur"}}</p>
    {{/if}}
  </div>

  <!-- Pouvoirs de la Flamme / Saisonins -->
  <div class="pouvoirs-block">
    <div class="section-header">
      <h3>{{localize "AGONE.Pouvoirs"}}</h3>
      <button type="button" class="item-create" data-type="pouvoir">
        <i class="fas fa-plus"></i>
      </button>
    </div>

    {{#if pouvoirs.length}}
    <ul class="pouvoirs-list">
      {{#each pouvoirs as |pouvoir|}}
      <li class="pouvoir-row item-row" data-item-id="{{pouvoir.id}}">
        <span class="pouvoir-categorie tag-{{pouvoir.system.categorie}}">{{pouvoir.system.categorie}}</span>
        <span class="pouvoir-name">{{pouvoir.name}}</span>
        <a class="item-edit" data-item-id="{{pouvoir.id}}"><i class="fas fa-edit"></i></a>
        <a class="item-delete" data-item-id="{{pouvoir.id}}"><i class="fas fa-trash"></i></a>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="empty-list">{{localize "AGONE.AucunPouvoir"}}</p>
    {{/if}}
  </div>

</div>
