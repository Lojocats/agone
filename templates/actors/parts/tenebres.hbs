<!-- PARTIAL : TÉNÈBRES, PEINES & BIENFAITS -->
<div class="tenebres-section">

  <!-- ── Barre de stats ─────────────────────────────────────── -->
  <div class="tene-stats-bar">
    <div class="tene-stat-item">
      <label>{{localize "AGONE.Tenebres"}}</label>
      <input type="number" name="system.tenebres" value="{{system.tenebres}}" class="stat-num" min="0" max="100" />
      <div class="tene-progress-track" title="{{system.tenebres}} / 100">
        <div class="tene-progress-bar" style="width:{{system.tenebres}}%"></div>
      </div>
      <span class="hint">{{localize "AGONE.Sur100"}}</span>
    </div>
    <div class="tene-stat-separator"></div>
    <div class="tene-stat-item">
      <label title="{{localize "AGONE.Tenebres"}} ÷ 10">{{localize "AGONE.Noirceur"}}</label>
      <span class="derived-val tene-noirceur">{{system.noirceur}}</span>
    </div>
    <div class="tene-stat-separator"></div>
    <!-- Bouton Conjuration Démonologie -->
    <div class="tene-stat-item">
      <button type="button" class="tene-roll-btn" data-action="rollConjurationDemonologie"
              title="1d10 + Noirceur + Démonologie">
        <i class="fas fa-dice-d10"></i> Conjuration
      </button>
    </div>
    <div class="tene-stat-separator"></div>
    <!-- Toggle mode manuel -->
    <div class="tene-stat-item tene-mode-toggle">
      <button type="button" class="tene-mode-btn {{#if tenebresModeManuel}}active{{/if}}"
              data-action="toggleTenebresModeManuel"
              title="{{#if tenebresModeManuel}}Repasser en mode automatique{{else}}Passer en mode manuel (cochez les paliers manuellement){{/if}}">
        <i class="fas fa-{{#if tenebresModeManuel}}lock-open{{else}}lock{{/if}}"></i>
        {{#if tenebresModeManuel}}Manuel{{else}}Auto{{/if}}
      </button>
    </div>
  </div>

  <!-- ── Corps principal ────────────────────────────────────── -->
  <div class="tene-content">

    <!-- Tableau des Paliers / Peines / Bienfaits -->
    <div class="paliers-section">
      <h3 class="section-title paliers-title">{{localize "AGONE.TableauPaliers"}}</h3>
      <table class="paliers-table" summary="Tableau récapitulatif des paliers, peines et bienfaits">
        <thead>
          <tr>
            {{#if tenebresModeManuel}}<th class="col-check"></th>{{/if}}
            <th class="col-palier">{{localize "AGONE.Palier"}}</th>
            <th class="col-peine">{{localize "AGONE.Peines"}}</th>
            <th class="col-bienfait">{{localize "AGONE.Bienfaits"}}</th>
          </tr>
        </thead>
        <tbody>
          <tr class="palier-row{{#if tenebresModeManuel}}{{#if (lookup paliersManuels "10")}} palier-reached{{/if}}{{else}}{{#ifGT system.tenebres 9}} palier-reached{{/ifGT}}{{/if}}">
            {{#if tenebresModeManuel}}<td class="col-check"><button type="button" class="palier-check-btn {{#if (lookup paliersManuels "10")}}checked{{/if}}" data-action="togglePalierManuel" data-seuil="10" title="Cocher/décocher ce palier"><i class="fas fa-{{#if (lookup paliersManuels "10")}}check-square{{else}}square{{/if}}"></i></button></td>{{/if}}
            <td class="col-palier">10</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip10"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.diablotin"}}</td>
            <td class="col-bienfait bienfait-yes" data-tooltip='{{localize "AGONE.TenebresBienfaitTooltip10"}}'>{{#if tenebresModeManuel}}<button type="button" class="bienfait-check-btn {{#if (lookup bienfaitsManuels "10")}}checked{{/if}}" data-action="toggleBienfaitManuel" data-seuil="10" title="Cocher/décocher ce bienfait"><i class="fas fa-{{#if (lookup bienfaitsManuels "10")}}check-square{{else}}square{{/if}}"></i></button>{{/if}}{{localize "AGONE.Bienfait.cercle1"}}</td>
          </tr>
