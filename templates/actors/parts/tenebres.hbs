            <td class="col-bienfait bienfait-yes" data-tooltip='{{localize "AGONE.TenebresBienfaitTooltip30"}}'>{{localize "AGONE.Bienfait.cercle2"}}</td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 39}} palier-reached{{/ifGT}}">
