            <td class="col-palier">60</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip60"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.devianceSexuelle"}}</td>
            <td class="col-bienfait"></td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 64}} palier-reached{{/ifGT}}">
            <td class="col-palier">65</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip65"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.scarificationsLunaires"}}</td>
            <td class="col-bienfait"></td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 69}} palier-reached{{/ifGT}}">
            <td class="col-palier">70</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip70"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.jumeauDemoniaque"}}</td>
            <td class="col-bienfait bienfait-yes" data-tooltip='{{localize "AGONE.TenebresBienfaitTooltip70"}}'>{{localize "AGONE.Bienfait.cercle3"}}</td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 74}} palier-reached{{/ifGT}}">
            <td class="col-palier">75</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip75"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.obsessionOmbre"}}</td>
            <td class="col-bienfait bienfait-yes" data-tooltip='{{localize "AGONE.TenebresBienfaitTooltip75"}}'>{{localize "AGONE.Bienfait.nyctalopie"}}</td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 77}} palier-reached{{/ifGT}}">
            <td class="col-palier">78</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip78"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.presenceOppressante"}}</td>
            <td class="col-bienfait bienfait-yes" data-tooltip='{{localize "AGONE.TenebresBienfaitTooltip78"}}'>{{localize "AGONE.Bienfait.parlerMorts"}}</td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 80}} palier-reached{{/ifGT}}">
            <td class="col-palier">81</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip81"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.alterationSens"}}</td>
            <td class="col-bienfait bienfait-yes" data-tooltip='{{localize "AGONE.TenebresBienfaitTooltip81"}}'>{{localize "AGONE.Bienfait.detecterDemons"}}</td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 83}} palier-reached{{/ifGT}}">
            <td class="col-palier">84</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip84"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.sangNoir"}}</td>
            <td class="col-bienfait"></td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 86}} palier-reached{{/ifGT}}">
            <td class="col-palier">87</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip87"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.apparenceDemoniaque"}}</td>
            <td class="col-bienfait"></td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 89}} palier-reached{{/ifGT}}">
            <td class="col-palier">90</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip90"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.ombrePerfidie"}}</td>
            <td class="col-bienfait"></td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 91}} palier-reached{{/ifGT}}">
            <td class="col-palier">92</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip92"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.siamoisTenebres"}}</td>
            <td class="col-bienfait bienfait-yes" data-tooltip='{{localize "AGONE.TenebresBienfaitTooltip92"}}'>{{localize "AGONE.Bienfait.cercle4"}}</td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 93}} palier-reached{{/ifGT}}">
            <td class="col-palier">94</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip94"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.malediction"}}</td>
            <td class="col-bienfait"></td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 95}} palier-reached{{/ifGT}}">
            <td class="col-palier">96</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip96"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.ombreVivante"}}</td>
            <td class="col-bienfait"></td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 97}} palier-reached{{/ifGT}}">
            <td class="col-palier">98</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip98"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.portailInterieur"}}</td>
            <td class="col-bienfait bienfait-yes" data-tooltip='{{localize "AGONE.TenebresBienfaitTooltip98"}}'>{{localize "AGONE.Bienfait.cercle5"}}</td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 98}} palier-reached{{/ifGT}}">
            <td class="col-palier">99</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip99"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.marqueHautsDiables"}}</td>
            <td class="col-bienfait bienfait-yes" data-tooltip='{{localize "AGONE.TenebresBienfaitTooltip99"}}'>{{localize "AGONE.Bienfait.detecterTenebres"}}</td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 99}} palier-reached{{/ifGT}}">
            <td class="col-palier">100</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip100"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.dechu"}}</td>
            <td class="col-bienfait"></td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Colonne latérale : Flamme + Démons -->
    <div class="tene-sidebar">

      <!-- Démons intérieurs -->
      <div class="demons-block">
    <div class="section-header">
      <h3 class="section-title">{{localize "AGONE.Demons"}}</h3>
      <button type="button" class="item-create" data-type="demon" title='{{localize "AGONE.NouveauDemon"}}'>
        <i class="fas fa-plus"></i>
      </button>
    </div>
    {{#if demons.length}}
    {{#each demons as |d|}}
    <div class="demon-card item-row" data-item-id="{{d.id}}">
      <div class="demon-header">
        <div class="demon-info">
          <span class="demon-nom">{{d.name}}</span>
          {{#if d.system.modeCreation}}
          <span class="demon-creation-badge">{{localize "AGONE.EnModeCreation"}}</span>
          {{else}}
          <span class="demon-stat" title="{{localize "AGONE.DIF"}}">{{localize "AGONE.DIF"}} {{d.system.dif}}</span>
          <span class="demon-stat" title="{{localize "AGONE.AptitudeConjuration"}}">{{localize "AGONE.TenebresConjLabel"}} {{d.system.aptitudeConjuration}}</span>
          <span class="demon-stat" title="{{localize "AGONE.Empathie"}}">{{localize "AGONE.TenebresEmpLabel"}} {{d.system.empathie}}</span>
          <span class="demon-stat" title="{{localize "AGONE.Endurance"}}">{{localize "AGONE.TenebresEndLabel"}} {{d.system.endurance.valeur}}/{{d.system.endurance.max}}</span>
          {{/if}}
        </div>
        <div class="demon-actions">
          {{#if d.system.modeCreation}}
          <button type="button" class="demon-valider-btn" data-action="validerCreationDemon"
                  data-item-id="{{d.id}}" title='{{localize "AGONE.DemonValiderCrea"}}'>
            <i class="fas fa-check"></i> {{localize "AGONE.Valider"}}
          </button>
          {{else}}
          <button type="button" class="btn-icon demon-recrea-btn" data-action="reactiverCreationDemon"
                  data-item-id="{{d.id}}" title='{{localize "AGONE.DemonReactiverCrea"}}'>
            <i class="fas fa-table"></i>
          </button>
          {{/if}}
          <a class="item-edit" data-item-id="{{d.id}}" title='{{localize "AGONE.Editer"}}'><i class="fas fa-edit"></i></a>
          <a class="item-delete" data-item-id="{{d.id}}" title='{{localize "AGONE.Supprimer"}}'><i class="fas fa-trash"></i></a>
        </div>
      </div>
      <div class="demon-stats-grid">
        <div class="demon-stat-row">
          <label>DIF</label>
          <input class="demon-inline-num" type="number" data-item-id="{{d.id}}" data-field="dif" value="{{d.system.dif}}">
        </div>
        <div class="demon-stat-row">
          <label>{{localize "AGONE.AptitudeConjuration"}}</label>
          <input class="demon-inline-num" type="number" data-item-id="{{d.id}}" data-field="aptitudeConjuration" value="{{d.system.aptitudeConjuration}}" min="0">
        </div>
        <div class="demon-stat-row">
          <label>{{localize "AGONE.Empathie"}}</label>
          <input class="demon-inline-num" type="number" data-item-id="{{d.id}}" data-field="empathie" value="{{d.system.empathie}}" min="0">
        </div>
        <div class="demon-stat-row">
          <label>{{localize "AGONE.Opacite"}}</label>
          <input class="demon-inline-num" type="number" data-item-id="{{d.id}}" data-field="opacite" value="{{d.system.opacite}}" min="0">
        </div>
        <div class="demon-stat-row">
          <label>{{localize "AGONE.Densite"}}</label>
          <input class="demon-inline-num" type="number" data-item-id="{{d.id}}" data-field="densite.valeur" value="{{d.system.densite.valeur}}" min="0">
          <span>/</span>
          <input class="demon-inline-num" type="number" data-item-id="{{d.id}}" data-field="densite.max" value="{{d.system.densite.max}}" min="0">
        </div>
        <div class="demon-stat-row">
          <label>{{localize "AGONE.Endurance"}}</label>
          <input class="demon-inline-num" type="number" data-item-id="{{d.id}}" data-field="endurance.valeur" value="{{d.system.endurance.valeur}}" min="0">
          <span>/</span>
          <input class="demon-inline-num" type="number" data-item-id="{{d.id}}" data-field="endurance.max" value="{{d.system.endurance.max}}" min="0">
        </div>
        <div class="demon-stat-row">
          <label>{{localize "AGONE.Memoire"}}</label>
          <input class="demon-inline-num" type="number" data-item-id="{{d.id}}" data-field="memoire.valeur" value="{{d.system.memoire.valeur}}" min="0">
          <span>/</span>
          <input class="demon-inline-num" type="number" data-item-id="{{d.id}}" data-field="memoire.max" value="{{d.system.memoire.max}}" min="0">
        </div>
      </div>
    </div>
    {{/each}}
    {{else}}
    <p class="empty-list">{{localize "AGONE.AucunDemon"}}</p>
    {{/if}}
      </div>
    </div><!-- .tene-sidebar -->

  </div><!-- .tene-content -->

</div><!-- .tenebres-section -->
