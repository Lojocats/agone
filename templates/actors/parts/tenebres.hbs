            <td class="col-palier">98</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip98"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.portailInterieur"}}</td>
            <td class="col-bienfait bienfait-yes" data-tooltip='{{localize "AGONE.TenebresBienfaitTooltip98"}}'>{{#if tenebresModeManuel}}<button type="button" class="bienfait-check-btn {{#if (lookup bienfaitsManuels "98")}}checked{{/if}}" data-action="toggleBienfaitManuel" data-seuil="98" title="Cocher/décocher ce bienfait"><i class="fas fa-{{#if (lookup bienfaitsManuels "98")}}check-square{{else}}square{{/if}}"></i></button>{{/if}}{{localize "AGONE.Bienfait.cercle5"}}</td>
          </tr>
          <tr class="palier-row{{#if tenebresModeManuel}}{{#if (lookup paliersManuels "99")}} palier-reached{{/if}}{{else}}{{#ifGT system.tenebres 98}} palier-reached{{/ifGT}}{{/if}}">
            {{#if tenebresModeManuel}}<td class="col-check"><button type="button" class="palier-check-btn {{#if (lookup paliersManuels "99")}}checked{{/if}}" data-action="togglePalierManuel" data-seuil="99" title="Cocher/décocher ce palier"><i class="fas fa-{{#if (lookup paliersManuels "99")}}check-square{{else}}square{{/if}}"></i></button></td>{{/if}}
            <td class="col-palier">99</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip99"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.marqueHautsDiables"}}</td>
            <td class="col-bienfait bienfait-yes" data-tooltip='{{localize "AGONE.TenebresBienfaitTooltip99"}}'>{{#if tenebresModeManuel}}<button type="button" class="bienfait-check-btn {{#if (lookup bienfaitsManuels "99")}}checked{{/if}}" data-action="toggleBienfaitManuel" data-seuil="99" title="Cocher/décocher ce bienfait"><i class="fas fa-{{#if (lookup bienfaitsManuels "99")}}check-square{{else}}square{{/if}}"></i></button>{{/if}}{{localize "AGONE.Bienfait.detecterTenebres"}}</td>
          </tr>
          <tr class="palier-row{{#if tenebresModeManuel}}{{#if (lookup paliersManuels "100")}} palier-reached{{/if}}{{else}}{{#ifGT system.tenebres 99}} palier-reached{{/ifGT}}{{/if}}">
            {{#if tenebresModeManuel}}<td class="col-check"><button type="button" class="palier-check-btn {{#if (lookup paliersManuels "100")}}checked{{/if}}" data-action="togglePalierManuel" data-seuil="100" title="Cocher/décocher ce palier"><i class="fas fa-{{#if (lookup paliersManuels "100")}}check-square{{else}}square{{/if}}"></i></button></td>{{/if}}
            <td class="col-palier">100</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip100"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.dechu"}}</td>
            <td class="col-bienfait"></td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Colonne latérale : Flamme + Démons -->
    <div class="tene-sidebar">

      <!-- Démons intérieurs (acteurs liés) -->
      <div class="demons-block">
        <div class="section-header">
          <h3 class="section-title">{{localize "AGONE.Demons"}}</h3>
          {{#if isOwner}}
          <button type="button" data-action="createDemonActor" title='{{localize "AGONE.NouveauDemon"}}'>
            <i class="fas fa-plus"></i>
          </button>
          {{/if}}
        </div>

        {{#if isOwner}}
        <div class="demons-drop-zone" title="{{localize 'AGONE.DemonDropHint'}}">
          <i class="fas fa-skull"></i> {{localize "AGONE.DemonDropHint"}}
        </div>
        {{/if}}

        {{#if demonActors.length}}
        <div class="demons-cards">
          {{#each demonActors}}
          <div class="cmp-card demon-actor-card" data-uuid="{{uuid}}">

            <!-- Portrait -->
            <div class="cmp-portrait-wrap">
              <img class="cmp-portrait" src="{{img}}" title="{{localize 'AGONE.Ouvrir'}} {{name}}" />
              <span class="cmp-type-badge cmp-type-demon">{{localize "AGONE.Demon"}}</span>
            </div>

            <!-- Corps -->
            <div class="cmp-body">

              <!-- En-tête : nom + actions -->
              <div class="cmp-header">
                <div class="cmp-name-block">
                  <span class="cmp-name">{{name}}</span>
                  {{#if origine}}
                  <span class="cmp-subtitle">{{localize (concat "AGONE.Peine." origine)}}</span>
                  {{/if}}
                  {{#if modeCreation}}
                  <span class="demon-creation-badge">{{localize "AGONE.EnModeCreation"}}</span>
                  {{/if}}
                </div>
                {{#if ../isOwner}}
                <div class="cmp-actions">
                  <button type="button" class="demon-actor-open cmp-btn" data-uuid="{{uuid}}"
                          title="{{localize 'AGONE.Ouvrir'}}">
                    <i class="fas fa-external-link-alt"></i>
                  </button>
                  <button type="button" class="demon-actor-remove cmp-btn cmp-btn-remove" data-uuid="{{uuid}}"
                          title="{{localize 'AGONE.Retirer'}}">
                    <i class="fas fa-times"></i>
                  </button>
                </div>
                {{/if}}
              </div>

              <!-- Barre Densité -->
              <div class="cmp-pdv-block">
                <div class="cmp-pdv-line">
                  <span class="cmp-pdv-label">{{localize "AGONE.Densite"}}</span>
                  <span class="cmp-pdv-nums">{{densiteVal}} / {{densiteMax}}</span>
                </div>
                <div class="cmp-pdv-track">
                  <div class="cmp-pdv-fill" style="width:{{densitePct}}%; background:{{densiteColor}};"></div>
                </div>
              </div>

              <!-- Stats démon -->
              <div class="cmp-stats-row">
                <div class="cmp-stat">
                  <span class="cmp-stat-lbl">{{localize "AGONE.Initiative"}}</span>
                  <span class="cmp-stat-val">{{initiative}}</span>
                </div>
                <div class="cmp-stat">
                  <span class="cmp-stat-lbl">{{localize "AGONE.Melee"}}</span>
                  <span class="cmp-stat-val">{{melee}}</span>
                </div>
                <div class="cmp-stat">
                  <span class="cmp-stat-lbl">DIF</span>
                  <span class="cmp-stat-val">{{dif}}</span>
                </div>
                <div class="cmp-stat">
                  <span class="cmp-stat-lbl">{{localize "AGONE.Opacite"}}</span>
                  <span class="cmp-stat-val">{{opacite}}</span>
                </div>
              </div>

            </div><!-- /.cmp-body -->
          </div><!-- /.cmp-card -->
          {{/each}}
        </div>
        {{else}}
        <p class="companions-empty">{{localize "AGONE.AucunDemon"}}</p>
        {{/if}}
      </div>
    </div><!-- .tene-sidebar -->

  </div><!-- .tene-content -->

</div><!-- .tenebres-section -->
