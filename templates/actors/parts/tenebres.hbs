            <td class="col-bienfait"></td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 97}} palier-reached{{/ifGT}}">
            <td class="col-palier">98</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip98"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.portailInterieur"}}</td>
            <td class="col-bienfait bienfait-yes" data-tooltip='{{localize "AGONE.TenebresBienfaitTooltip98"}}'>{{localize "AGONE.Bienfait.cercle5"}}</td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 98}} palier-reached{{/ifGT}}">
            <td class="col-palier">99</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip99"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.marqueHautsDiables"}}</td>
            <td class="col-bienfait bienfait-yes" data-tooltip='{{localize "AGONE.TenebresBienfaitTooltip99"}}'>{{localize "AGONE.Bienfait.detecterTenebres"}}</td>
