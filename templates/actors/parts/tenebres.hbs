<!-- PARTIAL : TÉNÈBRES, PEINES & BIENFAITS -->
<div class="tenebres-section">

  <!-- ── Barre de stats ─────────────────────────────────────── -->
  <div class="tene-stats-bar">
    <div class="tene-stat-item">
      <label>{{localize "AGONE.Tenebres"}}</label>
      <input type="number" name="system.tenebres" value="{{system.tenebres}}" class="stat-num" min="0" max="100" />
      <div class="tene-progress-track" title="{{system.tenebres}} / 100">
        <div class="tene-progress-bar" style="width:{{system.tenebres}}%"></div>
      </div>
      <span class="hint">{{localize "AGONE.Sur100"}}</span>
    </div>
    <div class="tene-stat-separator"></div>
    <div class="tene-stat-item">
      <label title="{{localize "AGONE.Tenebres"}} ÷ 10">{{localize "AGONE.Noirceur"}}</label>
      <span class="derived-val tene-noirceur">{{system.noirceur}}</span>
    </div>
  </div>

  <!-- ── Corps principal ────────────────────────────────────── -->
  <div class="tene-content">

    <!-- Tableau des Paliers / Peines / Bienfaits -->
    <div class="paliers-section">
      <h3 class="section-title paliers-title">{{localize "AGONE.TableauPaliers"}}</h3>
      <table class="paliers-table" summary="Tableau récapitulatif des paliers, peines et bienfaits">
        <thead>
          <tr>
            <th class="col-palier">{{localize "AGONE.Palier"}}</th>
            <th class="col-peine">{{localize "AGONE.Peines"}}</th>
            <th class="col-bienfait">{{localize "AGONE.Bienfaits"}}</th>
          </tr>
        </thead>
        <tbody>
          <tr class="palier-row{{#ifGT system.tenebres 9}} palier-reached{{/ifGT}}">
            <td class="col-palier">10</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip10"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.diablotin"}}</td>
            <td class="col-bienfait bienfait-yes" data-tooltip='{{localize "AGONE.TenebresBienfaitTooltip10"}}'>{{localize "AGONE.Bienfait.cercle1"}}</td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 19}} palier-reached{{/ifGT}}">
            <td class="col-palier">20</td>
            <td class="col-peine" data-tooltip='{{localize "AGONE.TenebresPalierTooltip20"}}'><span class="peine-dot"></span>{{localize "AGONE.Peine.cauchemars"}}</td>
            <td class="col-bienfait bienfait-yes" data-tooltip='{{localize "AGONE.TenebresBienfaitTooltip20"}}'>{{localize "AGONE.Bienfait.diablotin2"}}</td>
          </tr>
          <tr class="palier-row{{#ifGT system.tenebres 29}} palier-reached{{/ifGT}}">
