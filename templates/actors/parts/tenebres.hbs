<!-- PARTIAL : TÉNÈBRES, PEINES & BIENFAITS -->
<div class="tenebres-section">

  <!-- ── Barre de stats ─────────────────────────────────────── -->
  <div class="tene-stats-bar">
    <div class="tene-stat-item">
      <label>{{localize "AGONE.Tenebres"}}</label>
      <input type="number" name="system.tenebres" value="{{system.tenebres}}" class="stat-num" min="0" max="100" />
      <div class="tene-progress-track" data-tooltip="{{system.tenebres}} / 100">
        <div class="tene-progress-bar" style="width:{{system.tenebres}}%"></div>
      </div>
      <span class="hint">{{localize "AGONE.Sur100"}}</span>
    </div>
    <div class="tene-stat-separator"></div>
    <div class="tene-stat-item">
      <label data-tooltip="{{localize "AGONE.Tenebres"}} ÷ 10">{{localize "AGONE.Noirceur"}}</label>
      <span class="derived-val tene-noirceur">{{system.noirceur}}</span>
    </div>
    <div class="tene-stat-separator"></div>
    <!-- Bouton Conjuration Démonologie -->
    <div class="tene-stat-item">
      <button type="button" class="tene-roll-btn" data-action="rollConjurationDemonologie"
              data-tooltip='{{localize "AGONE.Ui.ConjurationFormule"}}'>
        <i class="fas fa-dice-d10"></i> {{localize "AGONE.Ui.Conjuration"}}
      </button>
    </div>
    <div class="tene-stat-separator"></div>
    <!-- Toggle mode manuel -->
    <div class="tene-stat-item tene-mode-toggle">
      <button type="button" class="tene-mode-btn {{#if tenebresModeManuel}}active{{/if}}"
              data-action="toggleTenebresModeManuel"
              data-tooltip='{{#if tenebresModeManuel}}{{localize "AGONE.Ui.ModeAutoTitre"}}{{else}}{{localize "AGONE.Ui.ModeManuelTitre"}}{{/if}}'>
        <i class="fas fa-{{#if tenebresModeManuel}}lock-open{{else}}lock{{/if}}"></i>
        {{#if tenebresModeManuel}}{{localize "AGONE.Ui.Manuel"}}{{else}}{{localize "AGONE.Ui.Auto"}}{{/if}}
      </button>
    </div>
  </div>

  <!-- ── Corps principal ────────────────────────────────────── -->
  <div class="tene-content">

    <!-- Tableau des Paliers / Peines / Bienfaits -->
    <div class="paliers-section">
      <h3 class="section-title paliers-title">{{localize "AGONE.TableauPaliers"}}</h3>
      <table class="paliers-table" summary='{{localize "AGONE.Ui.ResumePaliers"}}'>
        <thead>
          <tr>
            {{#if tenebresModeManuel}}<th class="col-check"></th>{{/if}}
            <th class="col-chevron"><button type="button" class="desc-bascule-tout" aria-expanded="false" aria-label="{{localize 'AGONE.DescriptionsToutes'}}"><i class="fas fa-angles-down"></i></button></th>
            <th class="col-palier">{{localize "AGONE.Palier"}}</th>
            <th class="col-peine">{{localize "AGONE.Peines"}}</th>
            <th class="col-bienfait">{{localize "AGONE.Bienfaits"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each tableauPaliers as |p|}}
          <tr class="palier-row{{#if p.atteint}} palier-reached{{/if}}">
            {{#if ../tenebresModeManuel}}<td class="col-check"><button type="button" class="palier-check-btn {{#if p.atteint}}checked{{/if}}" data-action="togglePalierManuel" data-seuil="{{p.seuil}}" data-tooltip='{{localize "AGONE.Ui.CocherPalier"}}' aria-label='{{localize "AGONE.Ui.CocherPalier"}}'><i class="fas fa-{{#if p.atteint}}check-square{{else}}square{{/if}}"></i></button></td>{{/if}}
            <td class="col-chevron"><button type="button" class="desc-bascule" data-desc="palier:{{p.seuil}}" aria-expanded="false" aria-label="{{localize 'AGONE.VoirDescription'}}"><i class="fas fa-chevron-right"></i></button></td>
            <td class="col-palier">{{p.seuil}}</td>
            <td class="col-peine" data-tooltip="{{p.tooltipPeine}}"><span class="peine-dot"></span>{{p.peineNom}}</td>
            <td class="col-bienfait{{#if p.bienfaitNom}} bienfait-yes{{/if}}"{{#if p.bienfaitNom}} data-tooltip="{{p.tooltipBienfait}}"{{/if}}>{{#if p.bienfaitNom}}{{#if ../tenebresModeManuel}}<button type="button" class="bienfait-check-btn {{#if p.bienfaitCoche}}checked{{/if}}" data-action="toggleBienfaitManuel" data-seuil="{{p.seuil}}" data-tooltip='{{localize "AGONE.Ui.CocherBienfait"}}' aria-label='{{localize "AGONE.Ui.CocherBienfait"}}'><i class="fas fa-{{#if p.bienfaitCoche}}check-square{{else}}square{{/if}}"></i></button>{{/if}}{{p.bienfaitNom}}{{/if}}</td>
          </tr>
          <tr class="palier-desc-row desc-pliable" data-desc-de="palier:{{p.seuil}}" hidden>
            {{#if ../tenebresModeManuel}}<td></td>{{/if}}
            <td></td>
            <td colspan="3" class="peine-desc-cell">
              <div class="peine-details">
                <div class="peine-details-section">
                  <h4 class="peine-details-titre">{{localize "AGONE.NomPeine"}} : {{p.peineNom}}</h4>
                  <p class="peine-details-texte">{{p.tooltipPeine}}</p>
                </div>
                <div class="peine-details-section">
                  <h4 class="peine-details-titre">{{localize "AGONE.BienfaitLabel"}}{{#if p.bienfaitNom}} : {{p.bienfaitNom}}{{/if}}</h4>
                  {{#if p.bienfaitNom}}
                  <p class="peine-details-texte">{{p.tooltipBienfait}}</p>
                  {{else}}
                  <p class="peine-details-aucun">{{localize "AGONE.PerfidieAucunBienfait"}}</p>
                  {{/if}}
                </div>
              </div>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Colonne latérale : Flamme + Démons -->
    <div class="tene-sidebar">

      <!-- Démons intérieurs (acteurs liés) -->
      <div class="demons-block">
        <div class="section-header">
          <h3 class="section-title">{{localize "AGONE.Demons"}}</h3>
          {{#if isOwner}}
          <button type="button" data-action="createDemonActor" data-tooltip='{{localize "AGONE.NouveauDemon"}}' aria-label='{{localize "AGONE.NouveauDemon"}}'>
            <i class="fas fa-plus"></i>
          </button>
          {{/if}}
        </div>

        {{#if isOwner}}
        <div class="demons-drop-zone" data-tooltip="{{localize 'AGONE.DemonDropHint'}}">
          <i class="fas fa-skull"></i> {{localize "AGONE.DemonDropHint"}}
        </div>
        {{/if}}

        {{#if demonActors.length}}
        <div class="demons-cards">
          {{#each demonActors}}
          <div class="cmp-card demon-actor-card" data-uuid="{{uuid}}">

            <!-- Portrait -->
            <div class="cmp-portrait-wrap">
              <img class="cmp-portrait" src="{{img}}" data-tooltip="{{localize 'AGONE.Ouvrir'}} {{name}}" />
              <span class="cmp-type-badge cmp-type-demon">{{localize "AGONE.Demon"}}</span>
            </div>

            <!-- Corps -->
            <div class="cmp-body">

              <!-- En-tête : nom + actions -->
              <div class="cmp-header">
                <div class="cmp-name-block">
                  <span class="cmp-name">{{name}}</span>
                  {{#if origine}}
                  <span class="cmp-subtitle">{{localize (concat "AGONE.Peine." origine)}}</span>
                  {{/if}}
                  {{#if modeCreation}}
                  <span class="demon-creation-badge">{{localize "AGONE.EnModeCreation"}}</span>
                  {{/if}}
                </div>
                {{#if ../isOwner}}
                <div class="cmp-actions">
                  <button type="button" class="demon-actor-open cmp-btn" data-uuid="{{uuid}}"
                          data-tooltip="{{localize 'AGONE.Ouvrir'}}" aria-label="{{localize 'AGONE.Ouvrir'}}">
                    <i class="fas fa-external-link-alt"></i>
                  </button>
                  <button type="button" class="demon-actor-remove cmp-btn cmp-btn-remove" data-uuid="{{uuid}}"
                          data-tooltip="{{localize 'AGONE.Retirer'}}" aria-label="{{localize 'AGONE.Retirer'}}">
                    <i class="fas fa-times"></i>
                  </button>
                </div>
                {{/if}}
              </div>

              <!-- Barre Densité -->
              <div class="cmp-pdv-block">
                <div class="cmp-pdv-line">
                  <span class="cmp-pdv-label">{{localize "AGONE.Densite"}}</span>
                  <span class="cmp-pdv-nums">{{densiteVal}} / {{densiteMax}}</span>
                </div>
                <div class="cmp-pdv-track">
                  <div class="cmp-pdv-fill" style="width:{{densitePct}}%; background:{{densiteColor}};"></div>
                </div>
              </div>

              <!-- Stats démon -->
              <div class="cmp-stats-row">
                <div class="cmp-stat">
                  <span class="cmp-stat-lbl">{{localize "AGONE.Initiative"}}</span>
                  <span class="cmp-stat-val">{{initiative}}</span>
                </div>
                <div class="cmp-stat">
                  <span class="cmp-stat-lbl">{{localize "AGONE.Melee"}}</span>
                  <span class="cmp-stat-val">{{melee}}</span>
                </div>
                <div class="cmp-stat">
                  <span class="cmp-stat-lbl">DIF</span>
                  <span class="cmp-stat-val">{{dif}}</span>
                </div>
                <div class="cmp-stat">
                  <span class="cmp-stat-lbl">{{localize "AGONE.Opacite"}}</span>
                  <span class="cmp-stat-val">{{opacite}}</span>
                </div>
              </div>

            </div><!-- /.cmp-body -->
          </div><!-- /.cmp-card -->
          {{/each}}
        </div>
        {{else}}
        <p class="companions-empty">{{localize "AGONE.AucunDemon"}}</p>
        {{/if}}
      </div>
    </div><!-- .tene-sidebar -->

  </div><!-- .tene-content -->

</div><!-- .tenebres-section -->
