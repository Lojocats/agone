<!-- PARTIAL : AVANTAGES & DÉFAUTS -->
<div class="avantages-section">

  <!-- ── Compteur de Charges ───────────────────────────────────── -->
  <div class="charges-card">
    <div class="charges-card-header">
      <i class="fas fa-balance-scale"></i>
      <span class="charges-card-title">{{localize "AGONE.Avantages.ChargesSection"}}</span>
      <span class="charges-card-subtitle">{{localize "AGONE.Avantages.ChargesSubtitle"}}</span>
    </div>
    <div class="charges-card-body">
      <div class="charges-stats-row">
        <div class="charges-stat">
          <span class="charges-stat-label">{{localize "AGONE.Avantages.Budget"}}</span>
          <input type="number" name="system.ptsCharges.max" value="{{system.ptsCharges.max}}"
                 class="charges-stat-input" min="0" data-dtype="Number">
        </div>
        <div class="charges-stat-sep">+</div>
        <div class="charges-stat">
          <span class="charges-stat-label">{{localize "AGONE.Avantages.Recuperes"}}</span>
          <span class="charges-stat-val charges-plus">{{system.chargesRecuperees}}</span>
        </div>
        <div class="charges-stat-sep charges-stat-sep--eq">=</div>
        <div class="charges-stat charges-stat--main">
          <span class="charges-stat-label">{{localize "AGONE.Avantages.Disponibles"}}</span>
          <span class="charges-stat-val charges-disponibles">{{system.chargesDisponibles}}</span>
        </div>
        <div class="charges-stat-sep">-</div>
        <div class="charges-stat">
          <span class="charges-stat-label">{{localize "AGONE.Avantages.Depenses"}}</span>
          <span class="charges-stat-val charges-moins">{{system.chargesDepensees}}</span>
        </div>
        <div class="charges-stat-sep charges-stat-sep--eq">=</div>
        <div class="charges-stat charges-stat--solde">
          <span class="charges-stat-label">{{localize "AGONE.Avantages.Solde"}}</span>
          <span class="charges-stat-val {{system.chargesSoldeClass}}">{{system.chargesSolde}}</span>
        </div>
      </div>
      {{#if system.chargesJeune}}
      <p class="charges-note"><i class="fas fa-exclamation-triangle"></i> {{localize "AGONE.Avantages.JeuneNote"}}</p>
      {{/if}}
      {{#if system.chargesVieillard}}
      <p class="charges-note">{{localize "AGONE.Avantages.VieillardNote"}}</p>
      {{/if}}
    </div>
  </div>

  <!-- ── Grille Avantages / Défauts ──────────────────────────── -->
  <div class="av-def-grid">

    <!-- Colonne Avantages -->
    <div class="av-col">
      <div class="av-col-header">
        <h4 class="av-col-title av-title"><i class="fas fa-star"></i> {{localize "AGONE.Avantages.Avantages"}}</h4>
        <button type="button" class="btn-icon compendium-browse" data-pack="agone.dons" data-filter-type="avantage"
                title='{{localize "AGONE.ParcourirDons"}}'>
          <i class="fas fa-search"></i>
        </button>
        <button type="button" class="btn-icon item-create" data-type="don" data-categorie="avantage"
                title='{{localize "AGONE.Avantages.CreerAvantage"}}'>
          <i class="fas fa-plus"></i>
        </button>
      </div>
      {{#if avantages.length}}
      <ul class="dons-list">
        {{#each avantages as |don|}}
        <li class="don-row item-row" data-item-id="{{don.id}}">
          <span class="item-drag-handle col-drag"><i class="fas fa-grip-vertical"></i></span>
          {{#if don.system.description}}
          <button type="button" class="don-desc-toggle btn-icon" data-item-id="{{don.id}}" title="Description">
            <i class="fas fa-chevron-right don-toggle-icon"></i>
          </button>
          {{else}}
          <span class="don-desc-placeholder"></span>
          {{/if}}
          {{#if don._avSectionLabel}}
          <span class="av-section-badge av-sect-{{don._avSection}}">{{don._avSectionLabel}}</span>
          {{/if}}
          <span class="don-name">{{don.name}}</span>
          <span class="don-cout av-cout-pos">+{{don.system.cout}}</span>
          <a class="btn-icon item-edit" data-item-id="{{don.id}}" title="Modifier"><i class="fas fa-edit"></i></a>
          <a class="btn-icon item-delete" data-item-id="{{don.id}}" title="Supprimer"><i class="fas fa-trash"></i></a>
        </li>
        {{#if don.system.description}}
        <li class="don-desc-expand" data-item-id="{{don.id}}" style="display:none">
          <span class="don-desc-text">{{don.system.description}}</span>
        </li>
        {{/if}}
        {{/each}}
      </ul>
      {{else}}
      <p class="empty-list">{{localize "AGONE.AucunAvantage"}}</p>
      {{/if}}
    </div><!-- /.av-col -->

    <!-- Colonne Défauts -->
    <div class="def-col">
      <div class="av-col-header">
        <h4 class="av-col-title def-title"><i class="fas fa-exclamation-circle"></i> {{localize "AGONE.Defauts"}}</h4>
        <button type="button" class="btn-icon compendium-browse" data-pack="agone.dons" data-filter-type="defaut"
                title='{{localize "AGONE.ParcourirDons"}}'>
          <i class="fas fa-search"></i>
        </button>
        <button type="button" class="btn-icon item-create" data-type="don" data-categorie="defaut"
                title='{{localize "AGONE.Avantages.CreerDefaut"}}'>
          <i class="fas fa-plus"></i>
        </button>
      </div>
      {{#if defauts.length}}
      <ul class="dons-list">
        {{#each defauts as |don|}}
        <li class="don-row item-row" data-item-id="{{don.id}}">
          <span class="item-drag-handle col-drag"><i class="fas fa-grip-vertical"></i></span>
          {{#if don.system.description}}
          <button type="button" class="don-desc-toggle btn-icon" data-item-id="{{don.id}}" title='{{localize "AGONE.VoirDescription"}}'>
            <i class="fas fa-chevron-right don-toggle-icon"></i>
          </button>
          {{else}}
          <span class="don-desc-placeholder"></span>
          {{/if}}
          {{#if don._avSectionLabel}}
          <span class="av-section-badge av-sect-{{don._avSection}} av-defaut-sect">{{don._avSectionLabel}}</span>
          {{/if}}
          <span class="don-name">{{don.name}}</span>
          <span class="don-cout av-cout-neg">{{don.system.cout}}</span>
          <a class="btn-icon item-edit" data-item-id="{{don.id}}" title='{{localize "AGONE.Modifier"}}'><i class="fas fa-edit"></i></a>
          <a class="btn-icon item-delete" data-item-id="{{don.id}}" title='{{localize "AGONE.Supprimer"}}'><i class="fas fa-trash"></i></a>
        </li>
        {{#if don.system.description}}
        <li class="don-desc-expand" data-item-id="{{don.id}}" style="display:none">
          <span class="don-desc-text">{{don.system.description}}</span>
        </li>
        {{/if}}
        {{/each}}
      </ul>
      {{else}}
      <p class="empty-list">{{localize "AGONE.AucunDefaut"}}</p>
      {{/if}}
    </div><!-- /.def-col -->

  </div><!-- /.av-def-grid -->

  <!-- ── Bonus/Malus d'attributs supplémentaires ────────────────────── -->
  <div class="bonus-supp-section">
    <div class="bonus-supp-header">
      <h4 class="section-title" style="margin:0">
        <i class="fas fa-sliders-h"></i>
        {{localize "AGONE.Avantages.BonusSupp.Titre"}}
      </h4>
      <button type="button" class="btn-icon bonus-supp-add"
              title='{{localize "AGONE.Avantages.BonusSupp.Ajouter"}}'>
        <i class="fas fa-plus"></i>
      </button>
    </div>
    {{#if bonusAttributsSupp.length}}
    <table class="bonus-supp-table">
      <thead>
        <tr>
          <th>{{localize "AGONE.Avantages.BonusSupp.Categorie"}}</th>
          <th>{{localize "AGONE.Avantages.BonusSupp.Attribut"}}</th>
          <th>{{localize "AGONE.Avantages.BonusSupp.Valeur"}}</th>
          <th>{{localize "AGONE.Avantages.BonusSupp.Description"}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each bonusAttributsSupp as |entry|}}
        <tr data-idx="{{@index}}">
          <td>
            <select class="bonus-supp-field" data-field="categorie">
              <option value="avantage" {{#if (eq entry.categorie "avantage")}}selected{{/if}}>{{localize "AGONE.Avantage"}}</option>
              <option value="defaut"   {{#if (eq entry.categorie "defaut")}}selected{{/if}}>{{localize "AGONE.Defaut"}}</option>
            </select>
          </td>
          <td>
            <select class="bonus-supp-field" data-field="attribut">
              <optgroup label="{{localize "AGONE.Aspects"}}">
                <option value="corps"        {{#if (eq entry.attribut "corps")}}selected{{/if}}>{{localize "AGONE.Corps"}}</option>
                <option value="esprit"       {{#if (eq entry.attribut "esprit")}}selected{{/if}}>{{localize "AGONE.Esprit"}}</option>
                <option value="ame"          {{#if (eq entry.attribut "ame")}}selected{{/if}}>{{localize "AGONE.Ame"}}</option>
              </optgroup>
              <optgroup label="{{localize "AGONE.Caracteristiques"}}">
                <option value="agilite"      {{#if (eq entry.attribut "agilite")}}selected{{/if}}>{{localize "AGONE.Attribut.Agilite"}}</option>
                <option value="force"        {{#if (eq entry.attribut "force")}}selected{{/if}}>{{localize "AGONE.Attribut.Force"}}</option>
                <option value="perception"   {{#if (eq entry.attribut "perception")}}selected{{/if}}>{{localize "AGONE.Attribut.Perception"}}</option>
                <option value="resistance"   {{#if (eq entry.attribut "resistance")}}selected{{/if}}>{{localize "AGONE.Attribut.Resistance"}}</option>
                <option value="intelligence" {{#if (eq entry.attribut "intelligence")}}selected{{/if}}>{{localize "AGONE.Attribut.Intelligence"}}</option>
                <option value="volonte"      {{#if (eq entry.attribut "volonte")}}selected{{/if}}>{{localize "AGONE.Attribut.Volonte"}}</option>
                <option value="charisma"     {{#if (eq entry.attribut "charisma")}}selected{{/if}}>{{localize "AGONE.Attribut.Charisma"}}</option>
                <option value="creativite"   {{#if (eq entry.attribut "creativite")}}selected{{/if}}>{{localize "AGONE.Attribut.Creativite"}}</option>
              </optgroup>
              <optgroup label="{{localize "AGONE.CaracDerivees"}}">
                <option value="melee"            {{#if (eq entry.attribut "melee")}}selected{{/if}}>{{localize "AGONE.Melee"}}</option>
                <option value="tir"              {{#if (eq entry.attribut "tir")}}selected{{/if}}>{{localize "AGONE.Tir"}}</option>
                <option value="art"              {{#if (eq entry.attribut "art")}}selected{{/if}}>{{localize "AGONE.Art"}}</option>
                <option value="initiative"       {{#if (eq entry.attribut "initiative")}}selected{{/if}}>{{localize "AGONE.Initiative"}}</option>
                <option value="initMagique"      {{#if (eq entry.attribut "initMagique")}}selected{{/if}}>{{localize "AGONE.InitMagique"}}</option>
                <option value="defenseNaturelle" {{#if (eq entry.attribut "defenseNaturelle")}}selected{{/if}}>{{localize "AGONE.DefenseNaturelle"}}</option>
                <option value="bd"               {{#if (eq entry.attribut "bd")}}selected{{/if}}>{{localize "AGONE.BD"}}</option>
                <option value="esquive"          {{#if (eq entry.attribut "esquive")}}selected{{/if}}>{{localize "AGONE.EsquiveTotal"}}</option>
                <option value="emprise"          {{#if (eq entry.attribut "emprise")}}selected{{/if}}>{{localize "AGONE.Emprise"}}</option>
              </optgroup>
            </select>
          </td>
          <td>
            <input type="number" class="bonus-supp-field bonus-supp-val"
                   data-field="valeur" value="{{entry.valeur}}" />
          </td>
          <td>
            <input type="text" class="bonus-supp-field bonus-supp-desc"
                   data-field="description" value="{{entry.description}}" placeholder="…" />
          </td>
          <td>
            <button type="button" class="btn-icon bonus-supp-delete"
                    data-idx="{{@index}}" title='{{localize "AGONE.Supprimer"}}'>
              <i class="fas fa-trash"></i>
            </button>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="empty-list">{{localize "AGONE.Avantages.BonusSupp.Vide"}}</p>
    {{/if}}
  </div><!-- /.bonus-supp-section -->

</div><!-- /.avantages-section -->