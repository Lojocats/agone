<!-- PARTIAL : AVANTAGES & DÉFAUTS -->
<div class="avantages-section">
  <div class="section-header">
    <h3>{{localize "AGONE.AvantagesDefauts"}}</h3>
    <button type="button" class="compendium-browse btn-icon" data-pack="agone.dons" title='{{localize "AGONE.ParcourirDons"}}'>
      <i class="fas fa-search"></i>
    </button>
    <button type="button" class="item-create" data-type="don">
      <i class="fas fa-plus"></i>
    </button>
  </div>

  <!-- Compteur de Charges -->
  <div class="charges-compteur">
    <div class="charges-titre">Charges</div>
    <div class="charges-sous-titre">10 pts de base (+ 5 pour une Charge sociale optionnelle)</div>
    <div class="charges-ligne">
      <span class="charges-label">Budget initial&nbsp;:</span>
      <input type="number" name="system.ptsCharges.max" value="{{system.ptsCharges.max}}" class="charges-input" min="0" data-dtype="Number">
    </div>
    <div class="charges-ligne">
      <span class="charges-label">Récupérées (défauts)&nbsp;:</span>
      <span class="charges-valeur charges-plus">+{{system.chargesRecuperees}}</span>
    </div>
    <div class="charges-ligne charges-disponibles-ligne">
      <span class="charges-label"><strong>Disponibles&nbsp;:</strong></span>
      <span class="charges-valeur charges-disponibles">{{system.chargesDisponibles}}</span>
    </div>
    <div class="charges-ligne charges-depensees-ligne">
      <span class="charges-label">Dépensées (avantages)&nbsp;:</span>
      <span class="charges-valeur charges-moins">{{system.chargesDepensees}}</span>
    </div>
    <div class="charges-ligne charges-solde-ligne">
      <span class="charges-label"><strong>Solde&nbsp;:</strong></span>
      <span class="charges-valeur {{system.chargesSoldeClass}}">{{system.chargesSolde}}</span>
    </div>
    {{#if system.chargesJeune}}
    <p class="charges-note"><i class="fas fa-exclamation-triangle"></i> Jeune : coûts des avantages ×2</p>
    {{/if}}
    {{#if system.chargesVieillard}}
    <p class="charges-note">Vieillard : coûts des avantages −2 (min 1)</p>
    {{/if}}
  </div>

  <!-- Avantages -->
  <div class="avantages-groupe">
    <h4>{{localize "AGONE.Avantages"}}</h4>
    {{#if avantages.length}}
    <ul class="dons-list">
      {{#each avantages as |don|}}
      <li class="don-row item-row" data-item-id="{{don.id}}">
        <span class="item-drag-handle" title="Déplacer"><i class="fas fa-grip-vertical"></i></span>
        {{#if don.system.description}}
        <button type="button" class="don-desc-toggle btn-icon" data-item-id="{{don.id}}" title="Description">
          <i class="fas fa-chevron-right don-toggle-icon"></i>
        </button>
        {{/if}}
        <span class="don-name">{{don.name}}</span>
        <span class="don-cout">({{don.system.cout}} pts)</span>
        <a class="item-edit" data-item-id="{{don.id}}"><i class="fas fa-edit"></i></a>
        <a class="item-delete" data-item-id="{{don.id}}"><i class="fas fa-trash"></i></a>
      </li>
      {{#if don.system.description}}
      <li class="don-desc-expand" data-item-id="{{don.id}}" style="display:none">
        <span class="don-desc-text">{{don.system.description}}</span>
      </li>
      {{/if}}
      {{/each}}
    </ul>
    {{else}}
    <p class="empty-list">{{localize "AGONE.AucunAvantage"}}</p>
    {{/if}}
  </div>

  <!-- Défauts -->
  <div class="defauts-groupe">
    <h4>{{localize "AGONE.Defauts"}}</h4>
    {{#if defauts.length}}
    <ul class="dons-list">
      {{#each defauts as |don|}}
      <li class="don-row item-row" data-item-id="{{don.id}}">
        <span class="item-drag-handle" title="Déplacer"><i class="fas fa-grip-vertical"></i></span>
        {{#if don.system.description}}
        <button type="button" class="don-desc-toggle btn-icon" data-item-id="{{don.id}}" title="Description">
          <i class="fas fa-chevron-right don-toggle-icon"></i>
        </button>
        {{/if}}
        <span class="don-name">{{don.name}}</span>
        <span class="don-cout">({{don.system.cout}} pts)</span>
        <a class="item-edit" data-item-id="{{don.id}}"><i class="fas fa-edit"></i></a>
        <a class="item-delete" data-item-id="{{don.id}}"><i class="fas fa-trash"></i></a>
      </li>
      {{#if don.system.description}}
      <li class="don-desc-expand" data-item-id="{{don.id}}" style="display:none">
        <span class="don-desc-text">{{don.system.description}}</span>
      </li>
      {{/if}}
      {{/each}}
    </ul>
    {{else}}
    <p class="empty-list">{{localize "AGONE.AucunDefaut"}}</p>
    {{/if}}
  </div>

</div>
