<!-- PARTIAL : ATTRIBUTS -->
<div class="attributs-grid">

  <!-- ASPECTS -->
  <div class="aspects-section">
    <h3 class="section-title">{{localize "AGONE.Aspects"}}</h3>
    <div class="aspects-row">

      <!-- CORPS -->
      <div class="aspect-block">
        <h4 class="aspect-header">{{localize "AGONE.Corps"}}</h4>
        <div class="aspect-values">
          <div class="aspect-stat">
            <label>{{localize "AGONE.Corps"}}</label>
            <input type="number" name="system.corps.score" value="{{system.corps.score}}" class="stat-num aspect-num" />
          </div>
          <div class="aspect-stat noir">
            <label>{{localize "AGONE.Noir"}}</label>
            <input type="number" name="system.corps.noir" value="{{system.corps.noir}}" class="stat-num aspect-num" />
          </div>
          <div class="aspect-stat derived">
            <label>{{localize "AGONE.Bonus"}}</label>
            <span class="derived-val">{{system.bonusCorps}}</span>
          </div>
          {{#unless modeCreation}}
          <div class="aspect-stat levelup">
            <button type="button" class="levelup-btn" data-action="levelUp"
                    data-type="aspect" data-key="corps" data-cout="{{xpCout.corps}}" data-crea-cout="{{creaCout.corps}}"
                    title='{{localize "AGONE.MonterNiveau"}} ({{xpCout.corps}} XP)'>
              <i class="fas fa-arrow-up"></i> {{xpCout.corps}}
            </button>
          </div>
          {{/unless}}
        </div>
      </div>

      <!-- ESPRIT -->
      <div class="aspect-block">
        <h4 class="aspect-header">{{localize "AGONE.Esprit"}}</h4>
        <div class="aspect-values">
          <div class="aspect-stat">
            <label>{{localize "AGONE.Esprit"}}</label>
            <input type="number" name="system.esprit.score" value="{{system.esprit.score}}" class="stat-num aspect-num" />
          </div>
          <div class="aspect-stat noir">
            <label>{{localize "AGONE.Noir"}}</label>
            <input type="number" name="system.esprit.noir" value="{{system.esprit.noir}}" class="stat-num aspect-num" />
          </div>
          <div class="aspect-stat derived">
            <label>{{localize "AGONE.Bonus"}}</label>
            <span class="derived-val">{{system.bonusEsprit}}</span>
          </div>
          {{#unless modeCreation}}
          <div class="aspect-stat levelup">
            <button type="button" class="levelup-btn" data-action="levelUp"
                    data-type="aspect" data-key="esprit" data-cout="{{xpCout.esprit}}" data-crea-cout="{{creaCout.esprit}}"
                    title='{{localize "AGONE.MonterNiveau"}} ({{xpCout.esprit}} XP)'>
              <i class="fas fa-arrow-up"></i> {{xpCout.esprit}}
            </button>
          </div>
          {{/unless}}
        </div>
      </div>

      <!-- ÂME -->
      <div class="aspect-block">
        <h4 class="aspect-header">{{localize "AGONE.Ame"}}</h4>
        <div class="aspect-values">
          <div class="aspect-stat">
            <label>{{localize "AGONE.Ame"}}</label>
            <input type="number" name="system.ame.score" value="{{system.ame.score}}" class="stat-num aspect-num" />
          </div>
          <div class="aspect-stat noir">
            <label>{{localize "AGONE.Noir"}}</label>
            <input type="number" name="system.ame.noir" value="{{system.ame.noir}}" class="stat-num aspect-num" />
          </div>
          <div class="aspect-stat derived">
            <label>{{localize "AGONE.Bonus"}}</label>
            <span class="derived-val">{{system.bonusAme}}</span>
          </div>
          {{#unless modeCreation}}
          <div class="aspect-stat levelup">
            <button type="button" class="levelup-btn" data-action="levelUp"
                    data-type="aspect" data-key="ame" data-cout="{{xpCout.ame}}" data-crea-cout="{{creaCout.ame}}"
                    title='{{localize "AGONE.MonterNiveau"}} ({{xpCout.ame}} XP)'>
              <i class="fas fa-arrow-up"></i> {{xpCout.ame}}
            </button>
          </div>
          {{/unless}}
        </div>
      </div>

    </div><!-- /aspects-row -->

    <!-- Totaux Flamme -->
    <div class="flamme-totaux">
      <div class="flamme-box">
        <label>{{localize "AGONE.Flamme"}}</label>
        <span class="derived-big">{{system.flamme}}</span>
      </div>
      <div class="flamme-box">
        <label>{{localize "AGONE.FlammeNoire"}}</label>
        <span class="derived-big noir">{{system.flammeNoire}}</span>
      </div>
    </div>
  </div><!-- /aspects-section -->

  <!-- CARACTÉRISTIQUES -->
  <div class="carac-section">
    <h3 class="section-title">{{localize "AGONE.Caracteristiques"}}</h3>

    <div class="carac-grid">
      {{!-- Agilité (Corps) --}}
      <div class="carac-row{{#if caracBelowMin.agilite}} carac-min-requis{{/if}}">
        <button type="button" class="roll-btn stat-label" data-action="rollAttribut" data-carac="agilite"
                title='{{localize "AGONE.JeterDe"}} {{localize "AGONE.Attribut.Agilite"}}'>{{localize "AGONE.Attribut.Agilite"}}</button>
        <input type="number" name="system.agilite.score" value="{{system.agilite.score}}" class="stat-num"
               {{#if caracBelowMin.agilite}}title='{{localize "AGONE.MinRacialRequis"}}'{{/if}} />
        <input type="number" name="system.agilite.exp" value="{{system.agilite.exp}}" class="stat-num exp" title="Exp." />
        <button type="button" class="levelup-btn" data-action="levelUp"
                data-type="carac" data-key="agilite" data-cout="{{xpCout.agilite}}" data-crea-cout="{{creaCout.agilite}}"
                title='{{#if caracAtMax.agilite}}{{localize "AGONE.MaxRacialAtteint"}} (max : {{caracEffectiveMax.agilite}}){{else}}{{localize "AGONE.MonterNiveau"}} ({{coutAffiche.agilite}}){{/if}}'
                {{#if caracAtMax.agilite}}disabled{{/if}}>
          <i class="fas fa-arrow-up"></i> {{coutAffiche.agilite}}
        </button>
      </div>
      {{!-- Force (Corps) --}}
      <div class="carac-row{{#if caracBelowMin.force}} carac-min-requis{{/if}}">
        <button type="button" class="roll-btn stat-label" data-action="rollAttribut" data-carac="force"
                title='{{localize "AGONE.JeterDe"}} {{localize "AGONE.Attribut.Force"}}'>{{localize "AGONE.Attribut.Force"}}</button>
        <input type="number" name="system.force.score" value="{{system.force.score}}" class="stat-num"
               {{#if caracBelowMin.force}}title='{{localize "AGONE.MinRacialRequis"}}'{{/if}} />
        <input type="number" name="system.force.exp" value="{{system.force.exp}}" class="stat-num exp" title="Exp." />
        <button type="button" class="levelup-btn" data-action="levelUp"
                data-type="carac" data-key="force" data-cout="{{xpCout.force}}" data-crea-cout="{{creaCout.force}}"
                title='{{#if caracAtMax.force}}{{localize "AGONE.MaxRacialAtteint"}} (max : {{caracEffectiveMax.force}}){{else}}{{localize "AGONE.MonterNiveau"}} ({{coutAffiche.force}}){{/if}}'
                {{#if caracAtMax.force}}disabled{{/if}}>
          <i class="fas fa-arrow-up"></i> {{coutAffiche.force}}
        </button>
      </div>
      {{!-- Perception (Corps) --}}
      <div class="carac-row{{#if caracBelowMin.perception}} carac-min-requis{{/if}}">
        <button type="button" class="roll-btn stat-label" data-action="rollAttribut" data-carac="perception"
                title='{{localize "AGONE.JeterDe"}} {{localize "AGONE.Attribut.Perception"}}'>{{localize "AGONE.Attribut.Perception"}}</button>
        <input type="number" name="system.perception.score" value="{{system.perception.score}}" class="stat-num"
               {{#if caracBelowMin.perception}}title='{{localize "AGONE.MinRacialRequis"}}'{{/if}} />
        <input type="number" name="system.perception.exp" value="{{system.perception.exp}}" class="stat-num exp" title="Exp." />
        <button type="button" class="levelup-btn" data-action="levelUp"
                data-type="carac" data-key="perception" data-cout="{{xpCout.perception}}" data-crea-cout="{{creaCout.perception}}"
                title='{{#if caracAtMax.perception}}{{localize "AGONE.MaxRacialAtteint"}} (max : {{caracEffectiveMax.perception}}){{else}}{{localize "AGONE.MonterNiveau"}} ({{coutAffiche.perception}}){{/if}}'
                {{#if caracAtMax.perception}}disabled{{/if}}>
          <i class="fas fa-arrow-up"></i> {{coutAffiche.perception}}
        </button>
      </div>
      {{!-- Résistance (Corps) --}}
      <div class="carac-row{{#if caracBelowMin.resistance}} carac-min-requis{{/if}}">
        <button type="button" class="roll-btn stat-label" data-action="rollAttribut" data-carac="resistance"
                title='{{localize "AGONE.JeterDe"}} {{localize "AGONE.Attribut.Resistance"}}'>{{localize "AGONE.Attribut.Resistance"}}</button>
        <input type="number" name="system.resistance.score" value="{{system.resistance.score}}" class="stat-num"
               {{#if caracBelowMin.resistance}}title='{{localize "AGONE.MinRacialRequis"}}'{{/if}} />
        <input type="number" name="system.resistance.exp" value="{{system.resistance.exp}}" class="stat-num exp" title="Exp." />
        <button type="button" class="levelup-btn" data-action="levelUp"
                data-type="carac" data-key="resistance" data-cout="{{xpCout.resistance}}" data-crea-cout="{{creaCout.resistance}}"
                title='{{#if caracAtMax.resistance}}{{localize "AGONE.MaxRacialAtteint"}} (max : {{caracEffectiveMax.resistance}}){{else}}{{localize "AGONE.MonterNiveau"}} ({{coutAffiche.resistance}}){{/if}}'
                {{#if caracAtMax.resistance}}disabled{{/if}}>
          <i class="fas fa-arrow-up"></i> {{coutAffiche.resistance}}
        </button>
      </div>
      {{!-- Intelligence (Esprit) --}}
      <div class="carac-row{{#if caracBelowMin.intelligence}} carac-min-requis{{/if}}">
        <button type="button" class="roll-btn stat-label" data-action="rollAttribut" data-carac="intelligence"
                title='{{localize "AGONE.JeterDe"}} {{localize "AGONE.Attribut.Intelligence"}}'>{{localize "AGONE.Attribut.Intelligence"}}</button>
        <input type="number" name="system.intelligence.score" value="{{system.intelligence.score}}" class="stat-num"
               {{#if caracBelowMin.intelligence}}title='{{localize "AGONE.MinRacialRequis"}}'{{/if}} />
        <input type="number" name="system.intelligence.exp" value="{{system.intelligence.exp}}" class="stat-num exp" title="Exp." />
        <button type="button" class="levelup-btn" data-action="levelUp"
                data-type="carac" data-key="intelligence" data-cout="{{xpCout.intelligence}}" data-crea-cout="{{creaCout.intelligence}}"
                title='{{#if caracAtMax.intelligence}}{{localize "AGONE.MaxRacialAtteint"}} (max : {{caracEffectiveMax.intelligence}}){{else}}{{localize "AGONE.MonterNiveau"}} ({{coutAffiche.intelligence}}){{/if}}'
                {{#if caracAtMax.intelligence}}disabled{{/if}}>
          <i class="fas fa-arrow-up"></i> {{coutAffiche.intelligence}}
        </button>
      </div>
      {{!-- Volonté (Esprit) --}}
      <div class="carac-row{{#if caracBelowMin.volonte}} carac-min-requis{{/if}}">
        <button type="button" class="roll-btn stat-label" data-action="rollAttribut" data-carac="volonte"
                title='{{localize "AGONE.JeterDe"}} {{localize "AGONE.Attribut.Volonte"}}'>{{localize "AGONE.Attribut.Volonte"}}</button>
        <input type="number" name="system.volonte.score" value="{{system.volonte.score}}" class="stat-num"
               {{#if caracBelowMin.volonte}}title='{{localize "AGONE.MinRacialRequis"}}'{{/if}} />
        <input type="number" name="system.volonte.exp" value="{{system.volonte.exp}}" class="stat-num exp" title="Exp." />
        <button type="button" class="levelup-btn" data-action="levelUp"
                data-type="carac" data-key="volonte" data-cout="{{xpCout.volonte}}" data-crea-cout="{{creaCout.volonte}}"
                title='{{#if caracAtMax.volonte}}{{localize "AGONE.MaxRacialAtteint"}} (max : {{caracEffectiveMax.volonte}}){{else}}{{localize "AGONE.MonterNiveau"}} ({{coutAffiche.volonte}}){{/if}}'
                {{#if caracAtMax.volonte}}disabled{{/if}}>
          <i class="fas fa-arrow-up"></i> {{coutAffiche.volonte}}
        </button>
      </div>
      {{!-- Charisme (Âme) --}}
      <div class="carac-row{{#if caracBelowMin.charisma}} carac-min-requis{{/if}}">
        <button type="button" class="roll-btn stat-label" data-action="rollAttribut" data-carac="charisma"
                title='{{localize "AGONE.JeterDe"}} {{localize "AGONE.Attribut.Charisma"}}'>{{localize "AGONE.Attribut.Charisma"}}</button>
        <input type="number" name="system.charisma.score" value="{{system.charisma.score}}" class="stat-num"
               {{#if caracBelowMin.charisma}}title='{{localize "AGONE.MinRacialRequis"}}'{{/if}} />
        <input type="number" name="system.charisma.exp" value="{{system.charisma.exp}}" class="stat-num exp" title="Exp." />
        <button type="button" class="levelup-btn" data-action="levelUp"
                data-type="carac" data-key="charisma" data-cout="{{xpCout.charisma}}" data-crea-cout="{{creaCout.charisma}}"
                title='{{#if caracAtMax.charisma}}{{localize "AGONE.MaxRacialAtteint"}} (max : {{caracEffectiveMax.charisma}}){{else}}{{localize "AGONE.MonterNiveau"}} ({{coutAffiche.charisma}}){{/if}}'
                {{#if caracAtMax.charisma}}disabled{{/if}}>
          <i class="fas fa-arrow-up"></i> {{coutAffiche.charisma}}
        </button>
      </div>
      {{!-- Créativité (Âme) --}}
      <div class="carac-row{{#if caracBelowMin.creativite}} carac-min-requis{{/if}}">
        <button type="button" class="roll-btn stat-label" data-action="rollAttribut" data-carac="creativite"
                title='{{localize "AGONE.JeterDe"}} {{localize "AGONE.Attribut.Creativite"}}'>{{localize "AGONE.Attribut.Creativite"}}</button>
        <input type="number" name="system.creativite.score" value="{{system.creativite.score}}" class="stat-num"
               {{#if caracBelowMin.creativite}}title='{{localize "AGONE.MinRacialRequis"}}'{{/if}} />
        <input type="number" name="system.creativite.exp" value="{{system.creativite.exp}}" class="stat-num exp" title="Exp." />
        <button type="button" class="levelup-btn" data-action="levelUp"
                data-type="carac" data-key="creativite" data-cout="{{xpCout.creativite}}" data-crea-cout="{{creaCout.creativite}}"
                title='{{#if caracAtMax.creativite}}{{localize "AGONE.MaxRacialAtteint"}} (max : {{caracEffectiveMax.creativite}}){{else}}{{localize "AGONE.MonterNiveau"}} ({{coutAffiche.creativite}}){{/if}}'
                {{#if caracAtMax.creativite}}disabled{{/if}}>
          <i class="fas fa-arrow-up"></i> {{coutAffiche.creativite}}
        </button>
      </div>
    </div>

    <!-- Points de création (visible seulement en mode création) -->
    {{#if modeCreation}}
    <div class="pts-creation-row">
      <div class="pts-creation-block">
        <label>{{localize "AGONE.PtsCreationCarac"}}</label>
        <span class="derived sombre">{{ptsCreationCaracRestant}}</span>
        <span>/</span>
        <span class="derived sombre">{{system.ptsCreationCarac.max}}</span>
        <button type="button" class="btn-icon reset-crea-btn" data-action="resetCaracs" title='{{localize "AGONE.ResetCreationCaracTooltip"}}'>&#8635;</button>
      </div>
    </div>
    {{/if}}

    <!-- Caractéristiques dérivées -->
    <h3 class="section-title">{{localize "AGONE.CaracDerivees"}}</h3>
    <div class="derived-grid">
      <div class="derived-row" title="(FOR + AGI×2) ÷ 3">
        <label>{{localize "AGONE.Melee"}}</label>
        <span class="derived-val">{{system.melee}}</span>
      </div>
      <div class="derived-row" title="(AGI + PER) ÷ 2">
        <label>{{localize "AGONE.Tir"}}</label>
        <span class="derived-val">{{system.tir}}</span>
      </div>
      <div class="derived-row" title="(CHA + CRÉ) ÷ 2">
        <label>{{localize "AGONE.Art"}}</label>
        <span class="derived-val">{{system.art}}</span>
      </div>
      <div class="derived-row" title="AGI + PER + Bonus Corps">
        <label>{{localize "AGONE.Initiative"}}</label>
        <span class="derived-val">{{system.initiative}}</span>
        <button type="button" class="roll-btn-small" data-action="rollInitiative" title='{{localize "AGONE.JeterInitiative"}}'>
          <i class="fas fa-dice-d10"></i>
        </button>
      </div>
      <div class="derived-row" title="Initiative + 10 (sortilège)">
        <label>{{localize "AGONE.InitMagique"}}</label>
        <span class="derived-val">{{system.initMagique}}</span>
      </div>
      <div class="derived-row" title="AGI + Bonus Corps">
        <label>{{localize "AGONE.DefenseNaturelle"}}</label>
        <span class="derived-val">{{system.defenseNaturelle}}</span>
        <button type="button" class="roll-btn-small" data-action="rollDefenseNaturelle" title='{{localize "AGONE.JeterDefenseNat"}}'>
          <i class="fas fa-dice-d10"></i>
        </button>
      </div>
      <div class="derived-row" title="Table FOR + TAI">
        <label>{{localize "AGONE.BD"}}</label>
        <span class="derived-val">{{system.bd}}</span>
      </div>
      <div class="derived-row" title="Compétences Esquive + AGI + Bonus Corps">
        <label>{{localize "AGONE.EsquiveTotal"}}</label>
        <span class="derived-val">{{system.esquiveTotal}}</span>
        <button type="button" class="roll-btn-small" data-action="rollEsquive" title='{{localize "AGONE.JeterEsquive"}}'>
          <i class="fas fa-dice-d10"></i>
        </button>
      </div>
      <div class="derived-row" title="(INT + VOL) ÷ 2">
        <label>{{localize "AGONE.Emprise"}}</label>
        <span class="derived-val">{{system.emprise}}</span>
      </div>
    </div><!-- /derived-grid -->
  </div><!-- /carac-section -->
</div><!-- /attributs-grid -->
