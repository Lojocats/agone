        </button>
        <button type="button" class="leveldown-btn" data-action="levelDown"
                data-type="carac" data-key="intelligence"
                title='{{localize "AGONE.RetrograderNiveau"}}'
                {{#unless system.intelligence.score}}disabled{{/unless}}>
          <i class="fas fa-arrow-down"></i> {{coutAfficheDown.intelligence}}
        </button>{{/if}}
      </div>
      {{!-- Volonté (Esprit) --}}
      <div class="carac-row{{#if caracBelowMin.volonte}} carac-min-requis{{/if}}">
        <button type="button" class="roll-btn stat-label" data-action="rollAttribut" data-carac="volonte"
                title='{{localize "AGONE.JeterDe"}} {{localize "AGONE.Attribut.Volonte"}}'>{{localize "AGONE.Attribut.Volonte"}}</button>
        <input type="number" name="system.volonte.score" value="{{system.volonte.score}}" class="stat-num"
               {{#if caracBelowMin.volonte}}title='{{localize "AGONE.MinRacialRequis"}}'{{/if}} />
        <input type="number" name="system.volonte.exp" value="{{system.volonte.exp}}" class="stat-num exp" title="Exp." />
        {{#if showLevelUp}}<button type="button" class="levelup-btn" data-action="levelUp"
                data-type="carac" data-key="volonte" data-cout="{{xpCout.volonte}}" data-crea-cout="{{creaCout.volonte}}"
                title='{{#if caracAtMax.volonte}}{{localize "AGONE.MaxRacialAtteint"}} (max : {{caracEffectiveMax.volonte}}){{else}}{{localize "AGONE.MonterNiveau"}} ({{coutAffiche.volonte}}){{/if}}'
                {{#if caracAtMax.volonte}}disabled{{/if}}>
          <i class="fas fa-arrow-up"></i> {{coutAffiche.volonte}}
        </button>
        <button type="button" class="leveldown-btn" data-action="levelDown"
                data-type="carac" data-key="volonte"
                title='{{localize "AGONE.RetrograderNiveau"}}'
                {{#unless system.volonte.score}}disabled{{/unless}}>
          <i class="fas fa-arrow-down"></i> {{coutAfficheDown.volonte}}
        </button>{{/if}}
      </div>
      </div>{{!-- /carac-aspect-group Esprit --}}

      <div class="carac-aspect-group">
        <h4 class="carac-aspect-label">{{localize "AGONE.Ame"}}</h4>
      {{!-- Charisme (Âme) --}}
      <div class="carac-row{{#if caracBelowMin.charisma}} carac-min-requis{{/if}}">
        <button type="button" class="roll-btn stat-label" data-action="rollAttribut" data-carac="charisma"
                title='{{localize "AGONE.JeterDe"}} {{localize "AGONE.Attribut.Charisma"}}'>{{localize "AGONE.Attribut.Charisma"}}</button>
        <input type="number" name="system.charisma.score" value="{{system.charisma.score}}" class="stat-num"
               {{#if caracBelowMin.charisma}}title='{{localize "AGONE.MinRacialRequis"}}'{{/if}} />
        <input type="number" name="system.charisma.exp" value="{{system.charisma.exp}}" class="stat-num exp" title="Exp." />
        {{#if showLevelUp}}<button type="button" class="levelup-btn" data-action="levelUp"
                data-type="carac" data-key="charisma" data-cout="{{xpCout.charisma}}" data-crea-cout="{{creaCout.charisma}}"
                title='{{#if caracAtMax.charisma}}{{localize "AGONE.MaxRacialAtteint"}} (max : {{caracEffectiveMax.charisma}}){{else}}{{localize "AGONE.MonterNiveau"}} ({{coutAffiche.charisma}}){{/if}}'
                {{#if caracAtMax.charisma}}disabled{{/if}}>
