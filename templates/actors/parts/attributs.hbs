        <input type="number" name="system.intelligence.score" value="{{system.intelligence.score}}" class="stat-num"
               {{#if caracBelowMin.intelligence}}title='{{localize "AGONE.MinRacialRequis"}}'{{/if}} />
        <input type="number" name="system.intelligence.exp" value="{{system.intelligence.exp}}" class="stat-num exp" title="Exp." />
        {{#if showLevelUp}}<button type="button" class="levelup-btn" data-action="levelUp"
                data-type="carac" data-key="intelligence" data-cout="{{xpCout.intelligence}}" data-crea-cout="{{creaCout.intelligence}}"
                title='{{#if caracAtMax.intelligence}}{{localize "AGONE.MaxRacialAtteint"}} (max : {{caracEffectiveMax.intelligence}}){{else}}{{localize "AGONE.MonterNiveau"}} ({{coutAffiche.intelligence}}){{/if}}'
                {{#if caracAtMax.intelligence}}disabled{{/if}}>
