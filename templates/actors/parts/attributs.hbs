<!-- PARTIAL : ATTRIBUTS -->
<div class="attributs-grid">

  <!-- ASPECTS -->
  <div class="aspects-section">
    <h3 class="section-title">{{localize "AGONE.Aspects"}}</h3>
    <div class="aspects-row">

      <!-- CORPS -->
      <div class="aspect-block">
        <h4 class="aspect-header">{{localize "AGONE.Corps"}}</h4>
        <div class="aspect-values">
          <div class="aspect-stat">
            <label>{{localize "AGONE.Corps"}}</label>
            <input type="number" name="system.corps.score" value="{{system.corps.score}}" class="stat-num aspect-num" />
            <label class="exp-label">exp.</label>
            <input type="number" name="system.corps.exp" value="{{system.corps.exp}}" class="stat-num aspect-num exp" title="Exp. réservée Corps" />
          </div>
          <div class="aspect-stat noir">
            <label>{{localize "AGONE.Noir"}}</label>
            <span class="derived-val noir-val">{{system.corpsNoirTotal}}</span>
            <input type="number" name="system.corps.noir" value="{{system.corps.noir}}" class="stat-num aspect-num noir-base" title="Valeur de base (total = base + Ténèbres + Peines)" />
          </div>
          <div class="aspect-stat derived">
            <label>{{localize "AGONE.Bonus"}}</label>
            <span class="derived-val">{{system.bonusCorps}}</span>
          </div>
          {{#if showLevelUpAspect}}
          <div class="aspect-stat levelup">
            <button type="button" class="levelup-btn" data-action="levelUp"
                    data-type="aspect" data-key="corps" data-cout="{{xpCout.corps}}" data-crea-cout="{{creaCout.corps}}"
                    title='{{localize "AGONE.MonterNiveau"}} ({{xpCout.corps}} XP)'>
              <i class="fas fa-arrow-up"></i> {{xpCout.corps}}
            </button>
            <button type="button" class="leveldown-btn" data-action="levelDown"
                    data-type="aspect" data-key="corps"
                    title='{{localize "AGONE.RetrograderNiveau"}}'
                    {{#unless system.corps.score}}disabled{{/unless}}>
              <i class="fas fa-arrow-down"></i> {{coutAfficheDown.corps}}
            </button>
          </div>
          {{/if}}
        </div>
      </div>

      <!-- ESPRIT -->
      <div class="aspect-block">
        <h4 class="aspect-header">{{localize "AGONE.Esprit"}}</h4>
        <div class="aspect-values">
          <div class="aspect-stat">
            <label>{{localize "AGONE.Esprit"}}</label>
            <input type="number" name="system.esprit.score" value="{{system.esprit.score}}" class="stat-num aspect-num" />
            <label class="exp-label">exp.</label>
            <input type="number" name="system.esprit.exp" value="{{system.esprit.exp}}" class="stat-num aspect-num exp" title="Exp. réservée Esprit" />
          </div>
          <div class="aspect-stat noir">
            <label>{{localize "AGONE.Noir"}}</label>
            <span class="derived-val noir-val">{{system.espritNoirTotal}}</span>
            <input type="number" name="system.esprit.noir" value="{{system.esprit.noir}}" class="stat-num aspect-num noir-base" title="Valeur de base (total = base + Ténèbres + Peines)" />
          </div>
          <div class="aspect-stat derived">
            <label>{{localize "AGONE.Bonus"}}</label>
            <span class="derived-val">{{system.bonusEsprit}}</span>
          </div>
          {{#if showLevelUpAspect}}
          <div class="aspect-stat levelup">
            <button type="button" class="levelup-btn" data-action="levelUp"
                    data-type="aspect" data-key="esprit" data-cout="{{xpCout.esprit}}" data-crea-cout="{{creaCout.esprit}}"
                    title='{{localize "AGONE.MonterNiveau"}} ({{xpCout.esprit}} XP)'>
              <i class="fas fa-arrow-up"></i> {{xpCout.esprit}}
            </button>
            <button type="button" class="leveldown-btn" data-action="levelDown"
                    data-type="aspect" data-key="esprit"
                    title='{{localize "AGONE.RetrograderNiveau"}}'
                    {{#unless system.esprit.score}}disabled{{/unless}}>
              <i class="fas fa-arrow-down"></i> {{coutAfficheDown.esprit}}
            </button>
          </div>
          {{/if}}
        </div>
      </div>

      <!-- ÂME -->
      <div class="aspect-block">
        <h4 class="aspect-header">{{localize "AGONE.Ame"}}</h4>
        <div class="aspect-values">
          <div class="aspect-stat">
            <label>{{localize "AGONE.Ame"}}</label>
            <input type="number" name="system.ame.score" value="{{system.ame.score}}" class="stat-num aspect-num" />
            <label class="exp-label">exp.</label>
            <input type="number" name="system.ame.exp" value="{{system.ame.exp}}" class="stat-num aspect-num exp" title="Exp. réservée Âme" />
          </div>
          <div class="aspect-stat noir">
            <label>{{localize "AGONE.Noir"}}</label>
            <span class="derived-val noir-val">{{system.ameNoirTotal}}</span>
            <input type="number" name="system.ame.noir" value="{{system.ame.noir}}" class="stat-num aspect-num noir-base" title="Valeur de base (total = base + Ténèbres + Peines)" />
          </div>
          <div class="aspect-stat derived">
            <label>{{localize "AGONE.Bonus"}}</label>
            <span class="derived-val">{{system.bonusAme}}</span>
          </div>
          {{#if showLevelUpAspect}}
          <div class="aspect-stat levelup">
            <button type="button" class="levelup-btn" data-action="levelUp"
                    data-type="aspect" data-key="ame" data-cout="{{xpCout.ame}}" data-crea-cout="{{creaCout.ame}}"
                    title='{{localize "AGONE.MonterNiveau"}} ({{xpCout.ame}} XP)'>
              <i class="fas fa-arrow-up"></i> {{xpCout.ame}}
            </button>
            <button type="button" class="leveldown-btn" data-action="levelDown"
                    data-type="aspect" data-key="ame"
                    title='{{localize "AGONE.RetrograderNiveau"}}'
                    {{#unless system.ame.score}}disabled{{/unless}}>
              <i class="fas fa-arrow-down"></i> {{coutAfficheDown.ame}}
            </button>
          </div>
          {{/if}}
        </div>
      </div>

    </div><!-- /aspects-row -->

    <!-- Totaux Flamme -->
    <div class="flamme-totaux">
      <div class="flamme-box">
        <label>{{localize "AGONE.Flamme"}}</label>
        <span class="derived-big">{{system.flamme}}</span>
      </div>
      <div class="flamme-box">
        <label>{{localize "AGONE.FlammeNoire"}}</label>
        <span class="derived-big noir">{{system.flammeNoire}}</span>
      </div>
    </div>

    <!-- Caractéristiques dérivées -->
    <h3 class="section-title">{{localize "AGONE.CaracDerivees"}}</h3>
    <div class="derived-grid">

      <div class="cstat-item" title="(FOR + AGI×2) ÷ 3">
        <span class="cstat-roll cstat-passive"><i class="fas fa-fist-raised"></i></span>
        <span class="cstat-score">{{system.melee}}</span>
        <span class="cstat-label">{{localize "AGONE.Melee"}}</span>
      </div>

      <div class="cstat-item" title="(AGI + PER) ÷ 2">
        <span class="cstat-roll cstat-passive"><i class="fas fa-crosshairs"></i></span>
        <span class="cstat-score">{{system.tir}}</span>
        <span class="cstat-label">{{localize "AGONE.Tir"}}</span>
      </div>

      <div class="cstat-item" title="(CHA + CRÉ) ÷ 2">
        <span class="cstat-roll cstat-passive"><i class="fas fa-palette"></i></span>
        <span class="cstat-score">{{system.art}}</span>
        <span class="cstat-label">{{localize "AGONE.Art"}}</span>
      </div>

      <div class="cstat-item" title="AGI + PER + Bonus Corps">
        <button type="button" class="cstat-roll" data-action="rollInitiative" title='{{localize "AGONE.JeterInitiative"}}'><i class="fas fa-bolt"></i></button>
        <span class="cstat-score">{{system.initiative}}</span>
        <span class="cstat-label">{{localize "AGONE.Initiative"}}</span>
      </div>

      <div class="cstat-item" title="Initiative + 10 (sortilège)">
        <button type="button" class="cstat-roll" data-action="rollInitiativeMagique" title='{{localize "AGONE.JeterInitMagique"}}'><i class="fas fa-magic"></i></button>
        <span class="cstat-score">{{system.initMagique}}</span>
        <span class="cstat-label">{{localize "AGONE.InitMagique"}}</span>
      </div>

      <div class="cstat-item" title="AGI + Bonus Corps">
        <button type="button" class="cstat-roll" data-action="rollDefenseNaturelle" title='{{localize "AGONE.JeterDefenseNat"}}'><i class="fas fa-shield-alt"></i></button>
        <span class="cstat-score">{{system.defenseNaturelle}}</span>
        <span class="cstat-label">{{localize "AGONE.DefenseNaturelle"}}</span>
      </div>

      <div class="cstat-item" title="Table FOR + TAI">
        <span class="cstat-roll cstat-passive"><i class="fas fa-hammer"></i></span>
        <span class="cstat-score">{{system.bd}}</span>
        <span class="cstat-label">{{localize "AGONE.BD"}}</span>
      </div>

      <div class="cstat-item" title="Compétences Esquive + AGI + Bonus Corps">
        <button type="button" class="cstat-roll" data-action="rollEsquive" title='{{localize "AGONE.JeterEsquive"}}'><i class="fas fa-running"></i></button>
        <span class="cstat-score">{{system.esquiveTotal}}</span>
        <span class="cstat-label">{{localize "AGONE.EsquiveTotal"}}</span>
      </div>

      <div class="cstat-item cstat-emprise">
        <span class="cstat-roll cstat-passive"><i class="fas fa-fire"></i></span>
        <span class="cstat-score">{{system.emprise}}</span>
        <div class="cstat-emprise-wrap">
          <span class="cstat-label">{{localize "AGONE.Emprise"}}</span>
          <select name="system.typeMage" class="emprise-type-select" title="Obédience magique">
            <option value="jorniste"      {{#if (eq system.typeMage "jorniste")}}selected{{/if}}>Jorniste (INT)</option>
            <option value="eclipsiste"    {{#if (eq system.typeMage "eclipsiste")}}selected{{/if}}>Éclipsiste (INT+VOL/2)</option>
            <option value="obscurantiste" {{#if (eq system.typeMage "obscurantiste")}}selected{{/if}}>Obscurantiste (VOL)</option>
          </select>
        </div>
      </div>

    </div><!-- /derived-grid -->
  </div><!-- /aspects-section -->

  <!-- CARACTÉRISTIQUES -->
  <div class="carac-section">
    <h3 class="section-title">{{localize "AGONE.Caracteristiques"}}</h3>

    <div class="carac-grid">

      <div class="carac-aspect-group">
        <h4 class="carac-aspect-label">{{localize "AGONE.Corps"}}</h4>
      {{!-- Agilité (Corps) --}}
      <div class="carac-row{{#if caracBelowMin.agilite}} carac-min-requis{{/if}}">
        <button type="button" class="roll-btn stat-label" data-action="rollAttribut" data-carac="agilite"
                title='{{localize "AGONE.JeterDe"}} {{localize "AGONE.Attribut.Agilite"}}'>{{localize "AGONE.Attribut.Agilite"}}</button>
        <input type="number" name="system.agilite.score" value="{{system.agilite.score}}" class="stat-num"
               {{#if caracBelowMin.agilite}}title='{{localize "AGONE.MinRacialRequis"}}'{{/if}} />
        <input type="number" name="system.agilite.exp" value="{{system.agilite.exp}}" class="stat-num exp" title="Exp." />
        {{#if showLevelUp}}<button type="button" class="levelup-btn" data-action="levelUp"
                data-type="carac" data-key="agilite" data-cout="{{xpCout.agilite}}" data-crea-cout="{{creaCout.agilite}}"
                title='{{#if caracAtMax.agilite}}{{localize "AGONE.MaxRacialAtteint"}} (max : {{caracEffectiveMax.agilite}}){{else}}{{localize "AGONE.MonterNiveau"}} ({{coutAffiche.agilite}}){{/if}}'
                {{#if caracAtMax.agilite}}disabled{{/if}}>
          <i class="fas fa-arrow-up"></i> {{coutAffiche.agilite}}
        </button>
        <button type="button" class="leveldown-btn" data-action="levelDown"
                data-type="carac" data-key="agilite"
                title='{{localize "AGONE.RetrograderNiveau"}}'
                {{#unless system.agilite.score}}disabled{{/unless}}>
          <i class="fas fa-arrow-down"></i> {{coutAfficheDown.agilite}}
        </button>{{/if}}
      </div>
      {{!-- Force (Corps) --}}
      <div class="carac-row{{#if caracBelowMin.force}} carac-min-requis{{/if}}">
        <button type="button" class="roll-btn stat-label" data-action="rollAttribut" data-carac="force"
                title='{{localize "AGONE.JeterDe"}} {{localize "AGONE.Attribut.Force"}}'>{{localize "AGONE.Attribut.Force"}}</button>
        <input type="number" name="system.force.score" value="{{system.force.score}}" class="stat-num"
               {{#if caracBelowMin.force}}title='{{localize "AGONE.MinRacialRequis"}}'{{/if}} />
        <input type="number" name="system.force.exp" value="{{system.force.exp}}" class="stat-num exp" title="Exp." />
        {{#if showLevelUp}}<button type="button" class="levelup-btn" data-action="levelUp"
                data-type="carac" data-key="force" data-cout="{{xpCout.force}}" data-crea-cout="{{creaCout.force}}"
                title='{{#if caracAtMax.force}}{{localize "AGONE.MaxRacialAtteint"}} (max : {{caracEffectiveMax.force}}){{else}}{{localize "AGONE.MonterNiveau"}} ({{coutAffiche.force}}){{/if}}'
                {{#if caracAtMax.force}}disabled{{/if}}>
          <i class="fas fa-arrow-up"></i> {{coutAffiche.force}}
        </button>
        <button type="button" class="leveldown-btn" data-action="levelDown"
                data-type="carac" data-key="force"
                title='{{localize "AGONE.RetrograderNiveau"}}'
                {{#unless system.force.score}}disabled{{/unless}}>
          <i class="fas fa-arrow-down"></i> {{coutAfficheDown.force}}
        </button>{{/if}}
      </div>
      {{!-- Perception (Corps) --}}
      <div class="carac-row{{#if caracBelowMin.perception}} carac-min-requis{{/if}}">
        <button type="button" class="roll-btn stat-label" data-action="rollAttribut" data-carac="perception"
                title='{{localize "AGONE.JeterDe"}} {{localize "AGONE.Attribut.Perception"}}'>{{localize "AGONE.Attribut.Perception"}}</button>
        <input type="number" name="system.perception.score" value="{{system.perception.score}}" class="stat-num"
               {{#if caracBelowMin.perception}}title='{{localize "AGONE.MinRacialRequis"}}'{{/if}} />
        <input type="number" name="system.perception.exp" value="{{system.perception.exp}}" class="stat-num exp" title="Exp." />
        {{#if showLevelUp}}<button type="button" class="levelup-btn" data-action="levelUp"
                data-type="carac" data-key="perception" data-cout="{{xpCout.perception}}" data-crea-cout="{{creaCout.perception}}"
                title='{{#if caracAtMax.perception}}{{localize "AGONE.MaxRacialAtteint"}} (max : {{caracEffectiveMax.perception}}){{else}}{{localize "AGONE.MonterNiveau"}} ({{coutAffiche.perception}}){{/if}}'
                {{#if caracAtMax.perception}}disabled{{/if}}>
          <i class="fas fa-arrow-up"></i> {{coutAffiche.perception}}
        </button>
        <button type="button" class="leveldown-btn" data-action="levelDown"
                data-type="carac" data-key="perception"
                title='{{localize "AGONE.RetrograderNiveau"}}'
                {{#unless system.perception.score}}disabled{{/unless}}>
          <i class="fas fa-arrow-down"></i> {{coutAfficheDown.perception}}
        </button>{{/if}}
      </div>
      {{!-- Résistance (Corps) --}}
      <div class="carac-row{{#if caracBelowMin.resistance}} carac-min-requis{{/if}}">
        <button type="button" class="roll-btn stat-label" data-action="rollAttribut" data-carac="resistance"
                title='{{localize "AGONE.JeterDe"}} {{localize "AGONE.Attribut.Resistance"}}'>{{localize "AGONE.Attribut.Resistance"}}</button>
        <input type="number" name="system.resistance.score" value="{{system.resistance.score}}" class="stat-num"
               {{#if caracBelowMin.resistance}}title='{{localize "AGONE.MinRacialRequis"}}'{{/if}} />
        <input type="number" name="system.resistance.exp" value="{{system.resistance.exp}}" class="stat-num exp" title="Exp." />
        {{#if showLevelUp}}<button type="button" class="levelup-btn" data-action="levelUp"
                data-type="carac" data-key="resistance" data-cout="{{xpCout.resistance}}" data-crea-cout="{{creaCout.resistance}}"
                title='{{#if caracAtMax.resistance}}{{localize "AGONE.MaxRacialAtteint"}} (max : {{caracEffectiveMax.resistance}}){{else}}{{localize "AGONE.MonterNiveau"}} ({{coutAffiche.resistance}}){{/if}}'
                {{#if caracAtMax.resistance}}disabled{{/if}}>
          <i class="fas fa-arrow-up"></i> {{coutAffiche.resistance}}
        </button>
        <button type="button" class="leveldown-btn" data-action="levelDown"
                data-type="carac" data-key="resistance"
                title='{{localize "AGONE.RetrograderNiveau"}}'
                {{#unless system.resistance.score}}disabled{{/unless}}>
          <i class="fas fa-arrow-down"></i> {{coutAfficheDown.resistance}}
        </button>{{/if}}
      </div>
      </div>{{!-- /carac-aspect-group Corps --}}

      <div class="carac-aspect-group">
        <h4 class="carac-aspect-label">{{localize "AGONE.Esprit"}}</h4>
      {{!-- Intelligence (Esprit) --}}
