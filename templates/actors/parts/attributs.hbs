        <button type="button" class="leveldown-btn" data-action="levelDown"
                data-type="carac" data-key="charisma"
                title='{{localize "AGONE.RetrograderNiveau"}}'
                {{#unless system.charisma.score}}disabled{{/unless}}>
          <i class="fas fa-arrow-down"></i> {{coutAfficheDown.charisma}}
        </button>{{/if}}
      </div>
      {{!-- Créativité (Âme) --}}
      <div class="carac-row{{#if caracBelowMin.creativite}} carac-min-requis{{/if}}">
        <button type="button" class="roll-btn stat-label" data-action="rollAttribut" data-carac="creativite"
                title='{{localize "AGONE.JeterDe"}} {{localize "AGONE.Attribut.Creativite"}}'>{{localize "AGONE.Attribut.Creativite"}}</button>
        <input type="number" name="system.creativite.score" value="{{system.creativite.score}}" class="stat-num"
               {{#if caracBelowMin.creativite}}title='{{localize "AGONE.MinRacialRequis"}}'{{/if}} />
        <input type="number" name="system.creativite.exp" value="{{system.creativite.exp}}" class="stat-num exp" title="Exp." />
        {{#if showLevelUp}}<button type="button" class="levelup-btn" data-action="levelUp"
                data-type="carac" data-key="creativite" data-cout="{{xpCout.creativite}}" data-crea-cout="{{creaCout.creativite}}"
                title='{{#if caracAtMax.creativite}}{{localize "AGONE.MaxRacialAtteint"}} (max : {{caracEffectiveMax.creativite}}){{else}}{{localize "AGONE.MonterNiveau"}} ({{coutAffiche.creativite}}){{/if}}'
                {{#if caracAtMax.creativite}}disabled{{/if}}>
          <i class="fas fa-arrow-up"></i> {{coutAffiche.creativite}}
        </button>
        <button type="button" class="leveldown-btn" data-action="levelDown"
                data-type="carac" data-key="creativite"
                title='{{localize "AGONE.RetrograderNiveau"}}'
                {{#unless system.creativite.score}}disabled{{/unless}}>
          <i class="fas fa-arrow-down"></i> {{coutAfficheDown.creativite}}
        </button>{{/if}}
      </div>
      </div>{{!-- /carac-aspect-group Âme --}}

    </div>

    <!-- Points de création (visible seulement en mode création) -->
    {{#if modeCreation}}
    <div class="pts-creation-row">
      <div class="pts-creation-block">
        <label>{{localize "AGONE.PtsCreationCarac"}}</label>
        <span class="derived sombre">{{ptsCreationCaracRestant}}</span>
        <span>/</span>
        <span class="derived sombre">{{system.ptsCreationCarac.max}}</span>
        <button type="button" class="btn-icon reset-crea-btn" data-action="resetCaracs" title='{{localize "AGONE.ResetCreationCaracTooltip"}}'>&#8635;</button>
      </div>
    </div>
    {{/if}}

  </div><!-- /carac-section -->
</div><!-- /attributs-grid -->
