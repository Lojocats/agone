<!-- PARTIAL : COMPÉTENCES -->
<div class="competences-section">
  <div class="section-header">
    <h3>{{localize "AGONE.Competences"}}</h3>
    {{#if modeCreation}}
    <div class="pts-creation-comp">
      <label>{{localize "AGONE.PtsCreationComp"}}</label>
      <span class="derived sombre">{{ptsCreationCompRestant}}</span>
      <span>/</span>
      <span class="derived sombre">{{system.ptsCreationComp.max}}</span>
      <button type="button" class="btn-icon reset-crea-btn" data-action="resetComps" title='{{localize "AGONE.ResetCreationCompTooltip"}}'>&#8635;</button>
    </div>
    {{/if}}
    <button type="button" class="compendium-browse btn-icon" data-pack="agone.competences" title='{{localize "AGONE.ParcourirCompetences"}}'>
      <i class="fas fa-search"></i>
    </button>
    <button type="button" class="item-create" data-type="competence" title='{{localize "AGONE.AjouterCompetence"}}'>
      <i class="fas fa-plus"></i>
    </button>
  </div>

  {{#if competences.length}}
  <table class="competences-table">
    <thead>
      <tr>
        <th class="col-nom">{{localize "AGONE.Nom"}}</th>
        <th class="col-domaine">{{localize "AGONE.Domaine"}}</th>
        <th class="col-specialite">{{localize "AGONE.Specialite"}}</th>
        <th class="col-attr">{{localize "AGONE.AttributLie"}}</th>
        <th class="col-score">{{localize "AGONE.Score"}}</th>
        <th class="col-exp">{{localize "AGONE.Exp"}}</th>
        <th class="col-actions"></th>
        <th class="col-drag"></th>
      </tr>
    </thead>
    <tbody>
      {{#each competences as |comp|}}
      <tr class="item-row" data-item-id="{{comp.id}}">
        <td class="col-nom">
          <button type="button" class="roll-btn item-name" data-action="rollCompetence" data-item-id="{{comp.id}}"
                  title='{{localize "AGONE.JeterCompetence"}}'>
            {{comp.name}}
          </button>
        </td>
        <td class="col-domaine">{{comp.system.domaine}}</td>
        <td class="col-specialite">{{comp.system.specialite}}</td>
        <td class="col-attr">{{comp.system.attributLie}}</td>
        <td class="col-score">
          <input type="number" name="items.{{comp.id}}.system.score" value="{{comp.system.score}}" class="stat-num inline-edit" data-item-id="{{comp.id}}" data-field="system.score" />
          {{#if ../showLevelUp}}<button type="button" class="levelup-btn" data-action="levelUp"
                  data-type="competence" data-item-id="{{comp.id}}" data-cout="{{comp.xpCout}}" data-crea-cout="{{comp.creaCout}}"
                  title='{{localize "AGONE.MonterNiveau"}} ({{comp.coutAffiche}})'>
            <i class="fas fa-arrow-up"></i> {{comp.coutAffiche}}
          </button>{{/if}}
        </td>
        <td class="col-exp">
          <input type="number" name="items.{{comp.id}}.system.exp" value="{{comp.system.exp}}" class="stat-num inline-edit" data-item-id="{{comp.id}}" data-field="system.exp" />
        </td>
        <td class="col-actions">
          <a class="item-edit" data-item-id="{{comp.id}}" title='{{localize "AGONE.Editer"}}'><i class="fas fa-edit"></i></a>
          <a class="item-delete" data-item-id="{{comp.id}}" title='{{localize "AGONE.Supprimer"}}'><i class="fas fa-trash"></i></a>
        </td>
        <td class="col-drag"><span class="item-drag-handle" title="Déplacer"><i class="fas fa-grip-vertical"></i></span></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="empty-list">{{localize "AGONE.AucuneCompetence"}}</p>
  {{/if}}

  <!-- Manœuvres & Bottes -->
  <div class="section-header">
    <h3>{{localize "AGONE.Manoeuvres"}}</h3>
    <button type="button" class="compendium-browse btn-icon" data-pack="agone.manoeuvres" title='{{localize "AGONE.ParcourirManoeuvres"}}'>
      <i class="fas fa-search"></i>
    </button>
    <button type="button" class="item-create" data-type="manoeuvre" title='{{localize "AGONE.AjouterManoeuvre"}}'>
      <i class="fas fa-plus"></i>
    </button>
  </div>

  {{#if manoeuvres.length}}
  <table class="manoeuvres-table">
    <thead>
      <tr>
        <th class="man-col-toggle"></th>
        <th class="man-col-badge"></th>
        <th>{{localize "AGONE.Nom"}}</th>
        <th class="col-score">{{localize "AGONE.Score"}}</th>
        <th class="col-mod">{{localize "AGONE.Malus"}}</th>
        <th></th>
        <th class="col-drag"></th>
      </tr>
    </thead>
    <tbody>
      {{#each manoeuvres as |man|}}
      <tr class="item-row" data-item-id="{{man.id}}">
        <td class="man-col-toggle">
          {{#if man.system.description}}
          <button type="button" class="man-desc-toggle btn-icon" data-item-id="{{man.id}}" title="Description">
            <i class="fas fa-chevron-right man-toggle-icon"></i>
          </button>
          {{/if}}
        </td>
        <td class="man-col-badge">
          <span class="man-badge man-badge-{{man.system.categorie}}">
            {{#if (eq man.system.categorie "botte")}}Botte{{else}}Manœuvre{{/if}}
          </span>
        </td>
        <td>
          <button type="button" class="roll-btn item-name" data-action="rollManoeuvre" data-item-id="{{man.id}}">
            {{man.name}}
          </button>
        </td>
        <td><span>{{man.system.score}}</span></td>
        <td><span>{{man.system.malus}}</span></td>
        <td>
          <a class="item-edit" data-item-id="{{man.id}}"><i class="fas fa-edit"></i></a>
          <a class="item-delete" data-item-id="{{man.id}}"><i class="fas fa-trash"></i></a>
        </td>
        <td class="col-drag"><span class="item-drag-handle" title="Déplacer"><i class="fas fa-grip-vertical"></i></span></td>
      </tr>
      <tr class="man-desc-expand" data-item-id="{{man.id}}" style="display:none">
        <td></td>
        <td colspan="6" class="man-desc-cell">{{man.system.description}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="empty-list">{{localize "AGONE.AucuneManoeuvre"}}</p>
  {{/if}}
</div>
