<!-- PARTIAL : COMPÉTENCES -->
<div class="competences-section">
  <div class="section-header">
    <h3>{{localize "AGONE.Competences"}}</h3>
    {{#if modeCreation}}
    <div class="pts-creation-comp">
      <label>{{localize "AGONE.PtsCreationComp"}}</label>
      <span class="derived sombre">{{ptsCreationCompRestant}}</span>
      <span>/</span>
      <span class="derived sombre">{{system.ptsCreationComp.max}}</span>
      <button type="button" class="btn-icon reset-crea-btn" data-action="resetComps" title='{{localize "AGONE.ResetCreationCompTooltip"}}'>&#8635;</button>
    </div>
    {{/if}}
    <button type="button" class="compendium-browse btn-icon" data-pack="agone.competences" title='{{localize "AGONE.ParcourirCompetences"}}'>
      <i class="fas fa-search"></i>
    </button>
    <button type="button" class="item-create" data-type="competence" title='{{localize "AGONE.AjouterCompetence"}}'>
      <i class="fas fa-plus"></i>
    </button>
    <button type="button" class="btn-icon tri-toggle-btn" data-action="triCompsToggle"
            title='{{#if triCompsEstFamille}}{{localize "AGONE.TrierParNiveau"}}{{else}}{{localize "AGONE.TrierParFamille"}}{{/if}}'>
      <i class="fas fa-sort"></i> {{#if triCompsEstFamille}}{{localize "AGONE.Famille"}}{{else}}{{localize "AGONE.Niveau"}}{{/if}}
    </button>
  </div>

  <!-- Barre de recherche compétences -->
  <div class="comp-search-wrap">
    <i class="fas fa-search comp-search-icon"></i>
    <input type="text" class="comp-search-input" placeholder='{{localize "AGONE.FiltrerCompetences"}}' autocomplete="off" />
    <button type="button" class="comp-search-clear btn-icon" title='{{localize "AGONE.EffacerRecherche"}}' style="display:none">✕</button>
  </div>

  {{#if competences.length}}
  <div class="comp-groups-container">
    {{#each competencesGroups as |group|}}
    <div class="comp-group" data-key="{{group.label}}">
      <div class="comp-group-header">
        <span class="comp-score-badge {{group.className}}">{{group.label}}</span>
        <span class="comp-group-count">{{group.comps.length}}</span>
      </div>
      <div class="comp-cards-grid">
        {{#each group.comps as |comp|}}
        <div class="comp-card item-row" data-item-id="{{comp.id}}">
          <div class="comp-card-header">
            <button type="button" class="roll-btn comp-card-name item-name"
                    data-action="rollCompetence" data-item-id="{{comp.id}}"
                    title='{{localize "AGONE.JeterCompetence"}}'>
              {{comp.name}}
            </button>
            {{#if comp.system.specialite}}
            <span class="comp-card-spe" title='{{localize "AGONE.Specialite"}}'>&#9733; {{comp.system.specialite}}</span>
            {{/if}}
          </div>
          <div class="comp-card-body">
            <div class="comp-card-stats">
              <label class="comp-card-stat-lbl">{{localize "AGONE.Score"}}</label>
              <input type="number" name="items.{{comp.id}}.system.score" value="{{comp.system.score}}"
                     class="stat-num inline-edit" data-item-id="{{comp.id}}" data-field="system.score" />
              <label class="comp-card-stat-lbl">{{localize "AGONE.Exp"}}</label>
              <input type="number" name="items.{{comp.id}}.system.exp" value="{{comp.system.exp}}"
                     class="stat-num inline-edit" data-item-id="{{comp.id}}" data-field="system.exp" />
              <select class="comp-card-attr-badge inline-edit" data-item-id="{{comp.id}}" data-field="system.attributLie"
                      title='{{localize "AGONE.AttributLie"}}'>
                <option value="agilite"      {{#if (eq comp.system.attributLie "agilite")}}selected{{/if}}>AGI</option>
                <option value="force"        {{#if (eq comp.system.attributLie "force")}}selected{{/if}}>FOR</option>
                <option value="perception"   {{#if (eq comp.system.attributLie "perception")}}selected{{/if}}>PER</option>
                <option value="resistance"   {{#if (eq comp.system.attributLie "resistance")}}selected{{/if}}>RÉS</option>
                <option value="intelligence" {{#if (eq comp.system.attributLie "intelligence")}}selected{{/if}}>INT</option>
                <option value="volonte"      {{#if (eq comp.system.attributLie "volonte")}}selected{{/if}}>VOL</option>
                <option value="charisma"     {{#if (eq comp.system.attributLie "charisma")}}selected{{/if}}>CHA</option>
                <option value="creativite"   {{#if (eq comp.system.attributLie "creativite")}}selected{{/if}}>CRÉ</option>
                <option value="melee"        {{#if (eq comp.system.attributLie "melee")}}selected{{/if}}>MÊL</option>
                <option value="tir"          {{#if (eq comp.system.attributLie "tir")}}selected{{/if}}>TIR</option>
              </select>
            </div>
            {{#if comp.system.domaine}}
            <div class="comp-card-dom">{{comp.system.domaine}}</div>
            {{/if}}
            {{#if @root.showLevelUp}}
            <div class="comp-card-levelbtns">
              <button type="button" class="levelup-btn" data-action="levelUp"
                      data-type="competence" data-item-id="{{comp.id}}"
                      data-cout="{{comp.xpCout}}" data-crea-cout="{{comp.creaCout}}"
                      title='{{localize "AGONE.MonterNiveau"}} ({{comp.coutAffiche}})'>
                <i class="fas fa-arrow-up"></i> {{comp.coutAffiche}}
              </button>
              <button type="button" class="leveldown-btn" data-action="levelDown"
                      data-type="competence" data-item-id="{{comp.id}}"
                      title='{{localize "AGONE.RetrograderNiveau"}}'
                      {{#unless comp.system.score}}disabled{{/unless}}>
                <i class="fas fa-arrow-down"></i> {{comp.coutAfficheDown}}
              </button>
            </div>
            {{/if}}
          </div>
          <div class="comp-card-actions">
            <a class="item-edit" data-item-id="{{comp.id}}" title='{{localize "AGONE.Editer"}}'><i class="fas fa-edit"></i></a>
            <a class="item-delete" data-item-id="{{comp.id}}" title='{{localize "AGONE.Supprimer"}}'><i class="fas fa-trash"></i></a>
            <span class="item-drag-handle" title='{{localize "AGONE.Deplacer"}}'><i class="fas fa-grip-vertical"></i></span>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  <p class="empty-list">{{localize "AGONE.AucuneCompetence"}}</p>
  {{/if}}

  <!-- Compétences non acquises (visible uniquement lors d'une recherche) -->
  <div class="comps-na-section" style="display:none">
    <p class="na-section-title"><i class="fas fa-dice"></i> {{localize "AGONE.CompetencesNonAcquises"}}</p>
    <div class="comp-cards-grid comp-na-cards">
      {{#each competencesNonAcquises as |c|}}
      <div class="comp-card comp-card--na na-row" data-nom="{{c.name}}" data-domaine="{{c.famille}}">
        <div class="comp-card-header">
          <button type="button" class="roll-btn comp-card-name na-roll-btn" data-action="rollCompetenceNA"
                  data-nom="{{c.name}}" data-attribut-lie="{{c.attributLie}}" data-domaine="{{c.famille}}"
                  title='{{localize "AGONE.JeterCompetenceNonAcquise"}}'>
            {{c.displayName}}
          </button>
        </div>
        <div class="comp-card-body">
          <div class="comp-card-stats">
            <span class="na-score">0 <em class="na-malus">(-3)</em></span>
            <span class="comp-card-attr-badge">{{c.attributLie}}</span>
          </div>
        </div>
        <div class="comp-card-actions">
          <button type="button" class="na-apprendre-btn btn-icon" data-action="apprendreCompetenceNA"
                  data-nom="{{c.name}}" data-attribut-lie="{{c.attributLie}}" data-domaine="{{c.famille}}"
                  title='{{localize "AGONE.ApprendreCompetence"}}'>
            <i class="fas fa-plus"></i>
          </button>
        </div>
      </div>
      {{/each}}
    </div>
  </div>

</div>
