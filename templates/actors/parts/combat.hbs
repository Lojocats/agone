<!-- PARTIAL : COMBAT -->
<div class="combat-section">

  <!-- LIGNE HAUTE : Santé + Stats Combat -->
  <div class="combat-top-row">

    <!-- SANTÉ -->
    <div class="combat-card sante-card">
      <h3 class="combat-card-title"><i class="fas fa-heartbeat"></i> {{localize "AGONE.EtatSante"}}</h3>

      <!-- Barre PdV -->
      <div class="pdv-bar-wrap">
        <div class="pdv-values">
          <span class="pdv-current {{#if system.blessuresCritique}}pdv-critique{{/if}}">{{system.pdv.valeur}}</span>
          <span class="pdv-sep">/</span>
          <span class="pdv-max" title="BPdV {{bpdv}} + RES×3 + bonus 1d10">{{system.pdv.max}}</span>
          <span class="pdv-label">PdV</span>
        </div>
        <div class="pdv-track" title="{{system.pdv.valeur}} / {{system.pdv.max}}">
          <div class="pdv-fill" style="width:{{pdvPercent}}%;"></div>
        </div>
        <div class="pdv-seuils-row">
          <span class="seuil-item seuil-bg" title="Seuil Blessure Grave (PdV ÷ 3)">BG {{system.seuilBlessureGrave}}</span>
          <span class="seuil-item seuil-bc" title="Seuil Blessure Critique (PdV ÷ 2)">BC {{system.seuilBlessureCritique}}</span>
          <span class="pdv-bonus-inline">
            <span class="pdv-bonus-label">+1d10</span>
            <input type="number" name="system.pdv.bonusDe" value="{{system.pdv.bonusDe}}" class="stat-num pdv-bonus-input" min="0" max="10" />
            {{#if isOwner}}
            <button type="button" class="roll-btn-small btn-bonus-de" data-action="rollBonusDe" title='{{localize "AGONE.LancerBonusDe"}}'><i class="fas fa-dice-d10"></i></button>
            {{/if}}
          </span>
        </div>
      </div>

      <!-- Blessures -->
      <div class="blessures-section">
        <div class="bg-row">
          <span class="bg-title">{{localize "AGONE.BlessuresGraves"}}</span>
          <label class="bg-cell {{#if system.blessureGrave1}}bg-active{{/if}}" title="{{localize "AGONE.BlessureGrave1Hint"}}">
            <input type="checkbox" name="system.blessureGrave1" {{#if system.blessureGrave1}}checked{{/if}} />
            <span class="bg-dot">1</span>
            <span class="bg-pen">-2</span>
          </label>
          <label class="bg-cell {{#if system.blessureGrave2}}bg-active{{/if}}" title="{{localize "AGONE.BlessureGrave2Hint"}}">
            <input type="checkbox" name="system.blessureGrave2" {{#if system.blessureGrave2}}checked{{/if}} />
            <span class="bg-dot">2</span>
            <span class="bg-pen">-6</span>
          </label>
          <label class="bg-cell {{#if system.blessureGrave3}}bg-active{{/if}}" title="{{localize "AGONE.BlessureGrave3Hint"}}">
            <input type="checkbox" name="system.blessureGrave3" {{#if system.blessureGrave3}}checked{{/if}} />
            <span class="bg-dot">3</span>
            <span class="bg-pen">-12</span>
          </label>
          {{#if system.malusBlessureGrave}}<span class="bg-total">{{system.malusBlessureGrave}}</span>{{/if}}
        </div>
        <label class="bc-row {{#if system.blessuresCritique}}bc-active{{/if}}">
          <input type="checkbox" name="system.blessuresCritique" {{#if system.blessuresCritique}}checked{{/if}} />
          <i class="fas fa-skull"></i>
          <span>{{localize "AGONE.BlessuresCritiques"}}</span>
        </label>
      </div>
    </div><!-- /.sante-card -->

    <!-- STATS DE COMBAT -->
    <div class="combat-card cstats-card">
      <h3 class="combat-card-title"><i class="fas fa-khanda"></i> {{localize "AGONE.StatsCombat"}}</h3>
      <div class="cstats-grid">
        <div class="cstat-item">
          <button type="button" class="cstat-roll" data-action="rollInitiative" title='{{localize "AGONE.JeterInitiative"}}'><i class="fas fa-bolt"></i></button>
          <span class="cstat-score">{{system.initiative}}</span>
          <span class="cstat-label">{{localize "AGONE.Initiative"}}</span>
        </div>
        <div class="cstat-item">
          <button type="button" class="cstat-roll" data-action="rollDefenseNaturelle" title='{{localize "AGONE.JeterDefenseNaturelle"}}'><i class="fas fa-shield-alt"></i></button>
          <span class="cstat-score">{{system.defenseNaturelle}}</span>
          <span class="cstat-label">{{localize "AGONE.DefenseNaturelle"}}</span>
        </div>
        <div class="cstat-item">
          <button type="button" class="cstat-roll" data-action="rollEsquive" title='{{localize "AGONE.JeterEsquive"}}'><i class="fas fa-running"></i></button>
          <span class="cstat-score">{{system.esquiveTotal}}</span>
          <span class="cstat-label">{{localize "AGONE.Esquive"}}</span>
        </div>
        <div class="cstat-item">
          <span class="cstat-roll cstat-passive"><i class="fas fa-crosshairs"></i></span>
          <span class="cstat-score">{{system.esquiveDistance}}</span>
          <span class="cstat-label">Esquive dist.</span>
        </div>
        <div class="cstat-item">
          <span class="cstat-roll cstat-passive"><i class="fas fa-hammer"></i></span>
          <span class="cstat-score">{{system.bd}}</span>
          <span class="cstat-label">{{localize "AGONE.BD"}}</span>
        </div>
        <div class="cstat-item">
          <span class="cstat-roll cstat-passive"><i class="fas fa-shield-halved"></i></span>
          <span class="cstat-score">{{system.armure.protection}}</span>
          <span class="cstat-label">PRO totale</span>
        </div>
      </div>
    </div><!-- /.cstats-card -->

  </div><!-- /.combat-top-row -->

  <!-- ARMURE -->
  <div class="combat-card armure-card">
    <div class="combat-card-header">
      <h3 class="combat-card-title"><i class="fas fa-shield-halved"></i> {{localize "AGONE.Armure.Label"}}</h3>
      <div class="card-btns">
        <button type="button" class="compendium-browse btn-icon" data-pack="agone.armures" title='{{localize "AGONE.ParcourirArmures"}}'><i class="fas fa-search"></i></button>
        <button type="button" class="item-create btn-icon" data-type="armure" title='{{localize "AGONE.AjouterArmure"}}'><i class="fas fa-plus"></i></button>
      </div>
    </div>
    {{#if armures.length}}
    <div class="armures-list">
      {{#each armures as |armure|}}
      <div class="armure-row {{#if armure.system.portee}}armure-worn{{/if}}" data-item-id="{{armure.id}}">
        <label class="armure-portee-toggle" title="{{#if armure.system.portee}}Portée{{else}}Rangée{{/if}}">
          <input type="checkbox" class="armure-portee" data-item-id="{{armure.id}}" {{#if armure.system.portee}}checked{{/if}} />
          <i class="fas {{#if armure.system.portee}}fa-shield-alt{{else}}fa-shield{{/if}}"></i>
        </label>
        <span class="armure-name">{{armure.name}}</span>
        <span class="armure-badge pro-badge">PRO {{armure.system.protection}}</span>
        {{#if armure.system.malusAgi}}<span class="armure-badge malus-badge">-AGI {{armure.system.malusAgi}}</span>{{/if}}
        {{#if armure.system.malusPer}}<span class="armure-badge malus-badge">-PER {{armure.system.malusPer}}</span>{{/if}}
        <div class="row-actions">
          <a class="item-edit" data-item-id="{{armure.id}}" title="Éditer"><i class="fas fa-pen"></i></a>
          <a class="item-delete" data-item-id="{{armure.id}}" title="Supprimer"><i class="fas fa-trash"></i></a>
        </div>
      </div>
      {{/each}}
    </div>
    <div class="armure-totaux">
      <span class="armure-total-item"><i class="fas fa-shield-alt"></i> PRO <strong>{{system.armure.protection}}</strong></span>
      <span class="armure-total-item malus-total">-AGI <strong>{{#if system.armure.malusAgi}}{{system.armure.malusAgi}}{{else}}0{{/if}}</strong></span>
      <span class="armure-total-item malus-total">-PER <strong>{{#if system.armure.malusPer}}{{system.armure.malusPer}}{{else}}0{{/if}}</strong></span>
    </div>
    {{else}}
    <p class="empty-list">{{localize "AGONE.AucuneArmure"}}</p>
    {{/if}}
  </div>

  <!-- ARMES -->
  <div class="combat-card armes-card">
    <div class="combat-card-header">
      <h3 class="combat-card-title"><i class="fas fa-khanda"></i> {{localize "AGONE.Armes"}}</h3>
      <div class="card-btns">
        <button type="button" class="compendium-browse btn-icon" data-pack="agone.armes" title='{{localize "AGONE.ParcourirArmes"}}'><i class="fas fa-search"></i></button>
        <button type="button" class="item-create btn-icon" data-type="arme" title='{{localize "AGONE.AjouterArme"}}'><i class="fas fa-plus"></i></button>
      </div>
    </div>
    {{#if armes.length}}
    <table class="armes-table">
      <thead>
        <tr>
          <th class="col-equipe" title="{{localize 'AGONE.Equipe'}}"><i class="fas fa-hand-paper"></i></th>
          <th class="col-arme-name">{{localize "AGONE.Nom"}}</th>
          <th class="col-tai">TAI</th>
          <th class="col-type">Type</th>
          <th class="col-init"><i class="fas fa-bolt"></i> INIT</th>
          <th class="col-atk"><i class="fas fa-dice-d10"></i> ATK</th>
          <th class="col-def"><i class="fas fa-shield-alt"></i> DEF</th>
          <th class="col-dom">DOM</th>
          <th class="col-row-actions"></th>
        </tr>
      </thead>
      <tbody>
        {{#each armes as |arme|}}
        <tr class="item-row {{#if arme.system.equipe}}arme-equipee{{/if}}" data-item-id="{{arme.id}}">
          <td class="col-equipe">
            <label class="arme-equipe-toggle" title="{{#if arme.system.equipe}}Équipée{{else}}Rangée{{/if}}">
              <input type="checkbox" class="arme-equipe" data-item-id="{{arme.id}}" {{#if arme.system.equipe}}checked{{/if}} />
              <i class="fas {{#if (eq arme.system.style 'bouclier')}}fa-shield{{else}}fa-hand-paper{{/if}} arme-equipe-icon"></i>
            </label>
          </td>
          <td class="col-arme-name">
            <span class="roll-btn item-name" data-action="rollItemChat" data-item-id="{{arme.id}}">{{arme.name}}</span>
            {{#if (eq arme.system.style "bouclier")}}
            <span class="armure-badge pro-badge">PRO {{arme.system.protection}}</span>
            {{#if arme.system.malusAgi}}<span class="armure-badge malus-badge">-AGI {{arme.system.malusAgi}}</span>{{/if}}
            {{/if}}
          </td>
          <td class="col-tai">{{arme.system.tai}}</td>
          <td class="col-type">{{#if (eq arme.system.style "bouclier")}}<i class="fas fa-shield-alt" title="Bouclier"></i>{{else}}{{arme.system.type}}{{/if}}</td>
          <td class="col-init">
            {{#if (eq arme.system.style "bouclier")}}
            <span class="arme-score arme-score-inactive">—</span>
            {{else}}
            <div class="arme-cell">
              <span class="arme-score">{{arme.system.initTotal}}</span>
              <button type="button" class="roll-btn-small roll-init-btn" data-action="rollInitiative" data-item-id="{{arme.id}}" title='{{localize "AGONE.JeterInitiative"}}'><i class="fas fa-bolt"></i></button>
            </div>
            {{/if}}
          </td>
          <td class="col-atk">
            {{#if (eq arme.system.style "bouclier")}}
            <span class="arme-score arme-score-inactive">—</span>
            {{else}}
            <div class="arme-cell">
              <span class="arme-score">{{arme.system.attackTotal}}</span>
              <button type="button" class="roll-btn-small roll-atk-btn" data-action="rollAttaque" data-item-id="{{arme.id}}" title='{{localize "AGONE.JeterAttaque"}}'><i class="fas fa-dice-d10"></i></button>
            </div>
            {{/if}}
          </td>
          <td class="col-def">
            <div class="arme-cell">
              <span class="arme-score">{{arme.system.defenseTotal}}</span>
              <button type="button" class="roll-btn-small roll-def-btn" data-action="rollParade" data-item-id="{{arme.id}}" title='{{localize "AGONE.JeterParade"}}'><i class="fas fa-shield-alt"></i></button>
            </div>
          </td>
          <td class="col-dom">
            {{#if (eq arme.system.style "bouclier")}}
            <span class="arme-score arme-score-inactive">—</span>
            {{else}}
            <span class="dom-base">{{arme.system.dommages}}</span>
            <span class="dom-bd">+{{system.bd}}</span>
            {{/if}}
          </td>
          <td class="col-row-actions">
            <a class="item-edit" data-item-id="{{arme.id}}" title="Éditer"><i class="fas fa-pen"></i></a>
            <a class="item-delete" data-item-id="{{arme.id}}" title="Supprimer"><i class="fas fa-trash"></i></a>
            <span class="item-drag-handle" title="Déplacer"><i class="fas fa-grip-vertical"></i></span>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="empty-list">{{localize "AGONE.AucuneArme"}}</p>
    {{/if}}
  </div>

  <!-- MANŒUVRES & BOTTES -->
  <div class="combat-card manoeuvres-card">
    <div class="combat-card-header">
      <h3 class="combat-card-title"><i class="fas fa-fist-raised"></i> {{localize "AGONE.Manoeuvres"}}</h3>
      <div class="card-btns">
        <button type="button" class="compendium-browse btn-icon" data-pack="agone.manoeuvres" title='{{localize "AGONE.ParcourirManoeuvres"}}'><i class="fas fa-search"></i></button>
        <button type="button" class="item-create btn-icon" data-type="manoeuvre" title='{{localize "AGONE.AjouterManoeuvre"}}'><i class="fas fa-plus"></i></button>
      </div>
    </div>
    {{#if manoeuvres.length}}
    <table class="manoeuvres-table">
      <thead>
        <tr>
          <th class="man-col-toggle"></th>
          <th class="man-col-name">{{localize "AGONE.Nom"}}</th>
          <th class="man-col-num" title="Modificateur d'Initiative">INI</th>
          <th class="man-col-num" title="Modificateur d'Attaque">ATT</th>
          <th class="man-col-num" title="Modificateur de Défense">DEF</th>
          <th class="man-col-dom" title="Dommages">DOM</th>
          <th class="man-col-actions"></th>
          <th class="col-drag"></th>
        </tr>
      </thead>
      <tbody>
        {{#each manoeuvres as |man|}}
        <tr class="item-row man-row" data-item-id="{{man.id}}">
          <td class="man-col-toggle">
            {{#if man.system.description}}
            <button type="button" class="man-desc-toggle btn-icon" data-item-id="{{man.id}}" title="Description">
              <i class="fas fa-chevron-right man-toggle-icon"></i>
            </button>
            {{/if}}
          </td>
          <td class="man-col-name">
            <div class="man-name-line">
              <span class="man-badge man-badge-{{man.system.categorie}}">
                {{#if (eq man.system.categorie "botte")}}Botte{{else}}Man.{{/if}}
              </span>
              <button type="button" class="roll-btn item-name" data-action="rollManoeuvre" data-item-id="{{man.id}}">
                {{man.name}}
              </button>
            </div>
            {{#if man.system.condition}}
            <div class="man-condition">{{man.system.condition}}</div>
            {{/if}}
          </td>
          <td class="man-col-num">
            <span class="man-val {{#if (eq man.system.ini null)}}man-val-var{{else if (gt man.system.ini 0)}}man-val-pos{{else if (lt man.system.ini 0)}}man-val-neg{{else}}man-val-zero{{/if}}">
              {{#if (eq man.system.ini null)}}var{{else if (gt man.system.ini 0)}}+{{man.system.ini}}{{else if (lt man.system.ini 0)}}{{man.system.ini}}{{else}}0{{/if}}
            </span>
          </td>
          <td class="man-col-num">
            <span class="man-val {{#if (eq man.system.att null)}}man-val-var{{else if (gt man.system.att 0)}}man-val-pos{{else if (lt man.system.att 0)}}man-val-neg{{else}}man-val-zero{{/if}}">
              {{#if (eq man.system.att null)}}var{{else if (gt man.system.att 0)}}+{{man.system.att}}{{else if (lt man.system.att 0)}}{{man.system.att}}{{else}}0{{/if}}
            </span>
          </td>
          <td class="man-col-num">
            <span class="man-val {{#if (eq man.system.def null)}}man-val-var{{else if (gt man.system.def 0)}}man-val-pos{{else if (lt man.system.def 0)}}man-val-neg{{else}}man-val-zero{{/if}}">
              {{#if (eq man.system.def null)}}var{{else if (gt man.system.def 0)}}+{{man.system.def}}{{else if (lt man.system.def 0)}}{{man.system.def}}{{else}}0{{/if}}
            </span>
          </td>
          <td class="man-col-dom">
            <span class="man-dom">{{#if man.system.dom}}{{man.system.dom}}{{else}}—{{/if}}</span>
          </td>
          <td class="man-col-actions">
            <a class="item-edit" data-item-id="{{man.id}}" title='{{localize "AGONE.Editer"}}'><i class="fas fa-edit"></i></a>
            <a class="item-delete" data-item-id="{{man.id}}" title='{{localize "AGONE.Supprimer"}}'><i class="fas fa-trash"></i></a>
          </td>
          <td class="col-drag"><span class="item-drag-handle" title="Déplacer"><i class="fas fa-grip-vertical"></i></span></td>
        </tr>
        <tr class="man-desc-expand" data-item-id="{{man.id}}" style="display:none">
          <td></td>
          <td colspan="7" class="man-desc-cell">{{man.system.description}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="empty-list">{{localize "AGONE.AucuneManoeuvre"}}</p>
    {{/if}}
  </div>

</div>
