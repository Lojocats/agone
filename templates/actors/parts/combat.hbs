<!-- PARTIAL : COMBAT -->
<div class="combat-section">

  <!-- LIGNE HAUTE : Santé + Stats Combat -->
  <div class="combat-top-row">

    <!-- SANTÉ -->
    <div class="combat-card sante-card">
      <h3 class="combat-card-title"><i class="fas fa-heartbeat"></i> {{localize "AGONE.EtatSante"}}</h3>

      <!-- Barre PdV -->
      <div class="pdv-bar-wrap">
        <div class="pdv-values">
          <span class="pdv-current {{#if system.blessuresCritique}}pdv-critique{{/if}}">{{system.pdv.valeur}}</span>
          <span class="pdv-sep">/</span>
          <span class="pdv-max" data-tooltip='{{localize "AGONE.Combat.PdvMaxTooltip" bpdv=bpdv}}'>{{system.pdv.max}}</span>
          <span class="pdv-label">PdV</span>
        </div>
        <div class="pdv-track" data-tooltip="{{system.pdv.valeur}} / {{system.pdv.max}}">
          <div class="pdv-fill" style="width:{{pdvPercent}}%;"></div>
        </div>
        <div class="pdv-seuils-row">
          <span class="seuil-item seuil-bg" data-tooltip='{{localize "AGONE.Combat.SeuilBGTooltip"}}'>BG {{system.seuilBlessureGrave}}</span>
          <span class="seuil-item seuil-bc" data-tooltip='{{localize "AGONE.Combat.SeuilBCTooltip"}}'>BC {{system.seuilBlessureCritique}}</span>
          <span class="pdv-bonus-inline">
            <span class="pdv-bonus-label">+1d10</span>
            <input type="number" name="system.pdv.bonusDe" value="{{system.pdv.bonusDe}}" class="stat-num pdv-bonus-input" min="0" max="10" />
            {{#if isOwner}}
            <button type="button" class="roll-btn-small btn-bonus-de" data-action="rollBonusDe" data-tooltip='{{localize "AGONE.LancerBonusDe"}}' aria-label='{{localize "AGONE.LancerBonusDe"}}'><i class="fas fa-dice-d10"></i></button>
            {{/if}}
          </span>
        </div>
      </div>

      <!-- Blessures -->
      <div class="blessures-section">
        <div class="bg-row">
          <span class="bg-title">{{localize "AGONE.BlessuresGraves"}}</span>
          <label class="bg-cell {{#if system.blessureGrave1}}bg-active{{/if}}" data-tooltip="{{localize "AGONE.BlessureGrave1Hint"}}">
            <input type="checkbox" name="system.blessureGrave1" {{#if system.blessureGrave1}}checked{{/if}} />
            <span class="bg-dot">1</span>
            <span class="bg-pen">-2</span>
          </label>
          <label class="bg-cell {{#if system.blessureGrave2}}bg-active{{/if}}" data-tooltip="{{localize "AGONE.BlessureGrave2Hint"}}">
            <input type="checkbox" name="system.blessureGrave2" {{#if system.blessureGrave2}}checked{{/if}} />
            <span class="bg-dot">2</span>
            <span class="bg-pen">-6</span>
          </label>
          <label class="bg-cell {{#if system.blessureGrave3}}bg-active{{/if}}" data-tooltip="{{localize "AGONE.BlessureGrave3Hint"}}">
            <input type="checkbox" name="system.blessureGrave3" {{#if system.blessureGrave3}}checked{{/if}} />
            <span class="bg-dot">3</span>
            <span class="bg-pen">-12</span>
          </label>
          {{#if system.malusBlessureGrave}}<span class="bg-total">{{system.malusBlessureGrave}}</span>{{/if}}
        </div>
        <label class="bc-row {{#if system.blessuresCritique}}bc-active{{/if}}">
          <input type="checkbox" name="system.blessuresCritique" {{#if system.blessuresCritique}}checked{{/if}} />
          <i class="fas fa-skull"></i>
          <span>{{localize "AGONE.BlessuresCritiques"}}</span>
        </label>
      </div>
    </div><!-- /.sante-card -->

    <!-- STATS DE COMBAT -->
    <div class="combat-card cstats-card">
      <h3 class="combat-card-title"><i class="fas fa-khanda"></i> {{localize "AGONE.StatsCombat"}}</h3>
      <div class="cstats-grid">
        <div class="cstat-item">
          <button type="button" class="cstat-roll" data-action="rollInitiative" data-tooltip='{{localize "AGONE.JeterInitiative"}}' aria-label='{{localize "AGONE.JeterInitiative"}}'><i class="fas fa-bolt"></i></button>
          <span class="cstat-score">{{system.initiative}}</span>
          <span class="cstat-label">{{localize "AGONE.Initiative"}}</span>
        </div>
        <div class="cstat-item">
          <button type="button" class="cstat-roll" data-action="rollDefenseNaturelle" data-tooltip='{{localize "AGONE.JeterDefenseNaturelle"}}' aria-label='{{localize "AGONE.JeterDefenseNaturelle"}}'><i class="fas fa-shield-alt"></i></button>
          <span class="cstat-score">{{system.defenseNaturelle}}</span>
          <span class="cstat-label">{{localize "AGONE.DefenseNaturelle"}}</span>
        </div>
        <div class="cstat-item">
          <button type="button" class="cstat-roll" data-action="rollEsquive" data-tooltip='{{localize "AGONE.JeterEsquive"}}' aria-label='{{localize "AGONE.JeterEsquive"}}'><i class="fas fa-running"></i></button>
          <span class="cstat-score">{{system.esquiveTotal}}</span>
          <span class="cstat-label">{{localize "AGONE.Esquive"}}</span>
        </div>
        <div class="cstat-item">
          <span class="cstat-roll cstat-passive"><i class="fas fa-crosshairs"></i></span>
          <span class="cstat-score">{{system.esquiveDistance}}</span>
          <span class="cstat-label">{{localize "AGONE.Combat.EsquiveDist"}}</span>
        </div>
        <div class="cstat-item">
          <span class="cstat-roll cstat-passive"><i class="fas fa-hammer"></i></span>
          <span class="cstat-score">{{system.bd}}</span>
          <span class="cstat-label">{{localize "AGONE.BD"}}</span>
        </div>
        <div class="cstat-item">
          <span class="cstat-roll cstat-passive"><i class="fas fa-shield-halved"></i></span>
          <span class="cstat-score">{{system.armure.protection}}</span>
          <span class="cstat-label">{{localize "AGONE.Combat.ProTotale"}}</span>
        </div>
      </div>
    </div><!-- /.cstats-card -->

  </div><!-- /.combat-top-row -->

  {{> systems/agone/templates/actors/parts/armures-card.hbs}}

  {{> systems/agone/templates/actors/parts/armes-card.hbs}}

  {{> systems/agone/templates/actors/parts/manoeuvres-card.hbs}}

</div>
