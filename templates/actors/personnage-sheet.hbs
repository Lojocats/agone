<form class="agone sheet {{actor.type}}" autocomplete="off">
  <header class="sheet-header">
    <div class="header-portrait">
      <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    </div>
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder='{{localize "AGONE.NomPersonnage"}}' />
      </h1>
      <div class="header-row secondary-stats">
        <div class="stat-box">
          <label>{{localize "AGONE.PdV"}}</label>
          <input type="number" name="system.pdv.valeur" value="{{system.pdv.valeur}}" class="stat-num" />
          <span>/</span>
          <input type="number" name="system.pdv.max" value="{{system.pdv.max}}" class="stat-num" />
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.PH"}}</label>
          <input type="number" name="system.ph.valeur" value="{{system.ph.valeur}}" class="stat-num" />
          <span>/</span>
          <span class="derived">{{system.ph.max}}</span>
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.Flamme"}}</label>
          <span class="derived big">{{system.flamme}}</span>
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.FlammeNoire"}}</label>
          <span class="derived big flamme-noire">{{system.flammeNoire}}</span>
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.MV"}}</label>
          <input type="number" name="system.mv" value="{{system.mv}}" class="stat-num" />
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.VitesseVol"}}</label>
          <input type="number" name="system.mvVol" value="{{system.mvVol}}" class="stat-num" />
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.Exp"}}</label>
          <input type="number" name="system.experience.courante" value="{{system.experience.courante}}" class="stat-num" />
          <span>/</span>
          <input type="number" name="system.experience.totale" value="{{system.experience.totale}}" class="stat-num" />
        </div>
      </div>
      {{#if modeCreation}}
      <div class="creation-mode-indicator">
        <span class="creation-badge"><i class="fas fa-pen-nib"></i> {{localize "AGONE.EnModeCreation"}}</span>
      </div>
      {{/if}}
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="attributs">{{localize "AGONE.Attributs"}}</a>
    <a class="item{{#unless tabsVisible.competences}} tab-hidden{{/unless}}" data-tab="competences">{{localize "AGONE.Competences"}}</a>
    <a class="item{{#unless tabsVisible.combat}} tab-hidden{{/unless}}" data-tab="combat">{{localize "AGONE.Combat"}}</a>
    <a class="item{{#unless tabsVisible.magie}} tab-hidden{{/unless}}" data-tab="magie">{{localize "AGONE.Magie"}}</a>
    <a class="item{{#unless tabsVisible.avantages}} tab-hidden{{/unless}}" data-tab="avantages">{{localize "AGONE.Avantages"}}</a>
    <a class="item{{#unless tabsVisible.tenebres}} tab-hidden{{/unless}}" data-tab="tenebres">{{localize "AGONE.Tenebres"}}</a>
    <a class="item{{#unless tabsVisible.perfidie}} tab-hidden{{/unless}}" data-tab="perfidie">{{localize "AGONE.Perfidie"}}</a>
    <a class="item{{#unless tabsVisible.equipement}} tab-hidden{{/unless}}" data-tab="equipement">{{localize "AGONE.Equipement"}}</a>
    <a class="item{{#unless tabsVisible.identite}} tab-hidden{{/unless}}" data-tab="identite">{{localize "AGONE.Identite"}}</a>
    <a class="item{{#unless tabsVisible.notes}} tab-hidden{{/unless}}" data-tab="notes">{{localize "AGONE.Notes"}}</a>
    <a class="item{{#unless tabsVisible.companions}} tab-hidden{{/unless}}" data-tab="companions">{{localize "AGONE.Companions"}}</a>
    <a class="item" data-tab="parametres">⚙</a>
  </nav>

  <section class="sheet-body">
    <!-- ONGLET : ATTRIBUTS -->
    <div class="tab" data-group="primary" data-tab="attributs">
      {{> systems/agone/templates/actors/parts/attributs.hbs}}
    </div>

    <!-- ONGLET : COMPÉTENCES -->
    <div class="tab" data-group="primary" data-tab="competences">
      {{> systems/agone/templates/actors/parts/competences.hbs}}
    </div>

    <!-- ONGLET : COMBAT -->
    <div class="tab" data-group="primary" data-tab="combat">
      {{> systems/agone/templates/actors/parts/combat.hbs}}
    </div>

    <!-- ONGLET : MAGIE -->
    <div class="tab" data-group="primary" data-tab="magie">
      {{> systems/agone/templates/actors/parts/magie.hbs}}
    </div>

    <!-- ONGLET : AVANTAGES -->
    <div class="tab" data-group="primary" data-tab="avantages">
      {{> systems/agone/templates/actors/parts/avantages.hbs}}
    </div>

    <!-- ONGLET : TÉNÈBRES & FLAMME -->
    <div class="tab" data-group="primary" data-tab="tenebres">
      {{> systems/agone/templates/actors/parts/tenebres.hbs}}
    </div>

    <!-- ONGLET : PERFIDIE -->
    <div class="tab" data-group="primary" data-tab="perfidie">
      {{> systems/agone/templates/actors/parts/perfidie.hbs}}
    </div>

    <!-- ONGLET : ÉQUIPEMENT -->
    <div class="tab" data-group="primary" data-tab="equipement">
      {{> systems/agone/templates/actors/parts/equipement-tab.hbs}}
    </div>

    <!-- ONGLET : NOTES -->
    <div class="tab" data-group="primary" data-tab="notes">
      <div class="editor-container">
        {{editor descriptionHTML target="system.description" button=true editable=owner}}
      </div>
    </div>

    <!-- ONGLET : IDENTITÉ -->
    <div class="tab" data-group="primary" data-tab="identite">
      {{> systems/agone/templates/actors/parts/identite.hbs}}
    </div>

    <!-- ONGLET : COMPAGNONS -->
    <div class="tab" data-group="primary" data-tab="companions">
      {{> systems/agone/templates/actors/parts/companions.hbs}}
    </div>

    <!-- ONGLET : PARAMÈTRES -->
    <div class="tab" data-group="primary" data-tab="parametres">
      {{> systems/agone/templates/actors/parts/parametres.hbs}}
    </div>
  </section>
</form>
