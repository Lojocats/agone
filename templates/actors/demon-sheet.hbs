<form class="agone sheet actor demon" autocomplete="off">
  <header class="sheet-header">
    <div class="header-portrait">
      <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    </div>
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder='{{localize "AGONE.NomDemon"}}' />
      </h1>
      <div class="header-row secondary-stats">
        <div class="stat-box">
          <label>{{localize "AGONE.Densite"}}</label>
          <input type="number" name="system.densite.valeur" value="{{system.densite.valeur}}" class="stat-num" />
          <span>/</span>
          <input type="number" name="system.densite.max" value="{{system.densite.max}}" class="stat-num" />
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.Opacite"}}</label>
          <input type="number" name="system.opacite" value="{{system.opacite}}" class="stat-num" />
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.MV"}}</label>
          <input type="number" name="system.mv" value="{{system.mv}}" class="stat-num" />
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.VitesseVol"}}</label>
          <input type="number" name="system.mvVol" value="{{system.mvVol}}" class="stat-num" />
        </div>
        <div class="stat-box">
          <label>{{localize "AGONE.TAI"}}</label>
          <input type="number" name="system.tai" value="{{system.tai}}" class="stat-num" />
        </div>
        <div class="stat-box npc-text-box">
          <label>{{localize "AGONE.Origine"}}</label>
          <select name="system.origine">
            {{#each origineOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="attributs">{{localize "AGONE.Attributs"}}</a>
    <a class="item" data-tab="combat">{{localize "AGONE.Combat.Combat"}}</a>
    <a class="item" data-tab="competences">{{localize "AGONE.Competences"}}</a>
    <a class="item" data-tab="notes">{{localize "AGONE.Notes"}}</a>
  </nav>

  <section class="sheet-body">

    <!-- ══ ATTRIBUTS ══════════════════════════════════════════════════════ -->
    <div class="tab" data-group="primary" data-tab="attributs">
      <div class="npc-sheet-layout">

        <!-- Colonne gauche : caractéristiques + stats dérivées -->
        <div class="npc-left-col">
          <div class="combat-card">
            <h3 class="combat-card-title"><i class="fas fa-fist-raised"></i> {{localize "AGONE.Caracteristiques"}}</h3>
            <div class="carac-grid npc-carac-grid">
              <div class="carac-row">
                <label>{{localize "AGONE.Attribut.Agilite"}}</label>
                <input type="number" name="system.agilite" value="{{system.agilite}}" class="stat-num" />
              </div>
              <div class="carac-row">
                <label>{{localize "AGONE.Attribut.Force"}}</label>
                <input type="number" name="system.force" value="{{system.force}}" class="stat-num" />
              </div>
              <div class="carac-row">
                <label>{{localize "AGONE.Attribut.Perception"}}</label>
                <input type="number" name="system.perception" value="{{system.perception}}" class="stat-num" />
              </div>
              <div class="carac-row">
                <label>{{localize "AGONE.Attribut.Intelligence"}}</label>
                <input type="number" name="system.intelligence" value="{{system.intelligence}}" class="stat-num" />
              </div>
              <div class="carac-row">
                <label>{{localize "AGONE.Attribut.Volonte"}}</label>
                <input type="number" name="system.volonte" value="{{system.volonte}}" class="stat-num" />
              </div>
              <div class="carac-row">
                <label>{{localize "AGONE.Attribut.Charisma"}}</label>
                <input type="number" name="system.charisma" value="{{system.charisma}}" class="stat-num" />
              </div>
              <div class="carac-row">
                <label>{{localize "AGONE.Attribut.Creativite"}}</label>
                <input type="number" name="system.creativite" value="{{system.creativite}}" class="stat-num" />
              </div>
            </div>
          </div>

          <div class="combat-card" style="margin-top:8px;">
            <h3 class="combat-card-title"><i class="fas fa-khanda"></i> {{localize "AGONE.StatsCombat"}}</h3>
            <div class="cstats-grid">
              <div class="cstat-item">
                <span class="cstat-roll cstat-passive"><i class="fas fa-bolt"></i></span>
                <span class="cstat-score">{{system.initiative}}</span>
                <span class="cstat-label">{{localize "AGONE.Initiative"}}</span>
              </div>
              <div class="cstat-item">
                <span class="cstat-roll cstat-passive"><i class="fas fa-sword"></i></span>
                <span class="cstat-score">{{system.melee}}</span>
                <span class="cstat-label">{{localize "AGONE.Melee"}}</span>
              </div>
              <div class="cstat-item">
                <span class="cstat-roll cstat-passive"><i class="fas fa-bullseye"></i></span>
                <span class="cstat-score">{{system.tir}}</span>
                <span class="cstat-label">{{localize "AGONE.Tir"}}</span>
              </div>
              <div class="cstat-item">
                <span class="cstat-roll cstat-passive"><i class="fas fa-shield-alt"></i></span>
                <span class="cstat-score">{{system.defenseNaturelle}}</span>
                <span class="cstat-label">DEF</span>
              </div>
            </div>
            <div class="carac-grid npc-carac-grid" style="margin-top:6px;">
              <div class="carac-row">
                <label>{{localize "AGONE.BD"}}</label>
                <input type="number" name="system.bd" value="{{system.bd}}" class="stat-num" />
              </div>
              <div class="carac-row">
                <label>{{localize "AGONE.DIF"}}</label>
                <input type="number" name="system.dif" value="{{system.dif}}" class="stat-num" />
              </div>
              <div class="carac-row">
                <label>{{localize "AGONE.ChargeMax"}}</label>
                <input type="number" name="system.chargeMax" value="{{system.chargeMax}}" class="stat-num" />
              </div>
            </div>
            <div class="cstats-grid" style="margin-top:6px;">
              <div class="cstat-item">
                <span class="cstat-score">{{system.demiCharge}}</span>
                <span class="cstat-label">DC</span>
              </div>
              <div class="cstat-item">
                <span class="cstat-score">{{system.chargeJour}}</span>
                <span class="cstat-label">CQ</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Colonne droite : Densité/santé + identité -->
        <div class="npc-right-col">
          <div class="combat-card sante-card">
            <h3 class="combat-card-title"><i class="fas fa-heartbeat"></i> {{localize "AGONE.EtatSante"}}</h3>
            <div class="pdv-bar-wrap">
              <div class="pdv-values">
                <span class="pdv-current">{{system.densite.valeur}}</span>
                <span class="pdv-sep">/</span>
                <span class="pdv-max">{{system.densite.max}}</span>
                <span class="pdv-label">{{localize "AGONE.Densite"}}</span>
              </div>
              {{#if system.densite.max}}
              <div class="pdv-track">
                <div class="pdv-fill" style="width:{{pdvPercent}}%;"></div>
              </div>
              {{/if}}
            </div>
            <div class="blessures-section">
              <div class="bg-row">
                <span class="bg-title">{{localize "AGONE.BlessuresGraves"}}</span>
                <label class="bg-cell {{#if system.blessureGrave1}}bg-active{{/if}}">
                  <input type="checkbox" name="system.blessureGrave1" {{#if system.blessureGrave1}}checked{{/if}} />
                  <span class="bg-dot">1</span><span class="bg-pen">-2</span>
                </label>
                <label class="bg-cell {{#if system.blessureGrave2}}bg-active{{/if}}">
                  <input type="checkbox" name="system.blessureGrave2" {{#if system.blessureGrave2}}checked{{/if}} />
                  <span class="bg-dot">2</span><span class="bg-pen">-6</span>
                </label>
                <label class="bg-cell {{#if system.blessureGrave3}}bg-active{{/if}}">
                  <input type="checkbox" name="system.blessureGrave3" {{#if system.blessureGrave3}}checked{{/if}} />
                  <span class="bg-dot">3</span><span class="bg-pen">-12</span>
                </label>
                {{#if system.malusBlessureGrave}}<span class="bg-total">{{system.malusBlessureGrave}}</span>{{/if}}
              </div>
            </div>
            <div class="cstats-grid" style="margin-top:8px;">
              <div class="cstat-item">
                <span class="cstat-score">{{system.seuilBlessureGrave}}</span>
                <span class="cstat-label">SBG</span>
              </div>
              <div class="cstat-item">
                <span class="cstat-score">{{system.seuilBlessureCritique}}</span>
                <span class="cstat-label">SBC</span>
              </div>
            </div>
          </div>

          <!-- Identité -->
          <div class="combat-card" style="margin-top:8px;">
            <h3 class="combat-card-title"><i class="fas fa-id-card"></i> {{localize "AGONE.Identite"}}</h3>
            <div class="carac-grid npc-carac-grid">
              <div class="carac-row">
                <label>{{localize "AGONE.Sexe"}}</label>
                <input type="text" name="system.sexe" value="{{system.sexe}}" />
              </div>
              <div class="carac-row">
                <label>{{localize "AGONE.Taille"}}</label>
                <input type="text" name="system.taille" value="{{system.taille}}" />
              </div>
              <div class="carac-row">
                <label>{{localize "AGONE.Masse"}}</label>
                <input type="text" name="system.masse" value="{{system.masse}}" />
              </div>
              <div class="carac-row">
                <label>{{localize "AGONE.Age"}}</label>
                <input type="text" name="system.age" value="{{system.age}}" />
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- ══ COMBAT ══════════════════════════════════════════════════════════ -->
    <div class="tab" data-group="primary" data-tab="combat">
      <div class="combat-section">

        <!-- LIGNE HAUTE : Santé + Stats Combat -->
        <div class="combat-top-row">

          <!-- SANTÉ / DENSITÉ -->
          <div class="combat-card sante-card">
            <h3 class="combat-card-title"><i class="fas fa-heartbeat"></i> {{localize "AGONE.EtatSante"}}</h3>
            <div class="pdv-bar-wrap">
              <div class="pdv-values">
                <span class="pdv-current">{{system.densite.valeur}}</span>
                <span class="pdv-sep">/</span>
                <span class="pdv-max">{{system.densite.max}}</span>
                <span class="pdv-label">{{localize "AGONE.Densite"}}</span>
              </div>
              {{#if system.densite.max}}
              <div class="pdv-track">
                <div class="pdv-fill" style="width:{{pdvPercent}}%;"></div>
              </div>
              {{/if}}
            </div>
            <div class="blessures-section">
              <div class="bg-row">
                <span class="bg-title">{{localize "AGONE.BlessuresGraves"}}</span>
                <label class="bg-cell {{#if system.blessureGrave1}}bg-active{{/if}}">
                  <input type="checkbox" name="system.blessureGrave1" {{#if system.blessureGrave1}}checked{{/if}} />
                  <span class="bg-dot">1</span><span class="bg-pen">-2</span>
                </label>
                <label class="bg-cell {{#if system.blessureGrave2}}bg-active{{/if}}">
                  <input type="checkbox" name="system.blessureGrave2" {{#if system.blessureGrave2}}checked{{/if}} />
                  <span class="bg-dot">2</span><span class="bg-pen">-6</span>
                </label>
                <label class="bg-cell {{#if system.blessureGrave3}}bg-active{{/if}}">
                  <input type="checkbox" name="system.blessureGrave3" {{#if system.blessureGrave3}}checked{{/if}} />
                  <span class="bg-dot">3</span><span class="bg-pen">-12</span>
                </label>
                {{#if system.malusBlessureGrave}}<span class="bg-total">{{system.malusBlessureGrave}}</span>{{/if}}
              </div>
            </div>
            <div class="cstats-grid" style="margin-top:8px;">
              <div class="cstat-item">
                <span class="cstat-score">{{system.seuilBlessureGrave}}</span>
                <span class="cstat-label">SBG</span>
              </div>
              <div class="cstat-item">
                <span class="cstat-score">{{system.seuilBlessureCritique}}</span>
                <span class="cstat-label">SBC</span>
              </div>
            </div>
          </div><!-- /.sante-card -->

          <!-- STATS DE COMBAT -->
          <div class="combat-card cstats-card">
            <h3 class="combat-card-title"><i class="fas fa-khanda"></i> {{localize "AGONE.StatsCombat"}}</h3>
            <div class="cstats-grid">
              <div class="cstat-item">
                <button type="button" class="cstat-roll" data-action="rollInitiative" title='{{localize "AGONE.JeterInitiative"}}'><i class="fas fa-bolt"></i></button>
                <span class="cstat-score">{{system.initiative}}</span>
                <span class="cstat-label">{{localize "AGONE.Initiative"}}</span>
              </div>
              <div class="cstat-item">
                <span class="cstat-roll cstat-passive"><i class="fas fa-sword"></i></span>
                <span class="cstat-score">{{system.melee}}</span>
                <span class="cstat-label">{{localize "AGONE.Melee"}}</span>
              </div>
              <div class="cstat-item">
                <span class="cstat-roll cstat-passive"><i class="fas fa-bullseye"></i></span>
                <span class="cstat-score">{{system.tir}}</span>
                <span class="cstat-label">{{localize "AGONE.Tir"}}</span>
              </div>
              <div class="cstat-item">
                <span class="cstat-roll cstat-passive"><i class="fas fa-hammer"></i></span>
                <span class="cstat-score">{{system.bd}}</span>
                <span class="cstat-label">{{localize "AGONE.BD"}}</span>
              </div>
            </div>
          </div><!-- /.cstats-card -->

        </div><!-- /.combat-top-row -->

        <!-- ARMES -->
        <div class="combat-card armes-card">
          <div class="combat-card-header">
            <h3 class="combat-card-title"><i class="fas fa-khanda"></i> {{localize "AGONE.Armes"}}</h3>
            <div class="card-btns">
              <button type="button" class="compendium-browse btn-icon" data-pack="agone.armes" title='{{localize "AGONE.ParcourirArmes"}}'><i class="fas fa-search"></i></button>
              <button type="button" class="item-create btn-icon" data-type="arme" title='{{localize "AGONE.AjouterArme"}}'><i class="fas fa-plus"></i></button>
            </div>
          </div>
          {{#if armes.length}}
          <table class="armes-table">
            <thead>
              <tr>
                <th class="col-equipe" title="{{localize 'AGONE.Equipe'}}"><i class="fas fa-hand-paper"></i></th>
                <th class="col-arme-name">{{localize "AGONE.Nom"}}</th>
                <th class="col-tai">{{localize "AGONE.TAI"}}</th>
                <th class="col-type">{{localize "AGONE.Type"}}</th>
                <th class="col-init"><i class="fas fa-bolt"></i> {{localize "AGONE.Combat.Init"}}</th>
                <th class="col-atk"><i class="fas fa-dice-d10"></i> {{localize "AGONE.Combat.Atk"}}</th>
                <th class="col-def"><i class="fas fa-shield-alt"></i> {{localize "AGONE.Combat.Def"}}</th>
                <th class="col-dom">{{localize "AGONE.Combat.Dom"}}</th>
                <th class="col-row-actions"></th>
              </tr>
            </thead>
            <tbody>
              {{#each armes as |arme|}}
              <tr class="item-row {{#if arme.system.equipe}}arme-equipee{{/if}}" data-item-id="{{arme.id}}">
                <td class="col-equipe">
                  <label class="arme-equipe-toggle">
                    <input type="checkbox" class="arme-equipe" data-item-id="{{arme.id}}" {{#if arme.system.equipe}}checked{{/if}} />
                    <i class="fas fa-hand-paper arme-equipe-icon"></i>
                  </label>
                </td>
                <td class="col-arme-name">
                  <span class="roll-btn item-name" data-action="rollItemChat" data-item-id="{{arme.id}}">{{arme.name}}</span>
                </td>
                <td class="col-tai">{{arme.system.tai}}</td>
                <td class="col-type">{{arme.system.type}}</td>
                <td class="col-init">
                  <div class="arme-cell">
                    <span class="arme-score">{{arme.system.initTotal}}</span>
                    <button type="button" class="roll-btn-small roll-init-btn" data-action="rollInitiative" data-item-id="{{arme.id}}" title='{{localize "AGONE.JeterInitiative"}}'><i class="fas fa-bolt"></i></button>
                  </div>
                </td>
                <td class="col-atk">
                  <div class="arme-cell">
                    <span class="arme-score">{{arme.system.attackTotal}}</span>
                    <button type="button" class="roll-btn-small roll-atk-btn" data-action="rollAttaque" data-item-id="{{arme.id}}" title='{{localize "AGONE.JeterAttaque"}}'><i class="fas fa-dice-d10"></i></button>
                  </div>
                </td>
                <td class="col-def">
                  <div class="arme-cell">
                    <span class="arme-score">{{arme.system.defenseTotal}}</span>
                    <button type="button" class="roll-btn-small roll-def-btn" data-action="rollParade" data-item-id="{{arme.id}}" title='{{localize "AGONE.JeterParade"}}'><i class="fas fa-shield-alt"></i></button>
                  </div>
                </td>
                <td class="col-dom">
                  <span class="dom-base">{{arme.system.dommages}}</span>
                  {{#if ../system.bd}}<span class="dom-bd">+{{../system.bd}}</span>{{/if}}
                </td>
                <td class="col-row-actions">
                  <a class="item-edit" data-item-id="{{arme.id}}" title='{{localize "AGONE.Editer"}}'><i class="fas fa-pen"></i></a>
                  <a class="item-delete" data-item-id="{{arme.id}}" title='{{localize "AGONE.Supprimer"}}'><i class="fas fa-trash"></i></a>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
          {{else}}
          <p class="empty-list">{{localize "AGONE.AucuneArme"}}</p>
          {{/if}}
        </div><!-- /.armes-card -->

      </div><!-- /.combat-section -->
    </div>
    <!-- COMPÉTENCES -->
    <div class="tab" data-group="primary" data-tab="competences">
      {{> systems/agone/templates/actors/parts/competences.hbs}}
    </div>
    <!-- ══ NOTES ════════════════════════════════════════════════════════════ -->
    <div class="tab" data-group="primary" data-tab="notes">
      <div class="editor-container">
        <h3>{{localize "AGONE.Connivances"}}</h3>
        {{editor connivancesHTML target="system.connivances" button=true editable=owner}}
      </div>
      <div class="editor-container" style="margin-top:12px;">
        <h3>{{localize "AGONE.Notes"}}</h3>
        {{editor notesHTML target="system.notes" button=true editable=owner}}
      </div>
    </div>

  </section>
</form>
